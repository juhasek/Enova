            DzienPracyAktualizacja DzienPracy(bool add) {  //DzienPracy przejrzany i akceptowany
            		var dzienPracy = Get(getKalk(pak)[Data]);

            		if (dzienPracy is DzienPracyAktualizacja dp && dp.Pozycja == pak)
            				return dp;
            		else if(add)
           		 {
           				 if (!pak.Dokument.Okres.Contains(Data))
            						throw new Exception("Nie można modyfikować dni poza okresem dokumentu: {0}".TranslateFormat(pak.Dokument.Okres));
            				var dzień = pak.Session.AddRow(new DzienPracyAktualizacja(pak, Data));

            				if(dzienPracy is DzienPracyAktualizacja da)
           						 dzień.Copy(da);
            				else if (dzienPracy is Dzien d && d.Praca != FromTimes.Empty)
            						dzień.Copy(d);
            				else
            						pak.ZrodloPlanu.PrzeliczDzieńPracyAktualizacja(dzień);

            				return dzień;
           		 }
						
            		return null;
            }

