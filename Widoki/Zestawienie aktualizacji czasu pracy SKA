	[Priority(360)]
	[Command]
	[Group("Dodatkowe")]
	[Caption("Przypisz    ")]
	public object WstawCecheBryg([Context]Context context) {
	    if(dokument.Stan != StanyDokumentuAktulizacjiKalendarza.Wypełniany) return null;
	    using (ITransaction t = context.Session.Logout(true)) 
			{
				List<string> kodyPracownikow = new List<string>();
				Dictionary<string, List<int>> dctstref = new Dictionary<string, List<int>>();
				kodyPracownikow.Clear();
				
				foreach (Soneta.Business.UI.PivotData.PivotRecord selectedRow in SelectedRows)
	     {	
					PozycjaAktualizacjiCzasu pak = null;
	        foreach(%NAZWA%Cell cell in selectedRow.GetCells())
				  {
						
	          pak = cell.GetPAK();
	          break;
	   		 }
	        if(pak == null) continue;
				 	
				  Pracownik prac = pak.ZrodloPlanu.GetPracownik();
				  //if(prac != null)
					//	 lg.WriteLine($"Zaznaczony Pracownik : {prac} numer");
					
					
				  string numerstrefy = (string)selectedRow.GetSelector(0);
					int strefaint = int.Parse(numerstrefy);
					string kodPracownika = (string)selectedRow.GetSelector(2); 
				  //lg.WriteLine($"Dane z selectedRow - numer strefy : {strefaint} kod Praownika {kodPracownika}");
				 
				   
					if(!kodyPracownikow.Contains(kodPracownika))
					{
						kodyPracownikow.Add(kodPracownika);
					}
					
					if(!dctstref.ContainsKey(kodPracownika))
					{
						List<int> numeryStref = new List<int>();
						numeryStref.Clear();
						numeryStref.Add(strefaint);
						dctstref.Add(kodPracownika,numeryStref);
						
					}
					else
					{
						List<int> rob = new List<int>();
						 rob = dctstref[kodPracownika];
						rob.Add(strefaint);
						dctstref[kodPracownika] = rob;
						
					}
				 
				  KalkulatorAktualizacjiPracy kalk = new KalkulatorAktualizacjiPracy(pak);
	        kalk.LoadOkres(okresCechyBryg);
				 
				  foreach (Date d in OkresCechyBryg) 
				  {
						int strefa =0;  //-1
						if (Blokada(context, d))
	            					throw new Exception("Została ustawiona blokada która nie pozwala na edycję dnia");
						//TypDnia td = kalk.Plan[d].Definicja.Typ;
	          //  			if (pomin && (td == TypDnia.Świąteczny || td == TypDnia.Wolny))
	          //  					continue;
						if (!pak.Dokument.Okres.Contains(d))
	            					throw new Exception("Nie można modyfikować dni poza okresem dokumentu: {0}".TranslateFormat(pak.Dokument.Okres));
						
						 var dzienPracy = Get(kalk[d]);
							
						 var dp = dzienPracy as DzienPracyAktualizacja;
	         //  if (dp != null && dp.Pozycja == pak && !nadpisz)
	         // 			continue;	
						
						bool added = false;
	          Session session = pak.Session;
						if(dp == null || dp.Pozycja != pak)
						{
	          					  dp = session.AddRow(new DzienPracyAktualizacja(pak, d));
	
	           			 		if(dzienPracy is DzienPracyAktualizacja da)
	            							dp.Copy(da);
	           					 else if (dzienPracy is Dzien dd && dd.Praca != FromTimes.Empty)
	           							 dp.Copy(dd);
	          			  		else
	           							 pak.ZrodloPlanu.PrzeliczDzieńPracyAktualizacja(dp);
	
	         			  		 added = true;
	           }
				 		//lg.WriteLine($"Rozpoczecie uzupelniania cechy dp.Strefy.Count {dp.Strefy.Count} strefaint {strefaint}, tymczasem strefa {strefa}");
						 if (dp.Strefy.Count == strefaint) 
						 { 			//lg.WriteLine($"---Def Rozpoczęcie dodawania gdy 1");
							 			foreach (StrefaPracyAktualizacja sp in dp.Strefy)
									 	{
										
							 
												if (!sp.IsReadOnly())
												{
													//lg.WriteLine($"Def Zamiana bez readOnly dodawania właściwe gdy1");		
	                				sp.Features["DodatekBryg"] = wartoscBryg;
												}
	            					break;
										 }
						
						 }
						//	lg.WriteLine($"Pytanie strefa jaki ma numer : {strefa} a strefaint {strefaint}");
	        	 foreach (StrefaPracyAktualizacja sp in dp.Strefy)
						 {
						 if (++strefa == strefaint) 
							{
									//lg.WriteLine($"Ustawianie cechy dodawania właściwe dla strefy numer {strefa}");	
	            		if (!sp.IsReadOnly())
									{
											//lg.WriteLine($"Def Zamiana bez readOnly dodawania właściwe");		
	                		sp.Features["DodatekBryg"] = wartoscBryg;
									}
	            		break;
							}
							//lg.WriteLine($"{d}Uzupelnianie cechy koniec numer strefy {strefa} a strefyInt {strefaint}");
						 }
					//	lg.WriteLine($"{d}Uzupelnianie cechy koniec -------------  numer strefy {strefa} a strefyInt {strefaint}");
					}
				 
				 
				 
				}
	      t.CommitUI();
	    }
		//return Soneta.Business.UI.FormAction.Save | Soneta.Business.UI.FormAction.Refresh ;
		OnChanged(EventArgs.Empty);
		//return Soneta.Business.UI.FormAction.RefreshOwner;
		return null;
	}					
				
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
