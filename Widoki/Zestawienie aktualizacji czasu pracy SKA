				if(ds is Time from && from >= new Time(24,0))	
					return "+" + (from - new Time(24,0)).ToString();
				return ds.ToString();
			}
			return string.Empty;
    } 
    set {
        if (Blokada())
            throw new Exception("Została ustawiona blokada która nie pozwala na edycję dnia");
				int strefa = -1;
