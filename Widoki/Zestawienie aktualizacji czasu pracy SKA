            int liczbaDni = KadryModule.GetInstance(pak).Config.KadryNET.CzasPracy.EdycjaCzasuPracy.LiczbaDni;
            if (liczbaDni > 0)
            switch (KadryModule.GetInstance(pak).Config.KadryNET.CzasPracy.EdycjaCzasuPracy.Interpretacja) {
            case Soneta.Kadry.Config.Interpretacja.OdPoczątku:
            return (Data.FirstDayMonth() + liczbaDni) <= Data;
            case Soneta.Kadry.Config.Interpretacja.PrzedKońcem:
            return (Data.LastDayMonth() - liczbaDni) <= Data;
            case Soneta.Kadry.Config.Interpretacja.OdPoczątkuNastępnego:
            return (Data.AddMonths(1).FirstDayMonth() + liczbaDni) <= Data;
            }
            return false;
            }
						
