            private DataAppearance GetAppearanceNorma(Time praca, Time plan) {
            if (plan == Time.Zero)
            return new DataAppearance { ForeColor = System.Drawing.Color.Black };
            if (praca < plan)
            return new DataAppearance { ForeColor = System.Drawing.Color.FromArgb(178, 34, 34) };
            return new DataAppearance { ForeColor = System.Drawing.Color.FromArgb(27, 94, 32) };
            }

            private DataAppearance GetAppearance() {
            return new DataAppearance { BackColor = GetBackColor(), ForeColor = GetForeColor() };
            }

            private System.Drawing.Color GetBackColor() {
            if (!pak.Dokument.Okres.Contains(Data) ||
            !pak.ZrodloPlanu.GetPlanOkresZatrudnienia(FromTo.Day(Data)).Contains(Data))
            return Soneta.Kalend.KoloryKalendarza.DzieńPozaOkresemEdycji;

            var dzienPlanu = Get(getKalk(pak)[Data]);
            if(dzienPlanu is Dzien dz){
            var strefyNb = dz?.Where(_ => _.Definicja.OznaczaNieobecnosc).ToArray();
            if((strefyNb?.Length ?? 0) > 0){
            int c = strefyNb.First().Definicja.BackColor;
            if (c != 0)
            return System.Drawing.Color.FromArgb(c);
            else
            // Poprawka wizualna: pierwotny jaskrawy Color.Orange zastąpiony pastelowym
            // odcieniem bursztynu - ten sam sygnał "nieobecność bez własnego koloru",
            // mniej męczący dla oka przy dłuższej pracy z siatką.
            return System.Drawing.Color.FromArgb(255, 214, 153);
            }
            if (dz != null && dz.Definicja != null) {
            int c = dz.Definicja.BackColor;
            if (c != 0)
            return System.Drawing.Color.FromArgb(c);

            switch (dz.Definicja.Typ) {
            case TypDnia.Wolny:
            return Soneta.Kalend.KoloryKalendarza.DzieńWolnyTło;
            case TypDnia.Świąteczny:
            return Soneta.Kalend.KoloryKalendarza.DzieńŚwiątecznyTło;
            }
            }
            }

            if (dzienPlanu is DzienPracyAktualizacja dp){
            var strefyNb = dp.Strefy.Where(_ => _.Definicja.OznaczaNieobecnosc).ToArray();
            if(strefyNb.Length > 0){
            int c = strefyNb.First().Definicja.BackColor;
            if (c != 0)
            return System.Drawing.Color.FromArgb(c);
            else
            return System.Drawing.Color.FromArgb(255, 214, 153);
            }
            if(dp.Pozycja == pak)
            return KoloryKalendarza.DzieńPracyZmiana;
            else
            return KoloryKalendarza.DzieńPracyZmianaInnyKalendarz;
            }
            return System.Drawing.Color.White;
            }

            private System.Drawing.Color GetForeColor() {
            Dzien dz = getKalk(pak)[Data];
            var strefyNb = dz?.Where(_ => _.Definicja.OznaczaNieobecnosc).ToArray();
            if((strefyNb?.Length ?? 0) > 0){
            int c = strefyNb.First().Definicja.ForeColor;
            if (c != 0)
            return System.Drawing.Color.FromArgb(c);
            }
            if (dz != null && dz.Definicja != null) {
            int c = dz.Definicja.ForeColor;
            if (c != 0)
            return System.Drawing.Color.FromArgb(c);
            switch (dz.Definicja.Typ) {
            case TypDnia.Wolny:
            return System.Drawing.Color.Black;
            case TypDnia.Świąteczny:
            return System.Drawing.Color.Red;
            default:
            return System.Drawing.Color.Navy;
            }
            }
            // Poprawka wizualna: pierwotny fallback Color.DeepPink (jaskrawy róż, wyglądający
            // jak niedopracowany kolor "błędu") zastąpiony neutralną czernią - to jedyny
            // przypadek, w którym dzień nie ma żadnej definicji (dz==null lub dz.Definicja==null),
            // więc kolor tekstu powinien być po prostu domyślny, a nie rzucać się w oczy.
            return System.Drawing.Color.Black;
            }//** End: Cell **

