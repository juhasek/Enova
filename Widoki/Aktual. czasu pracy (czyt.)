            [Priority(160)]
            [Command]
            [Group("Wstaw serię")]
            [Caption("Wstaw serię")]
            public void WstawSerię([Context]Context context) {
            if(dokument.Stan != StanyDokumentuAktulizacjiKalendarza.Wypełniany) return;

            using (ITransaction t = context.Session.Logout(true)) {
            foreach (Soneta.Business.UI.PivotData.PivotRecord selectedRow in SelectedRows)
            {
            PozycjaAktualizacjiCzasu pak = null;
            foreach(%NAZWA%Cell cell in selectedRow.GetCells()){
            pak = cell.GetPAK();
            break;
            }
            if(pak == null) continue;

            KalkulatorAktualizacjiPracy kalk = new KalkulatorAktualizacjiPracy(pak);
            kalk.LoadOkres(okres);

            foreach (Date d in Okres) {
            if (Blokada(context, d))
            throw new Exception("Została ustawiona blokada która nie pozwala na edycję dnia");
            TypDnia td = kalk.Plan[d].Definicja.Typ;
            if (pomin && (td == TypDnia.Świąteczny || td == TypDnia.Wolny))
            continue;

            if (!pak.Dokument.Okres.Contains(d))
            throw new Exception("Nie można modyfikować dni poza okresem dokumentu: {0}".TranslateFormat(pak.Dokument.Okres));

            var dzienPracy = Get(kalk[d]);

            var dp = dzienPracy as DzienPracyAktualizacja;
            if (dp != null && dp.Pozycja == pak && !nadpisz)
            continue;

            bool added = false;
            Session session = pak.Session;

            if(dp == null || dp.Pozycja != pak){
            dp = session.AddRow(new DzienPracyAktualizacja(pak, d));

            if(dzienPracy is DzienPracyAktualizacja da)
            dp.Copy(da);
            else if (dzienPracy is Dzien dd && dd.Praca != FromTimes.Empty)
            dp.Copy(dd);
            else
            pak.ZrodloPlanu.PrzeliczDzieńPracyAktualizacja(dp);

            added = true;
            }
            var km = session.GetKalend();
            if(added || nadpisz){
            if (!dp.Praca.IsReadOnlyOdGodziny() && odGodziny != Time.Empty)
            dp.Praca.OdGodziny = odGodziny;
            if (!dp.Praca.IsReadOnlyCzas() && czas != Time.Empty)
            dp.Praca.Czas = czas;
            }
            }
            }
            t.Commit();
            }
            }

