            public View ListaPracownicy(bool wybrany) {
            Context.Get(out dokument);
            pracownicyLista.Clear();

            foreach(var zrodlo in dokument.PozycjeCzas.Select(_ => _.ZrodloPlanu).ToArray()){
            Wydzial w = zrodlo.GetWydzial();
            string key = zrodlo.GetPracownik().Guid.ToString();
            if(!pracownicyLista.ContainsKey(key))
            pracownicyLista.Add(key, new List<string>());
            string val = w != null ? w.Guid.ToString() : "";
            if(!pracownicyLista[key].Contains(val))
            pracownicyLista[key].Add(val);
            }

            View v = KadryModule.GetInstance(this).Pracownicy.CreateView();
            v.Condition &= new FieldCondition.In("Guid", pracownicyLista.Keys.ToArray());
            if (wybrany && Pracownicy!=null)
            v.Condition &= new FieldCondition.Equal("Guid", Pracownicy.Guid);
            if (wdz!=null){
            List<string> wydzialy = new List<string> { wdz.Guid.ToString() };
            wydzialy.AddRange(wdz.WszystkiePodwydziały.Cast<Wydzial>().Where(w => !w.Blokada).Select(w => w.Guid.ToString()));
            v.Condition &= new FieldCondition.In("Guid", pracownicyLista.Where(p => wydzialy.Any(wwww => p.Value.Contains(wwww))).Select(p => p.Key).Distinct().ToArray());
            }
            return v;
            }

