            DzienKalendarzaAktualizacja DzienPlanu(bool add) {
            var dzienPlanu = Get(getKalk(pak)[Data]);

            if (dzienPlanu is DzienKalendarzaAktualizacja dp && dp.Pozycja == pak)
            	return dp;
            else if(add)
            {
            	if (!pak.Dokument.Okres.Contains(Data))
              	throw new Exception("Nie można modyfikować dni poza okresem dokumentu: {0}".TranslateFormat(pak.Dokument.Okres));

	            IDefinicjaDnia dk = dzienPlanu as IDefinicjaDnia;
	            DefinicjaDnia definicja = dk?.Definicja ?? (dzienPlanu as Dzien).Definicja;

	            DzienKalendarzaAktualizacja dzień = null;
	            if (pak.ZrodloPlanu is Pracownik)
	            	dzień = pak.Session.AddRow(new DzienPlanuAktualizacja(pak, Data));
	            else if (pak.ZrodloPlanu is IUmowaZKalendarzem)
	            	dzień = pak.Session.AddRow(new DzienPlanuUmowyAktualizacja(pak, Data));

	            if (dk != null)
	            dzień.Kopiuj(dk, true);
	            else if (definicja != null)
	            dzień.Definicja = definicja;

							if(dzień.Definicja.Typ == TypDnia.Świąteczny)
              	throw new Exception("Nie można modyfikować Niedzieli/Święta");

	            return dzień;
            }

            return null;
            }

            bool Blokada() {
	            int liczbaDni = KadryModule.GetInstance(pak).Config.KadryNET.CzasPracy.EdycjaCzasuPracy.LiczbaDni;
	            if (liczbaDni > 0)
	            switch (KadryModule.GetInstance(pak).Config.KadryNET.CzasPracy.EdycjaCzasuPracy.Interpretacja) {
		            case Soneta.Kadry.Config.Interpretacja.OdPoczątku:
		            	return (Data.FirstDayMonth() + liczbaDni) <= Data;
		            case Soneta.Kadry.Config.Interpretacja.PrzedKońcem:
		            	return (Data.LastDayMonth() - liczbaDni) <= Data;
		            case Soneta.Kadry.Config.Interpretacja.OdPoczątkuNastępnego:
		            	return (Data.AddMonths(1).FirstDayMonth() + liczbaDni) <= Data;
	            }
            return false;
            }

