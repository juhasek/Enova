            [Priority(160)]
            [Command]
            [Group("Wstaw serię")]
            [Caption("Wstaw serię")]
            public void WstawSerię([Context]Context context) {
            if(dokument.Stan != StanyDokumentuAktulizacjiKalendarza.Wypełniany) return;

            using (ITransaction t = context.Session.Logout(true)) {
            foreach (Soneta.Business.UI.PivotData.PivotRecord selectedRow in SelectedRows)
            {
            PozycjaAktualizacjiKalendarza pak = null;
            foreach(%NAZWA%Cell cell in selectedRow.GetCells()){
            pak = cell.GetPAK();
            break;
            }
            if(pak == null) continue;

            KalkulatorAktualizacjiPlanu kalk = new KalkulatorAktualizacjiPlanu(pak);
            kalk.LoadOkres(okres);

            foreach (Date d in Okres) {
            if (Blokada(context, d))
            throw new Exception("Została ustawiona blokada która nie pozwala na edycję dnia");
            TypDnia td = kalk[d].Definicja.Typ;
            if (pomin && (td == TypDnia.Świąteczny || td == TypDnia.Wolny))
            continue;

            var dzienPlanu = Get(kalk[d]);

            if (!pak.Dokument.Okres.Contains(d))
            throw new Exception("Nie można modyfikować dni poza okresem dokumentu: {0}".TranslateFormat(pak.Dokument.Okres));

            var dp = dzienPlanu as DzienKalendarzaAktualizacja;
            if (dp != null && dp.Pozycja == pak && !nadpisz)
            continue;

            bool added = false;
            Session session = pak.Session;

            if(dp == null || dp.Pozycja != pak){
            IDefinicjaDnia dk = dzienPlanu as IDefinicjaDnia;
            DefinicjaDnia definicja = dk?.Definicja ?? (dzienPlanu as Dzien).Definicja;
            if (pak.ZrodloPlanu is Pracownik)
            dp = session.AddRow(new DzienPlanuAktualizacja(pak, d));
            else if (pak.ZrodloPlanu is IUmowaZKalendarzem)
            dp = session.AddRow(new DzienPlanuUmowyAktualizacja(pak, d));

            if (dk != null)
            dp.Kopiuj(dk, true);
            else if (definicja != null)
            dp.Definicja = definicja;

            added = true;
            }
            var km = session.GetKalend();
            if(added || nadpisz){
            if (defDnia != null)
            dp.Definicja = km.DefinicjeDni[defDnia.Guid];
            if (!dp.Praca.IsReadOnlyOdGodziny() && odGodziny != Time.Empty)
            dp.Praca.OdGodziny = odGodziny;
            if (!dp.Praca.IsReadOnlyCzas() && czas != Time.Empty)
            dp.Praca.Czas = czas;
            }
            }
            }
            t.Commit();
            }
            // Poprawka 17.09.2026 - "Wstaw serię" zmienia godziny wielu dni na raz tym samym
            // mechanizmem sesji co pojedyncza edycja komórki (patrz Cell poniżej), więc bez tego
            // sygnału siatka też nie odświeży kolumn Norma/KP po użyciu tej akcji.
            OdswiezZestawienie();
            }//** End: Extender **
