            private System.Drawing.Color GetBackColor() {
	            if (!pak.Dokument.Okres.Contains(Data) ||
	            !pak.ZrodloPlanu.GetPlanOkresZatrudnienia(FromTo.Day(Data)).Contains(Data))
	            return Soneta.Kalend.KoloryKalendarza.DzieńPozaOkresemEdycji;

	            var dzienPlanu = Get(getKalk(pak)[Data]);
		          if(dzienPlanu is Dzien dz){
		            if (dz != null && dz.Definicja != null) {
		            int c = dz.Definicja.BackColor;
		            if (c != 0)
		            return System.Drawing.Color.FromArgb(c);

			            switch (dz.Definicja.Typ) {
			            	case TypDnia.Wolny:
			            		return Soneta.Kalend.KoloryKalendarza.DzieńWolnyTło;
			            	case TypDnia.Świąteczny:
			            		return Soneta.Kalend.KoloryKalendarza.DzieńŚwiątecznyTło;
			            }
		            }
	            }

	            if (dzienPlanu is DzienKalendarzaAktualizacja dp)
	            	if(dp.Pozycja == pak)
	            		return KoloryKalendarza.DzieńPlanuZmiana;
	            	else
	            		return KoloryKalendarza.DzieńPlanuZmianaInnyKalendarz;

							if(dzienPlanu is DefinicjaDnia dk)
							{
			            if(dk.Typ == TypDnia.Świąteczny )
			            	return System.Drawing.Color.Red;
							}


	            return System.Drawing.Color.White;
            }

