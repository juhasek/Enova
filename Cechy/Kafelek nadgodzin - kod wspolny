using System;
using System.Collections.Generic;
using Soneta.Types;
using Soneta.Business;
using Soneta.Kadry;
using Soneta.Kalend;
using Soneta.Place;

// Wspólny kod cech kafelków nadgodzin (kategoria cech "Kafelek" na Pracownicy).
// Magazyn nadgodzin enova: ZasobRN = nierozliczona reszta strefy, ObrotRN = rozliczona para
// (strefa nadgodzin -> strefa odbioru / wypłaty). Godziny liczone w jednostkach nadgodzin (Partia.Rozliczany).

namespace Soneta.Runtime.Database.Business.TblCodeFiles {

    public static class KafelkiNadgodzin {

        // ---------------- kafelki ----------------

        // Wyjścia prywatne nieodpracowane w bieżącym okresie rozliczeniowym.
        public static Time WyjsciaPrywatne(Pracownik pracownik) {
            FromTo okres = pracownik.WyliczOkresRoliczeniowyNadgodzin(Date.Today);
            KalkulatorPracy kalkPracy = pracownik.Czasy.KalkPracy;
            return CzasStrefy(pracownik, kalkPracy, okres, "Wyjście prywatne")
                - CzasStrefy(pracownik, kalkPracy, okres, "Rozliczenie wyjścia prywatnego");
        }

        // Wszystkie nadgodziny w bieżącym roku - ze stref, niezależnie od wymiaru etatu
        // (godziny ponadwymiarowe niepełnoetatowców mają własną strefę i nie są tu liczone).
        public static Time NadgodzinyWRoku(Pracownik pracownik) {
            FromTo rok = new FromTo(Date.Today.FirstDayYear(), Date.Today.LastDayYear());
            return PracaPozaNormaBezOdpracowan(pracownik, rok);
        }

        public static int DniDoOdbioru(Pracownik pracownik) {
            return PoliczDoOdbioru(pracownik).Dni;
        }

        public static Time GodzinyDoOdbioru(Pracownik pracownik) {
            return PoliczDoOdbioru(pracownik).Godziny;
        }

        // Nadgodziny do wypłaty bieżącego miesiąca, jeszcze nieuwzględnione na liście płac.
        public static Time DoWyplaty(Pracownik pracownik) {
            return DoWyplatyWOkresie(pracownik, new FromTo(Date.Today.FirstDayMonth(), Date.Today.LastDayMonth()));
        }

        // Praca poza normą, której nie odłożono do magazynu, + godziny przekwalifikowane do wypłaty
        // - godziny elementów nadgodzin już naliczonych za ten okres.
        public static Time DoWyplatyWOkresie(Pracownik pracownik, FromTo okres) {
            KalkulatorPracy kalkPracy = pracownik.Czasy.KalkPracy;
            Time doWyplaty = PracaPozaNormaBezOdpracowan(pracownik, okres);

            foreach (DefinicjaStrefy definicja in KalendModule.GetInstance(pracownik.Session).DefinicjeStref) {
                if (CzyWyjsciePrywatne(definicja))
                    continue;
                if (definicja.Rozliczenie == TypRozliczenia.WKolejnychMiesiącach)
                    doWyplaty -= kalkPracy.Praca(okres, definicja).Czas;
                else if (definicja.Rozliczenie == TypRozliczenia.WypłataNadgodzin)
                    doWyplaty += kalkPracy.Praca(okres, definicja).Czas;
            }

            foreach (WypElement elementWyplaty in pracownik.Elementy[okres]) {
                if (elementWyplaty.RodzajZrodla == RodzajŹródłaWypłaty.NadgodzinyI
                    || elementWyplaty.RodzajZrodla == RodzajŹródłaWypłaty.NadgodzinyII
                    || elementWyplaty.RodzajZrodla == RodzajŹródłaWypłaty.NadgodzinyŚw)
                    doWyplaty -= elementWyplaty.Czas;
            }
            return doWyplaty > Time.Zero ? doWyplaty : Time.Zero;
        }

        // ---------------- magazyn nadgodzin ----------------

        public class StanDoOdbioru {
            public int Dni;
            public Time Godziny = Time.Zero;
        }

        // Nadgodziny jednej strefy: część "dniówkowa" (dzień wolny do odbioru) i godziny ponad nią.
        class PulaNadgodzin {
            public Date Data;
            public int ID;
            public Time CzescDnia = Time.Zero;
            public Time Godziny = Time.Zero;
        }

        // Cały magazyn pracownika (bez ograniczenia do okresu - nierozliczone godziny przechodzą na kolejne okresy).
        // Strefy wyjść prywatnych (wyjście, odpracowanie, potrącenie) są pomijane po obu stronach.
        // Dzień wolny do odbioru = praca w dniu wolnym wg planu; część "dniówkowa" = do normy dobowej etatu
        // z uwzględnieniem wymiaru (jak w enova przy odbiorze dnia wolnego), reszta to godziny do odbioru.
        // Rozliczenia:
        //  - sparowane przez enova (obrót, po "Rozlicz nadgodziny" / dokumencie rozliczenia) zdejmują swoją strefę;
        //  - niesparowane (ręcznie wpisany odbiór/wypłata wisi osobno), od najstarszych: odbiór co najmniej
        //    dniówki zdejmuje najpierw najstarszy pasujący dzień wolny, mniejszy - najpierw godziny;
        //    gdy godzin brak, zdejmowany jest dzień, a jego reszta przechodzi do godzin.
        public static StanDoOdbioru PoliczDoOdbioru(Pracownik pracownik) {
            Dictionary<StrefaPracy, Time> wypracowaneWStrefie = new Dictionary<StrefaPracy, Time>();
            Dictionary<StrefaPracy, Time> sparowaneWStrefie = new Dictionary<StrefaPracy, Time>();
            List<ZasobRN> niesparowaneRozliczenia = new List<ZasobRN>();
            Time rozliczoneZOdpracowan = Time.Zero;   // odbiór/wypłata sparowane przez enova z odpracowaniem wyjścia

            foreach (ZasobRN zasob in pracownik.ZasobyRN) {
                if (CzyWyjsciePrywatne(zasob.Strefa.Definicja))
                    continue;
                if (zasob.Kierunek == KierunekMagazynuNadgodzin.NadgodzinyDoRozliczenia)
                    Dodaj(wypracowaneWStrefie, zasob.Strefa, zasob.Partia.Rozliczany);
                else
                    niesparowaneRozliczenia.Add(zasob);
            }

            foreach (ObrotRN obrot in KalendModule.GetInstance(pracownik.Session).ObrotyRN.WgPracownik[pracownik]) {
                bool zWyjsciaPrywatnego = CzyWyjsciePrywatne(obrot.StrefaNadgodziny.Definicja);
                bool naWyjsciePrywatne = CzyWyjsciePrywatne(obrot.StrefaRozliczenie.Definicja);
                if (!zWyjsciaPrywatnego) {
                    Dodaj(wypracowaneWStrefie, obrot.StrefaNadgodziny, obrot.Nadgodziny.Rozliczany);
                    if (!naWyjsciePrywatne)
                        Dodaj(sparowaneWStrefie, obrot.StrefaNadgodziny, obrot.Nadgodziny.Rozliczany);
                }
                else if (!naWyjsciePrywatne)
                    rozliczoneZOdpracowan += obrot.Rozliczenie.Rozliczany;
            }

            List<PulaNadgodzin> pule = new List<PulaNadgodzin>();
            KalkulatorPracownika czasy = pracownik.Czasy;
            foreach (KeyValuePair<StrefaPracy, Time> strefaNadgodzin in wypracowaneWStrefie) {
                Time sparowano;
                if (!sparowaneWStrefie.TryGetValue(strefaNadgodzin.Key, out sparowano))
                    sparowano = Time.Zero;
                PulaNadgodzin pula = new PulaNadgodzin();
                pula.Data = strefaNadgodzin.Key.Dzien.Data;
                pula.ID = strefaNadgodzin.Key.ID;
                pula.Godziny = strefaNadgodzin.Value - sparowano;
                Time dniowka = Dniowka(pracownik, czasy, pula.Data, strefaNadgodzin.Value);
                if (dniowka > Time.Zero && pula.Godziny >= dniowka) {
                    pula.CzescDnia = dniowka;
                    pula.Godziny -= dniowka;
                }
                pule.Add(pula);
            }
            pule.Sort(delegate (PulaNadgodzin pierwsza, PulaNadgodzin druga) {
                return pierwsza.Data == druga.Data ? pierwsza.ID.CompareTo(druga.ID) : (pierwsza.Data < druga.Data ? -1 : 1);
            });
            niesparowaneRozliczenia.Sort(delegate (ZasobRN pierwszy, ZasobRN drugi) {
                return pierwszy.Data == drugi.Data ? pierwszy.ID.CompareTo(drugi.ID) : (pierwszy.Data < drugi.Data ? -1 : 1);
            });

            Time bezPokrycia = Time.Zero;
            foreach (ZasobRN rozliczenie in niesparowaneRozliczenia)
                bezPokrycia += Zdejmij(pule, rozliczenie.Partia.Rozliczany);
            bezPokrycia += Zdejmij(pule, rozliczoneZOdpracowan);

            StanDoOdbioru stan = new StanDoOdbioru();
            foreach (PulaNadgodzin pula in pule) {
                if (pula.CzescDnia > Time.Zero)
                    stan.Dni++;
                stan.Godziny += pula.Godziny;
            }
            stan.Godziny -= bezPokrycia;   // odbiór "na zapas", bez pokrycia w nadgodzinach
            return stan;
        }

        // Zdejmuje rozliczenie z pul; zwraca część bez pokrycia.
        static Time Zdejmij(List<PulaNadgodzin> pule, Time doZdjecia) {
            // odbiór dnia wolnego: całe dniówki, od najstarszego dnia mieszczącego się w rozliczeniu
            bool zdjetoDzien = true;
            while (zdjetoDzien && doZdjecia > Time.Zero) {
                zdjetoDzien = false;
                foreach (PulaNadgodzin pula in pule)
                    if (pula.CzescDnia > Time.Zero && pula.CzescDnia <= doZdjecia) {
                        doZdjecia -= pula.CzescDnia;
                        pula.CzescDnia = Time.Zero;
                        zdjetoDzien = true;
                        break;
                    }
            }
            foreach (PulaNadgodzin pula in pule) {
                Time zdjete = Time.Min(pula.Godziny, doZdjecia);
                pula.Godziny -= zdjete;
                doZdjecia -= zdjete;
            }
            foreach (PulaNadgodzin pula in pule)
                if (doZdjecia > Time.Zero && pula.CzescDnia > Time.Zero) {
                    Time zdjete = Time.Min(pula.CzescDnia, doZdjecia);
                    pula.Godziny += pula.CzescDnia - zdjete;   // dzień rozbity - reszta przechodzi do godzin
                    pula.CzescDnia = Time.Zero;
                    doZdjecia -= zdjete;
                }
            return doZdjecia;
        }

        // Część "dniówkowa" pracy w dniu wolnym wg planu (0 dla dnia pracy).
        static Time Dniowka(Pracownik pracownik, KalkulatorPracownika czasy, Date data, Time wypracowano) {
            Dzien dzienPlanu = czasy.KalkPlanu[data] ?? czasy.KalkPracy[data];
            if (dzienPlanu == null || dzienPlanu.Definicja == null || dzienPlanu.Definicja.Typ == TypDnia.Pracy)
                return Time.Zero;
            // Norma z wymiarem (½ etatu = 4 h). Ze standardową normą etat zwraca "Wartość dobową" kalendarza -
            // niewypełniona = 0, a enova bierze wtedy normę z konfiguracji (8 h).
            Etat etat = pracownik[data].Etat;
            Time normaDobowa = etat.WymNormaDobowa;
            if (normaDobowa <= Time.Zero)
                normaDobowa = etat.NormaDobowa;
            if (normaDobowa <= Time.Zero)
                normaDobowa = new Time(8, 0);
            return Time.Min(wypracowano, normaDobowa);
        }

        // Praca poza normą w okresie bez godzin odpracowania wyjścia prywatnego - per dzień, bo odpracowanie
        // wpisane samą strefą rozliczenia (bez pracy poza normą) nie może zmniejszać nadgodzin z innych dni.
        public static Time PracaPozaNormaBezOdpracowan(Pracownik pracownik, FromTo okres) {
            View<DzienPracy> dniPracy = KalendModule.GetInstance(pracownik.Session).DniPracy.WgPracownik[pracownik].CreateView();
            dniPracy.Condition = new FieldCondition.Contain("Data", okres);
            Time wynik = Time.Zero;
            foreach (DzienPracy dzienPracy in dniPracy) {
                Time pozaNorma = Time.Zero;
                Time odpracowanie = Time.Zero;
                foreach (StrefaPracy strefa in dzienPracy.Strefy) {
                    if (strefa.Definicja == null)
                        continue;
                    if (strefa.Definicja.Nazwa == "Praca poza normą")
                        pozaNorma += strefa.Czas;
                    else if (strefa.Definicja.Nazwa == "Rozliczenie wyjścia prywatnego")
                        odpracowanie += strefa.Czas;
                }
                if (pozaNorma > odpracowanie)
                    wynik += pozaNorma - odpracowanie;
            }
            return wynik;
        }

        // ---------------- pomocnicze ----------------

        // shortcut: wyjścia prywatne rozpoznawane po nazwie strefy ("Wyjście prywatne", "Rozliczenie/Potrącenie wyjścia prywatnego");
        // przy innym nazewnictwie u klienta podać tu listę definicji.
        public static bool CzyWyjsciePrywatne(DefinicjaStrefy definicja) {
            return definicja != null && definicja.Nazwa.IndexOf("prywatn", StringComparison.OrdinalIgnoreCase) >= 0;
        }

        // Bez definicji Praca() policzyłaby wszystkie strefy dnia - brak strefy o tej nazwie = 0.
        public static Time CzasStrefy(Pracownik pracownik, KalkulatorPracy kalkPracy, FromTo okres, string nazwaStrefy) {
            DefinicjaStrefy definicja = KalendModule.GetInstance(pracownik.Session).DefinicjeStref.WgNazwy[nazwaStrefy];
            return definicja == null ? Time.Zero : kalkPracy.Praca(okres, definicja).Czas;
        }

        static void Dodaj(Dictionary<StrefaPracy, Time> czasWStrefie, StrefaPracy strefa, Time czas) {
            Time dotychczas;
            if (!czasWStrefie.TryGetValue(strefa, out dotychczas))
                dotychczas = Time.Zero;
            czasWStrefie[strefa] = dotychczas + czas;
        }
    }
}
