public bool Get_Feature_CzasPracyZatwierdzony(Context cx) {
	// Okres sprawdzania: okres z filtra listy (listy kadrowe trzymają go w parametrach
	// widoku dziedziczących po OkresContext, inne widoki mogą wkładać do kontekstu sam
	// FromTo), a gdy go brak - miesiąc daty aktualności.
	OkresContext parametryListy;
	FromTo okresZKontekstu;
	FromTo okres;
	if (cx.Get<OkresContext>(out parametryListy) && parametryListy != null)
		okres = parametryListy.Okres;
	else if (cx.Get<FromTo>(out okresZKontekstu))
		okres = okresZKontekstu;
	else {
		Date dzis = ActualDate.Today(cx);
		okres = new FromTo(dzis.FirstDayMonth(), dzis.LastDayMonth());
	}

	// Pozycje czasu pracy pracownika na dokumentach aktualizacji kalendarza;
	// liczy się dokument zatwierdzony, którego okres zachodzi na sprawdzany okres.
	KalendModule kalend = KalendModule.GetInstance(Session);
	foreach (PozycjaAktualizacjiCzasu poz in kalend.PozAktCzasu.WgZrodloPlanu[Row]) {
		DokumentAktualizacjiKalendarza dok = poz.Dokument;
		if (dok == null || dok.Stan != StanyDokumentuAktulizacjiKalendarza.Zatwierdzony)
			continue;
		if (dok.Okres.From <= okres.To && dok.Okres.To >= okres.From)
			return true;
	}
	return false;
}
