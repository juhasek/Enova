public decimal Feature_Nadgodziny_50 {
	get {

		if (Row.Definicja == null)
			return 0;

		if (!Row.Definicja.Nazwa.Contains("Praca poza normą"))
			return 0;

		DzienPracy dzienRow = Row.Dzien;
		Pracownik pracownik = dzienRow.Pracownik;
		Date data = dzienRow.Data;

		PracHistoria ph = pracownik[data];
		if (ph == null || ph.Etat == null || ph.Etat.Kalendarz == null)
			return 0;

		Kalendarz kalendarz = ph.Etat.Kalendarz;

		KalkulatorPracy kalkPracy = pracownik.Czasy.KalkPracy;
		KalkulatorPlanu kalkPlanu = pracownik.Czasy.KalkPlanu;
		Dzien dzienPracy = kalkPracy[data];
		Dzien dzienPlanu = kalkPlanu[data];

		if (dzienPracy == null || dzienPracy.Definicja == null)
			return 0;

		// Dni niedzielno-świąteczne rozlicza osobna cecha "Nadgodziny NSW" - tu 0
		if (dzienPracy.Definicja.NadgodzinySW || dzienPracy.Definicja.Typ == TypDnia.Świąteczny)
			return 0;

		// Norma dobowa - wg algorytmu skonfigurowanego na kalendarzu pracownika
		// (Nadgodziny.AlgorytmDobowa): z planu dnia, ze stałej normy Etatu, albo jako większa
		// z tych dwóch (równoważny czas pracy).
		//
		// Wyjątek: dzień PRACY, dla którego nie ma żadnego zaplanowanego czasu pracy
		// (plan 0:00 - np. dzień bez wygenerowanego planu) nie ma normy do wypracowania, więc
		// cała praca poza normą jest w nim nadgodziną dobową. Sam silnik podstawia tu normę
		// z Etatu (AlgorytmNorma.Kalendarz: "plan, a gdy 0:00 -> norma Etatu"; Konfiguracja:
		// zawsze norma Etatu), ale u klienta obowiązuje reguła "norma dobowa = plan dnia" -
		// tak liczy wieloletnia cecha produkcyjna "Nadgodziny 50_old" (norma = plan dnia dla
		// pełnego etatu) i tak potwierdził klient na NG-07 / 10.10.2026: 2:00 poza normą
		// w dniu bez planu to 2:00 na 50%, nie okresowe.
		//
		// Dni WOLNE (Typ = Wolny, np. wolna sobota) ten wyjątek NIE obejmuje - tam norma
		// zostaje z konfiguracji (zwykle 8:00 z Etatu), bo tak liczy i silnik, i stara cecha
		// produkcyjna (osobna gałąź dla dnia wolnego z progiem 8:00).
		Time planCzas = dzienPlanu != null ? dzienPlanu.Czas : Time.Zero;
		if (planCzas == Time.Empty)
			planCzas = Time.Zero;

		Time normaDobowa;
		if (planCzas <= Time.Zero && dzienPracy.Definicja.Typ == TypDnia.Pracy)
			normaDobowa = Time.Zero;
		else if (kalendarz.Nadgodziny.AlgorytmDobowa == AlgorytmNorma.Kalendarz)
			normaDobowa = planCzas > Time.Zero ? planCzas : ph.Etat.NormaDobowa;
		else if (kalendarz.Nadgodziny.AlgorytmDobowa == AlgorytmNorma.RównoważnyCzasPracy)
			normaDobowa = planCzas > ph.Etat.NormaDobowa ? planCzas : ph.Etat.NormaDobowa;
		else
			normaDobowa = ph.Etat.NormaDobowa;

		// Strefy rozliczeniowe tego dnia - odbiór nadgodzin i wypłata nadgodzin (rozliczenie
		// "Z poprzednich miesięcy"/"Wypłata nadgodzin") nie wchodzą do czasu pracy, a mimo to
		// wypełniają normę dnia: system dolicza je do czasu pracy przed porównaniem z normą
		// (Dzien.ZPrzeniesienia w KalkulatorNadgodzin.NadgodzinyDobowe), co jest równoważne
		// obniżeniu samej normy. Bez tego dzień z odbiorem nadgodzin i jednocześnie
		// wypracowanymi nadgodzinami zaniża nadwyżkę o odebrane godziny.
		//
		// Godzin odłożonych do magazynu (rozliczenie "W kolejnych miesiącach", strefa
		// "Nadgodziny do przeniesienia") normą świadomie NIE korygujemy. Silnik odejmuje je od
		// czasu pracy całego dnia, ale podstawą tej cechy są tylko strefy "Praca w normie" /
		// "Praca poza normą" - godziny idące do magazynu są w tym wdrożeniu wpisywane w
		// osobnych strefach ("Godziny do odbioru"), których w tej podstawie nie ma, więc nie
		// ma czego kompensować. Podniesiona norma przeklasyfikowałaby wtedy realne nadgodziny
		// dobowe na okresowe (zgłoszenie NG-07 / 10.10.2026: 8:00 "do odbioru" + 2:00 poza
		// normą dawało 2:00 okresowych zamiast 2:00 na 50%).
		Time zPrzeniesienia = Time.Zero;
		foreach (StrefaPracy stRozl in dzienRow.Strefy)
		{
			if (stRozl.Definicja == null || stRozl.Czas == Time.Empty)
				continue;
			if (stRozl.Definicja.Rozliczenie == TypRozliczenia.ZPoprzednichMiesięcy || stRozl.Definicja.Rozliczenie == TypRozliczenia.WypłataNadgodzin)
				zPrzeniesienia += stRozl.Czas;
		}

		normaDobowa = normaDobowa - zPrzeniesienia;
		if (normaDobowa < Time.Zero)
			normaDobowa = Time.Zero;

		// Chronologiczna suma stref "Praca w normie" + "Praca poza normą" (w tym "awaria") -
		// wyznaczenie części nadwyżki ponad normę dobową przypadającej właśnie na Row, bez
		// podwójnego naliczenia z innymi strefami "poza normą" tego samego dnia
		Time suma = Time.Zero;
		Time nadwyzkaRow = Time.Zero;
		foreach (StrefaPracy st in dzienRow.Strefy.OrderBy(s => s.OdGodziny))
		{
			if (st.Definicja == null)
				continue;
			bool wPodstawie = st.Definicja.Nazwa.Contains("Praca w normie") || st.Definicja.Nazwa.Contains("Praca poza normą");
			if (!wPodstawie)
				continue;

			Time przedStrefa = suma;
			suma += st.Czas;

			if (st == Row)
			{
				Time dolna = przedStrefa > normaDobowa ? przedStrefa : normaDobowa;
				Time gorna = suma > normaDobowa ? suma : normaDobowa;
				nadwyzkaRow = gorna > dolna ? gorna - dolna : Time.Zero;
				break;
			}
		}

		if (nadwyzkaRow <= Time.Zero)
			return 0;

		Time poczatekNadwyzki = Row.OdGodziny + (Row.Czas - nadwyzkaRow);

		// Limit dobowy 50% - aktywny tylko, gdy w konfiguracji nadgodzin włączone jest "Dobowe 100"
		// (zgodnie z regułą stosowaną przez system od 2003 roku - inaczej cały dobowy nadmiar
		// liczy się jako 50%, bez limitu godzinowego)
		bool limitDobowyAktywny = KalendModule.GetInstance(Row).Config.Nadgodziny.Dobowe100;
		if (limitDobowyAktywny)
		{
			Time limit = kalendarz.Nadgodziny.Nadgodz50;
			if (nadwyzkaRow > limit)
				nadwyzkaRow = limit; // reszta -> "Nadgodziny 100"
		}

		// Godziny nocne wymuszone na 100% (konfiguracja "Nocne 100") - wg realnego okna nocnego
		// wyznaczonego przez sam system (KalkulatorPracy.NocOkres), z uwzględnieniem przejścia
		// przez północ
		if (nadwyzkaRow > Time.Zero && KalendModule.GetInstance(Row).Config.Nadgodziny.Nocne100)
		{
			FromTimes nocOkres = kalkPracy.NocOkres(ph);
			FromTimes oknoNadwyzki = FromTimes.New(new FromTime(poczatekNadwyzki, nadwyzkaRow));
			Time wNocy = oknoNadwyzki.Intersection(nocOkres).Time;
			nadwyzkaRow -= wNocy; // ta część -> "Nadgodziny 100"
		}

		return (decimal)nadwyzkaRow.TotalHours;
	}
}
