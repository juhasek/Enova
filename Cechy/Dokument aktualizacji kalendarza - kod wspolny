using System;
using System.Collections.Generic;
using Soneta.Types;
using Soneta.Business;
using Soneta.Kadry;
using Soneta.Kalend;

namespace A1.Runtime.Business.TblCodeFiles {

    // Wspólny kod cech tabeli DokAktKalendarzy (dokumenty aktualizacji kalendarza).
    public static class A1DokumentyAktualizacjiKalendarza
    {
        // Pracownicy z pozycji planu i czasu pracy dokumentu (umowa -> jej pracownik), bez powtórzeń.
        public static List<Pracownik> PracownicyDokumentu(DokumentAktualizacjiKalendarza dokument)
        {
            List<IZrodloPlanu> zrodla = new List<IZrodloPlanu>();
            foreach (PozycjaAktualizacjiKalendarza pozycjaPlanu in dokument.PozycjePlan)
                zrodla.Add(pozycjaPlanu.ZrodloPlanu);
            foreach (PozycjaAktualizacjiCzasu pozycjaCzasu in dokument.PozycjeCzas)
                zrodla.Add(pozycjaCzasu.ZrodloPlanu);

            List<Pracownik> pracownicy = new List<Pracownik>();
            foreach (IZrodloPlanu zrodlo in zrodla) {
                Pracownik pracownik = zrodlo as Pracownik;
                Umowa umowa = zrodlo as Umowa;
                if (pracownik == null && umowa != null)
                    pracownik = umowa.Pracownik;
                if (pracownik != null && !pracownicy.Contains(pracownik))
                    pracownicy.Add(pracownik);
            }
            return pracownicy;
        }

        // Wydziały pracowników dokumentu z etatu na ostatni dzień okresu dokumentu, bez powtórzeń.
        public static List<Wydzial> WydzialyDokumentu(DokumentAktualizacjiKalendarza dokument)
        {
            List<Wydzial> wydzialy = new List<Wydzial>();
            foreach (Pracownik pracownik in PracownicyDokumentu(dokument)) {
                PracHistoria historia = pracownik[dokument.Okres.To];
                Wydzial wydzial = historia == null ? null : historia.Etat.Wydzial;
                if (wydzial != null && !wydzialy.Contains(wydzial))
                    wydzialy.Add(wydzial);
            }
            return wydzialy;
        }

        // Kroki standardowego procesu "Dokumenty aktualizacji kalendarza" (Guid definicji zadania).
        static readonly Guid KrokWypelniany = new Guid("00000000-0005-0037-0010-000000000000");
        static readonly Guid KrokDoAkceptacji = new Guid("00000000-0005-0037-0013-000000000000");
        static readonly Guid KrokPoprawiany = new Guid("00000000-0005-0037-0014-000000000000");

        // Ostatnie wykonane zadanie procesu dokumentu z podanych kroków (null, gdy brak).
        static Soneta.Business.Db.Task OstatnieWykonaneZadanie(DokumentAktualizacjiKalendarza dokument, params Guid[] kroki)
        {
            Soneta.Business.Db.Task ostatnie = null;
            Soneta.Business.Db.BusinessModule bm = Soneta.Business.Db.BusinessModule.GetInstance(dokument.Session);
            foreach (Soneta.Business.Db.TaskLinkedObj powiazanie in bm.TaskLinkedObjs.WgLinkedObject[dokument]) {
                Soneta.Business.Db.Task zadanie = powiazanie.Task;
                if (zadanie == null || zadanie.Definition == null || Array.IndexOf(kroki, zadanie.Definition.Guid) < 0)
                    continue;
                if (zadanie.ExecutionTime == DateTime.MinValue || zadanie.Executor == null)
                    continue;
                if (ostatnie == null || zadanie.ExecutionTime > ostatnie.ExecutionTime)
                    ostatnie = zadanie;
            }
            return ostatnie;
        }

        // Złożenie dokumentu = przekazanie do akceptacji z kroku Wypełniany albo Poprawiany.
        public static Soneta.Business.Db.Task ZadanieZlozenia(DokumentAktualizacjiKalendarza dokument)
        {
            return OstatnieWykonaneZadanie(dokument, KrokWypelniany, KrokPoprawiany);
        }

        // Zatwierdzenie = ostatnia decyzja w kroku Do akceptacji zatwierdzonego dokumentu.
        public static Soneta.Business.Db.Task ZadanieZatwierdzenia(DokumentAktualizacjiKalendarza dokument)
        {
            if (dokument.Stan != StanyDokumentuAktulizacjiKalendarza.Zatwierdzony)
                return null;
            return OstatnieWykonaneZadanie(dokument, KrokDoAkceptacji);
        }

        public static string Wykonawca(Soneta.Business.Db.Task zadanie)
        {
            return zadanie == null ? "" : zadanie.Executor.ToString();
        }

        public static string DataWykonania(Soneta.Business.Db.Task zadanie)
        {
            return zadanie == null ? "" : zadanie.ExecutionTime.ToString("yyyy-MM-dd HH:mm");
        }

        // Kim jest wykonawca względem pracowników dokumentu: Pracownik, Przełożony albo Inny operator
        // (np. administrator w programie). Pracownik z pulpitu jest wykonawcą jako Pracownik.
        public static string RolaWykonawcy(DokumentAktualizacjiKalendarza dokument, Soneta.Business.Db.Task zadanie)
        {
            if (zadanie == null)
                return "";
            Pracownik wykonawca = zadanie.Executor as Pracownik;
            if (wykonawca == null)
                return "Inny operator";
            List<Pracownik> pracownicy = PracownicyDokumentu(dokument);
            if (pracownicy.Contains(wykonawca))
                return "Pracownik";
            foreach (Pracownik pracownik in pracownicy)
                if (pracownik.StrukturaOraganizacyjna.GetDomyślnyPrzełożony(dokument.Okres.To) == wykonawca)
                    return "Przełożony";
            return "Inny pracownik";
        }
    }
}
