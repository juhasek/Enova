public string Get_Feature_OkresFiltra(Context cx) {
	// Okres wybrany w filtrze listy. Listy kadrowe (np. Kadry -> Pracownicy) trzymają go
	// w obiekcie parametrów widoku dziedziczącym po OkresContext - kontekst znajduje go po
	// typie bazowym. Inne widoki mogą wkładać do kontekstu sam okres (FromTo).
	// Gdy widok nie ma filtra okresu, cecha zwraca pusty tekst.
	OkresContext parametryListy;
	FromTo okresZKontekstu;
	FromTo okres = FromTo.Empty;
	if (cx.Get<OkresContext>(out parametryListy) && parametryListy != null)
		okres = parametryListy.Okres;
	else if (cx.Get<FromTo>(out okresZKontekstu))
		okres = okresZKontekstu;

	if (okres == FromTo.Empty)
		return "";
	return okres.ToString();
}
