public string Feature_Przelozony {
    get {
        // Bezpośredni przełożony wg domyślnej struktury podległości na ostatni dzień okresu dokumentu.
        List<string> przelozeni = new List<string>();
        foreach (Pracownik pracownik in A1.Runtime.Business.TblCodeFiles.A1DokumentyAktualizacjiKalendarza.PracownicyDokumentu(Row)) {
            Pracownik przelozony = pracownik.StrukturaOraganizacyjna.GetDomyślnyPrzełożony(Row.Okres.To);
            if (przelozony != null && !przelozeni.Contains(przelozony.NazwiskoImię))
                przelozeni.Add(przelozony.NazwiskoImię);
        }
        return string.Join(", ", przelozeni);
    }
}
