                Time sumaDoby = Time.Zero;

                foreach(StrefaPracy st in Row.Dzien.Strefy.OrderBy(s => s.OdGodziny))
                {
                    // Poprawka 27.08.2026 - warunek zawierał sztywne dopasowanie nazwy dnia
                    // "Dzień wolny", podczas gdy realna definicja dnia wolnego w tym środowisku
                    // nazywa się po prostu "Wolny" (zdiagnozowane logiem). Praca poza normą w taki
                    // dzień nigdy nie łapała się w ten warunek i trafiała do gałęzi "else" (pełny
                    // etat), zwracającej płaskie 8h zamiast realnie przepracowanego czasu. Warunek
                    // oparty teraz tylko o TypDnia.Wolny i flagę NadgodzinySW (analogicznie do
                    // gałęzi świątecznej wyżej).
                    if(Row.Definicja.Nazwa.Contains(strefa1) && dzienPracy.Definicja.Typ == TypDnia.Wolny && !dzienPracy.Definicja.NadgodzinySW)
                    {
                        suma +=st.Czas;
                        if(st == Row)
                        {
                            if(suma > plan)
                            {
                                if(suma <= czasTemp)
                                {
                                    return (decimal)st.Czas.TotalHours;
                                }
                                if(suma > czasTemp)
                                {
                                    if(suma - st.Czas > czasTemp)
                                        return 0;
                                    if(suma - st.Czas < czasTemp)
                                        return (decimal)(czasTemp - (suma - st.Czas)).TotalHours;
                                }
                            }
                            else
                                return 0;
                        }
                    }
                    else     //pracownik na pełny etat, dzień zaplanowany na 4h przepracował 10h,  4h 100% okresowe i 2 50% - sprawdzić plan pracy, czas przepracowany, jeżeli czas pracy jest większy od normy to 8-plan pracy = 100
                    {
                        if(Row.Dzien.Pracownik[Row.Dzien.Data].Etat.Zaszeregowanie.Wymiar == Fraction.One)
                            norma = new Time(8,0);

                        // Poprawka 04.09.2026 - zgłoszenie klienta: przy kilku strefach
                        // "Praca poza normą"/"...awaria" w jednym dniu każda kolejna strefa
                        // wykazywała pełne (norma - plan) godzin nadgodzin okresowych.
                        // Poprzedni kod robił bezwarunkowy "return (norma - plan)" już na
                        // pierwszej iteracji pętli, nie sumując godzin rozliczonych w
                        // poprzednich strefach ani nie patrząc na realny czas bieżącej
                        // strefy. Teraz akumulujemy czas stref po kolei (jak w gałęzi dnia
                        // wolnego) i dla strefy == Row zwracamy tylko tę część jej godzin,
                        // która mieści się w dobowym oknie nadgodzin okresowych (plan, norma].
                        sumaDoby += st.Czas;
                        if(st == Row)
                        {
                            if(praca > plan && plan < norma)
                            {
                                Time przedStrefa = sumaDoby - st.Czas;
                                Time dolna = przedStrefa < plan ? plan : (przedStrefa < norma ? przedStrefa : norma);
                                Time gorna = sumaDoby < plan ? plan : (sumaDoby < norma ? sumaDoby : norma);
                                return gorna > dolna ? (decimal)(gorna - dolna).TotalHours : (decimal)0;
                            }
                            return 0;
                        }
                        continue;
                    }
                    //obsługa tzn "czarnych dziur" czyli godzin przypadających po dobie w niedziele a przed dobą poniedziałkową
                    //if(dzienPracy.Definicja.Typ == TypDnia.Pracy && dzienPracy.Data.DayOfWeek == DayOfWeek.Monday)
                    if(dzienPracyPoprzedni.Definicja.Typ == TypDnia.Świąteczny && dzienPlanu.Czas != Time.Zero)
                    {
                        if(odGodziny >= dobaNiedziela && doGodziny <= dzienPlanu.OdGodziny)
                            return(decimal)Row.Czas.TotalHours;
                        if(odGodziny < dobaNiedziela && doGodziny <= dzienPlanu.OdGodziny)
                            return (decimal)(doGodziny - dobaNiedziela).TotalHours;
                        if(odGodziny >= dobaNiedziela && odGodziny <= dzienPlanu.OdGodziny && doGodziny > dzienPlanu.OdGodziny)
                            return (decimal)(dzienPlanu.OdGodziny - odGodziny).TotalHours;
                        if(odGodziny < dobaNiedziela && doGodziny > dzienPlanu.OdGodziny)
                            return (decimal)(dzienPlanu.OdGodziny - dobaNiedziela).TotalHours;
                    }
                }

