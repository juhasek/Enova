                {

                    return (decimal)0;
                }



                Time doGodziny = Row.OdGodziny + Row.Czas;
                Time odGodziny = Row.OdGodziny;

                KalkulatorPracy kalkpracy = Row.Dzien.Pracownik.Czasy.KalkPracy;
                KalkulatorPlanu kalkplanu = Row.Dzien.Pracownik.Czasy.KalkPlanu;

                Dzien dzienPracy = kalkpracy[Row.Dzien.Data];
                Dzien dzienPlanu = kalkplanu[Row.Dzien.Data];
                Dzien dzienPracyPoprzedni = kalkpracy[Row.Dzien.Data.AddDays(-1)];
                Time praca = dzienPracy.Czas;
                Time plan = dzienPlanu.Czas;
                Time czasTemp = new Time(8,0);//* Row.Dzien.Pracownik.Last.Etat.Wymiar;
                Time dzien = Dzien.DoGodziny(dzienPracy);
                Time roznica = dzien - doGodzinyDzien;
