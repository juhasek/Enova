<Project Sdk="Microsoft.NET.Sdk">

  <!-- Buduje "Scenariusze testowe.xlsx" z pliku scenariusze.json (tworzy go generuj.js).
       Uruchamiany poza enova:
       dotnet build -c Release -o bin\out ; dotnet bin\out\GenArkusz.dll -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnovaDir)' == ''">
    <EnovaDir>C:\enovaServer\2610\Soneta.Products.Server.Standard</EnovaDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(EnovaDir)\DevExpress.Spreadsheet.v25.2.Core.dll" />
    <Reference Include="$(EnovaDir)\DevExpress.Docs.v25.2.dll" />
    <Reference Include="$(EnovaDir)\DevExpress.Data.v25.2.dll" />
    <Reference Include="$(EnovaDir)\DevExpress.Office.v25.2.Core.dll" />
    <Reference Include="$(EnovaDir)\DevExpress.Drawing.v25.2.dll" />
    <Reference Include="$(EnovaDir)\DevExpress.Printing.v25.2.Core.dll" />
    <Reference Include="$(EnovaDir)\System.Drawing.Common.dll" />
  </ItemGroup>

</Project>
