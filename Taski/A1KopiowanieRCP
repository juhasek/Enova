//----------------------------------------------------------------------------------
// Dodatkowy kod do kompilacji "A1KopiowanieRCP" (projekt Business) - wspolna metoda kopiujaca
// zapis Oryginalnych danych RCP do Danych RCP dla zadan:
// - "Kopiuj oryginalne dane RCP" (wyzwalacz przy zapisie, tabela Pracownicy),
// - "Kopiuj oryginalne dane RCP harmonogram" (akcja harmonogramu, tabela CfgNodes).
//----------------------------------------------------------------------------------

using System;
using Soneta.Types;
using Soneta.Business;
using Soneta.Kalend;

namespace A1.Runtime.Business.TblCodeFiles {

    public static class A1KopiowanieRCP
    {
        // Kopiuje jeden oryginalny zapis do Danych RCP tak jak czynnosc "Kopiuj oryginalne dane";
        // false, gdy kopia juz istnieje. Kopia istnieje, gdy w Danych RCP jest zapis powiazany
        // z oryginalem (WeWyO) albo - dla danych z importu standardowego, ktory zapisuje do obu tabel
        // bez powiazania - zapis bez powiazania z ta sama data, godzina i typem.
        public static bool KopiujZapis(KalendModule kalend, WejscieWyjscieO oryginal) {
            if (oryginal.Pracownik == null)
                return false;
            foreach (WejscieWyjscieI powiazany in kalend.WejsciaWyjsciaI.WgWeWyO[oryginal])
                return false;

            Date data = oryginal.DataEdytowana != Date.Empty ? oryginal.DataEdytowana : oryginal.Data;
            // Godzina edytowana 0:00 przy pustej dacie edytowanej = brak edycji (tak zostaje po zapisie
            // z pominieciem logiki enova, np. import wg rekordow albo zapis integracji prosto do bazy).
            bool bezEdycjiGodziny = oryginal.GodzinaEdytowana == Time.Empty || (oryginal.GodzinaEdytowana == new Time(0, 0) && oryginal.DataEdytowana == Date.Empty);
            Time godzina = bezEdycjiGodziny ? oryginal.Godzina : oryginal.GodzinaEdytowana;
            // Klucz (pracownik, data) - obejmuje tez zapisy dodane w tej samej sesji (np. import z czytnika).
            foreach (WejscieWyjscieI istniejacy in kalend.WejsciaWyjsciaI.WgPracownik[oryginal.Pracownik, data]) {
                if (istniejacy.WeWyO == null && istniejacy.Godzina == godzina && istniejacy.Typ == oryginal.Typ)
                    return false;
            }

            WejscieWyjscieI kopia = new WejscieWyjscieI(oryginal.Pracownik);
            kalend.WejsciaWyjsciaI.AddRow(kopia);
            kopia.Data = data;
            kopia.Godzina = godzina;
            kopia.WeWyO = oryginal;
            kopia.Typ = oryginal.Typ;
            kopia.Operacja = oryginal.Operacja;
            kopia.Zaimportowany = false;
            kopia.Stan = TypWeryfikacjiWeWy.Nieoznaczony;
            kopia.CzytnikRCP = oryginal.CzytnikRCP;
            kopia.Uwagi = oryginal.Uwagi;
            return true;
        }
    }
}
