using System;
using System.Collections.Generic;
using System.ComponentModel;
using DevExpress.XtraReports.UI;
using Soneta.Business;
using Soneta.Business.UI.DxReports;
using Soneta.Kadry;
using Soneta.Ksiega;
using Soneta.Place;
using Soneta.Types;
using AltOne.Skanska.Workflow.Extensions;
