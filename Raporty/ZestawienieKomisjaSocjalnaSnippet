    // Zestawienie na posiedzenie Komisji Socjalnej.
    //
    // Wydruk (ZestawienieKomisjaSocjalna.repx) uruchamiany jest z LISTY
    // ŚWIADCZEŃ SOCJALNYCH (ZFŚS / Świadczenia socjalne, obiekt
    // Soneta.Kadry.SwiadczSocjalne, tabela SwiadczeniaSoc) - NIE z listy
    // pracowników jak w poprzedniej wersji. Na tej liście mogą znajdować się
    // zarówno aktualni pracownicy, jak i osoby już niezatrudnione, którym
    // przyznano zapomogę (kwota świadczenia może wynosić nawet 0).
    //
    // DOBÓR PRACOWNIKÓW (parametr "Data posiedzenia komisji"):
    //   Raport skanuje WSZYSTKIE świadczenia socjalne (session.GetKadry().
    //   SwiadczeniaSoc) i bierze każdego pracownika, którego świadczenie ma
    //   cechę "PosiedzenieKomisji" (typu Data) RÓWNĄ dacie z parametru -
    //   dopasowanie jest DOKŁADNE (nie oknem czasowym). Dotyczy to także
    //   pracowników zwolnionych i spoza bieżącego filtra listy.
    //   Parametr "Tylko świadczenia zaznaczone na liście" (domyślnie
    //   odznaczony) pozwala zamiast tego wziąć wyłącznie zaznaczone na liście
    //   wiersze świadczeń (bez sprawdzania cechy - ufamy zaznaczeniu
    //   operatora).
    // Pracownicy sortowani po "Nazwisko i Imię".
    //
    // UKŁAD MASTER-DETAIL: jeden wiersz wydruku = jedna zapomoga (świadczenie
    // socjalne). Dla pracownika z kilkoma zapomogami powstaje kilka wierszy.
    // Kolumny "poziomu pracownika" (Lp, Nr ewid., Nazwisko, Data urodzenia,
    // Jednostka obsługująca, Dochód na członka rodziny) oraz sumy (Kwota
    // zapomogi z 2 lat, Kwota zapomóg z poprzednich 2 lat) wypełniane są
    // TYLKO w pierwszym wierszu grupy pracownika; w kolejnych wierszach te
    // komórki są puste. Dwie listy zapomóg (okno bieżące / poprzednie) są
    // wyrównane wierszami: dłuższa wyznacza liczbę wierszy grupy, krótsza ma
    // puste komórki w nadmiarowych wierszach. Pracownik BEZ ŻADNEJ zapomogi
    // w obu oknach jest pomijany (nie trafia na wydruk, nie zużywa numeru Lp).
    //
    // OKNA CZASOWE SUM to (jak poprzednio) całe LATA KALENDARZOWE liczone od
    // roku parametru "Data posiedzenia komisji" (rok R = rok tej daty). Rok R
    // jest pominięty w obu oknach:
    //   - "z 2 lat"            = lata R-2 i R-1  ([1.1.(R-2), 31.12.(R-1)])
    //   - "z poprzednich 2 lat" = lata R-4 i R-3 ([1.1.(R-4), 31.12.(R-3)])
    // WAŻNA ZMIANA względem poprzedniej wersji: te sumy NIE są już liczone
    // skanując elementy wypłat (WypElement) - źródłem jest teraz kolekcja
    // świadczeń socjalnych pracownika (pracownik.Swiadczenia,
    // SubTable<SwiadczSocjalne>), pole "Data" świadczenia (data przyznania) i
    // Rozliczenie.Kwota. Zapomoga = świadczenie, którego Definicja (rodzaj
    // świadczenia, słownik DefSwiadczSocjal) ma w nazwie "zapomog"/"zapomóg".
    // Kwota 0 jest wartością poprawną i widoczną (nie jest już traktowana
    // jak "brak zapomogi") - pusta komórka oznacza teraz wyłącznie brak
    // JAKIEJKOLWIEK zapomogi w danym oknie, nie zerową kwotę.
    //
    // Dochód na członka rodziny pochodzi z wniosku ZFŚS pracownika (dodatek
    // AltOne.Skanska.Workflow) - patrz PobierzDochodNaCzlonkaRodziny.
    //
    // Odporność na błędy: grupa każdego pracownika budowana jest w osobnym
    // try/catch - błąd dla jednego pracownika daje jeden wiersz "[BŁĄD: ...]"
    // zamiast wywalenia wydruku. Cała metoda BeforePrint jest dodatkowo
    // opakowana w try/catch (jeden diagnostyczny wiersz "BŁĄD" z etapem).
    public class ZestawienieKomisjaSocjalnaSnippet : ReportSnippet
    {
        // Wzorowane na Raporty/OdbiciaRCP i Raporty/SzablonTabela6KolumnSnippet:
        // obecność właściwości oznaczonej [Context(Required = true)] jest tym,
        // co powoduje, że silnik Enova przed drukiem wstrzykuje do snippetu
        // działający Context (pars.Context). W tej instalacji
        // DxReportHelpers.GetContext(this) zwraca null - nie używamy go.
        public class PrnParams : ContextBase
        {
            Date dataPosiedzenia;
            bool tylkoZaznaczeni;

            public PrnParams(Context context) : base(context)
            {
                dataPosiedzenia = Date.Today;
                tylkoZaznaczeni = false;
            }

            [Caption("Data posiedzenia komisji")]
            public Date DataPosiedzenia
            {
                get { return dataPosiedzenia; }
                set
                {
                    dataPosiedzenia = value;
                    OnChanged(EventArgs.Empty);
                }
            }

            // Domyślnie (false) raport skanuje WSZYSTKIE świadczenia socjalne
            // i bierze każdego pracownika, którego świadczenie ma cechę
            // "PosiedzenieKomisji" równą dacie posiedzenia - także zwolnionych,
            // spoza bieżącego filtra listy. true = tylko świadczenia zaznaczone
            // na liście (bez sprawdzania cechy).
            [Caption("Tylko świadczenia zaznaczone na liście")]
            public bool TylkoZaznaczeni
            {
                get { return tylkoZaznaczeni; }
                set
                {
                    tylkoZaznaczeni = value;
                    OnChanged(EventArgs.Empty);
                }
            }
        }

        PrnParams pars;

        [Context(Required = true)]
        public PrnParams Params
        {
            get { return pars; }
            set { pars = value; }
        }

        // Ustawia listę wierszy jako CustomDataSource przez refleksję zamiast
        // bezpośredniego DxReportHelpers.GetDataSourceEmpty(this).CustomDataSource = ...
        // Powód: statyczne odwołanie do właściwości CustomDataSource wymusza w
        // kompilowanym snippecie rozwiązanie pełnej hierarchii klas
        // BusinessDataSource (klasa bazowa DataComponentBase z zestawu
        // DevExpress.DataAccess.v24.1) - w środowisku, w którym ten zestaw nie
        // jest dostępny (Pulpit WWW), kompilacja snippetu kończy się błędem
        // CS0012, a że snippety są tam kompilowane razem w jednej paczce, psuje
        // to też inne, niepowiązane raporty. Wersja przez refleksję nigdy nie
        // odwołuje się do typu BusinessDataSource w kodzie źródłowym (tylko
        // przez object), więc kompilator nie musi rozwiązywać jego klasy
        // bazowej. Patrz ZestawienieKomisjaSocjalna.md, sekcja „Błąd
        // DataComponentBase przy wywołaniu z Pulpitu”.
        private void UstawDaneRaportu(object dane)
        {
            object zrodlo = DxReportHelpers.GetDataSourceEmpty(this);
            if (zrodlo == null)
                return;
            var wlasciwosc = zrodlo.GetType().GetProperty("CustomDataSource");
            if (wlasciwosc != null)
                wlasciwosc.SetValue(zrodlo, dane, null);
        }

        [DxBind(Name = "Report")]
        private void ZestawienieKomisjaSocjalna_BeforePrint(object sender, CancelEventArgs e)
        {
            string etap = "start";
            try
            {
                etap = "sprawdzenie trybu (designer)";
                if (pars == null)
                {
                    UstawDaneRaportu(new List<Wiersz>());
                    return;
                }

                etap = "pobranie kontekstu";
                Context dc = pars.Context;
                if (dc == null)
                {
                    UstawDaneRaportu(new List<Wiersz>());
                    return;
                }

                etap = "ustalenie okien czasowych sum";
                Date dataOdniesienia = pars.DataPosiedzenia != Date.Empty ? pars.DataPosiedzenia : Date.Today;
                int rok = dataOdniesienia.Year;
                // Okna sum to całe lata kalendarzowe; rok R = rok daty posiedzenia jest pominięty.
                Date odBiezace = new Date(rok - 2, 1, 1);        // lata R-2, R-1
                Date doBiezace = new Date(rok - 1, 12, 31);
                Date odPoprzednie = new Date(rok - 4, 1, 1);     // lata R-4, R-3
                Date doPoprzednie = new Date(rok - 3, 12, 31);

                etap = "zbieranie pracowników wg posiedzenia";
                var pracownicy = new List<Pracownik>();
                if (pars.TylkoZaznaczeni)
                {
                    // Tylko świadczenia zaznaczone na liście - bez sprawdzania cechy,
                    // ufamy zaznaczeniu operatora.
                    Row[] rows = dc[typeof(Row[])] as Row[];
                    if (rows == null)
                    {
                        UstawDaneRaportu(new List<Wiersz>());
                        return;
                    }
                    foreach (Row row in rows)
                    {
                        SwiadczSocjalne sw = row as SwiadczSocjalne;
                        Pracownik p = sw != null ? sw.Pracownik : null;
                        if (p != null && !pracownicy.Contains(p))
                            pracownicy.Add(p);
                    }
                }
                else
                {
                    // Domyślnie: skan WSZYSTKICH świadczeń socjalnych i zebranie
                    // każdego pracownika, którego świadczenie ma cechę
                    // "PosiedzenieKomisji" równą dacie posiedzenia (dopasowanie
                    // dokładne, nie oknem) - niezależnie od zaznaczenia i filtra
                    // listy (łapie też zwolnionych).
                    pracownicy = ZbierzPracownikowPosiedzenia(dc.Session, dataOdniesienia);
                }

                etap = "sortowanie listy pracowników";
                pracownicy.Sort((a, b) => string.Compare(a.ToString(), b.ToString(), StringComparison.CurrentCulture));

                etap = "budowanie wierszy";
                var wiersze = new List<Wiersz>();
                int lp = 1;
                foreach (Pracownik pracownik in pracownicy)
                {
                    Pracownik pr = pracownik;
                    try
                    {
                        DodajWierszePracownika(wiersze, ref lp, pr, dataOdniesienia,
                            odBiezace, doBiezace, odPoprzednie, doPoprzednie);
                    }
                    catch (Exception ex)
                    {
                        Wiersz blad = NowyWiersz();
                        blad.Lp = (lp++).ToString();
                        blad.NrEwid = Bezpiecznie(() => pr.Kod);
                        blad.NazwiskoImie = "[BŁĄD: " + ex.Message + "]";
                        wiersze.Add(blad);
                    }
                }

                etap = "ustawienie CustomDataSource";
                UstawDaneRaportu(wiersze);
            }
            catch (Exception ex)
            {
                string opis = "ETAP=" + (etap ?? "(null)")
                    + " | TYP=" + ex.GetType().FullName
                    + " | KOMUNIKAT=" + ex.Message;
                UstawDaneRaportu(new List<Wiersz> {
                    new Wiersz {
                        Lp = "BŁĄD",
                        NazwiskoImie = opis
                    }
                });
            }
        }

        // Buduje grupę wierszy dla jednego pracownika (1..N wierszy).
        static void DodajWierszePracownika(List<Wiersz> wiersze, ref int lp, Pracownik pr,
            Date dataOdniesienia, Date odBiezace, Date doBiezace, Date odPoprzednie, Date doPoprzednie)
        {
            List<ZapomogaPozycja> biezace = ZapomogiWOknie(pr, odBiezace, doBiezace);
            List<ZapomogaPozycja> poprzednie = ZapomogiWOknie(pr, odPoprzednie, doPoprzednie);

            // Pracownik bez żadnej zapomogi w obu oknach - pomijamy (bez wiersza,
            // bez zużycia numeru Lp).
            if (biezace.Count == 0 && poprzednie.Count == 0)
                return;

            decimal sumaBiezace = 0m;
            foreach (ZapomogaPozycja z in biezace) sumaBiezace += z.Kwota;
            decimal sumaPoprzednie = 0m;
            foreach (ZapomogaPozycja z in poprzednie) sumaPoprzednie += z.Kwota;

            int ile = biezace.Count > poprzednie.Count ? biezace.Count : poprzednie.Count;

            for (int i = 0; i < ile; i++)
            {
                Wiersz w = NowyWiersz();

                if (i == 0)
                {
                    w.Lp = (lp++).ToString();
                    w.NrEwid = Bezpiecznie(() => pr.Kod);
                    w.NazwiskoImie = Bezpiecznie(() => pr.NazwiskoImię.ToString());
                    w.DataUrodzenia = Bezpiecznie(() => pr.Historia[Date.Today].Urodzony.Data.ToString());
                    w.JednostkaObslugujaca = Bezpiecznie(() => PobierzJednostkeObslugujaca(pr));
                    w.DochodNaCzlonkaRodziny = Bezpiecznie(() => PobierzDochodNaCzlonkaRodziny(pr, dataOdniesienia));
                    // Kwota 0 jest wynikiem poprawnym (świadczenie przyznane w
                    // kwocie 0) - suma pokazuje się zawsze, gdy w oknie jest choć
                    // jedna zapomoga; pusta komórka = brak zapomogi w oknie.
                    w.KwotaZapomogiZ2Lat = biezace.Count > 0 ? sumaBiezace.ToString("N2") : "";
                    w.KwotaZapomogPoprzednich2Lat = poprzednie.Count > 0 ? sumaPoprzednie.ToString("N2") : "";
                }

                if (i < biezace.Count)
                {
                    w.DataWyplaty = biezace[i].Data.ToString();
                    w.KwotaWyplaty = biezace[i].Kwota.ToString("N2");
                }
                if (i < poprzednie.Count)
                {
                    w.DataWyplatyPoprzedniej = poprzednie[i].Data.ToString();
                    w.KwotaWyplatyPoprzedniej = poprzednie[i].Kwota.ToString("N2");
                }

                wiersze.Add(w);
            }
        }

        static string Bezpiecznie(Func<string> policz)
        {
            try
            {
                return policz() ?? "";
            }
            catch (Exception ex)
            {
                return "[BŁĄD: " + ex.Message + "]";
            }
        }

        // Cecha "Jednostka obsługująca" z Wydziału bieżącego etatu pracownika.
        // Cecha jest typu "element słownika" - jej wartością jest rekord
        // Soneta.Ksiega.ElemSlownika. Czytamy ją nietypowanym indeksatorem
        // Features["..."], rzutujemy na ElemSlownika i bierzemy .Nazwa.
        // Nazwa cechy to dokładnie "Jednostka obsługująca" (ze spacją).
        static string PobierzJednostkeObslugujaca(Pracownik pracownik)
        {
            PracHistoria biezaca = null;
            foreach (PracHistoria ph in pracownik.Historia.GetIntersectedRows(new FromTo(Date.Today, Date.Today)))
                biezaca = ph;
            if (biezaca == null)
                biezaca = pracownik.Historia[Date.Today];

            var wydzial = biezaca != null && biezaca.Etat != null ? biezaca.Etat.Wydzial : null;
            if (wydzial == null)
                return "";

            ElemSlownika elem = (ElemSlownika) wydzial.Features["Jednostka obsługująca"];
            return elem != null ? elem.Nazwa : "brak";
        }

        // Dochód na członka rodziny z aktualnego, zatwierdzonego wniosku ZFŚS
        // pracownika (krotka "A1_ZFSS" z dodatku AltOne.Skanska.Workflow).
        //
        // Odwzorowuje worker
        // AltOne.Skanska.Workflow.Workers.Wyliczane.WniosekZFFSPracownikaWorker
        // (property GetProgDochodu), którego w wydruku nie da się zbindować przez
        // {Workers.WniosekZFFSPracownika.GetProgDochodu} - to bindowanie działa
        // tylko na liście pracowników z parametrami wniosków ZFŚS (WnioskiZFSSParams).
        // Tutaj wołamy publiczne API dodatku bezpośrednio:
        //   - wniosek: PracownikExt.GetAktualnyWniosekZFSS(pracownik,
        //     <wnioski nie później niż = data posiedzenia>, <rok = rok posiedzenia>) -
        //     bierze ostatni zatwierdzony wniosek A1_ZFSS z okresem od 1 stycznia;
        //   - RodzajWskazywaniaDochodu == "Kwota" -> kwota dochodu na członka
        //     rodziny; w przeciwnym razie nazwa progu dochodowego (element słownika);
        //   - brak roli widoczności kwot u operatora -> "(Brak praw do widoku)".
        static string PobierzDochodNaCzlonkaRodziny(Pracownik pracownik, Date dataOdniesienia)
        {
            A1ZfssTuple wniosek = PracownikExt.GetAktualnyWniosekZFSS(pracownik, dataOdniesienia, dataOdniesienia.Year);
            if (wniosek == null)
                return "";
            if (!wniosek.CzyPrawaDoWidokuProgow())
                return "(Brak praw do widoku)";
            if (wniosek._RodzajWskazywaniaDochodu == "Kwota")
                return wniosek._KwotaDochoduNaCzlonkaRodziny.ToString();
            return wniosek._ProgDochodu != null ? wniosek._ProgDochodu.ToString() : "";
        }

        // Zbiera pracowników, których choć jedno (niewystornowane - tu: każde,
        // świadczenia nie mają stornowania jak WypElement) świadczenie typu
        // "zapomoga" ma cechę "PosiedzenieKomisji" (Data) równą dacie posiedzenia
        // z parametru. Skanuje CAŁĄ tabelę świadczeń socjalnych
        // (session.GetKadry().SwiadczeniaSoc) - łapie też pracowników
        // zwolnionych / spoza bieżącego filtra listy. Cecha może nie być
        // ustawiona na części świadczeń (starsze wpisy) - traktowane jak brak
        // dopasowania, nie błąd.
        static List<Pracownik> ZbierzPracownikowPosiedzenia(Session session, Date dataPosiedzenia)
        {
            var pracownicy = new List<Pracownik>();
            foreach (SwiadczSocjalne sw in session.GetKadry().SwiadczeniaSoc)
            {
                if (!CzyZapomoga(sw))
                    continue;

                object wartoscCechy = sw.Features["PosiedzenieKomisji"];
                if (!(wartoscCechy is Date))
                    continue;
                Date dataKomisji = (Date) wartoscCechy;
                if (dataKomisji != dataPosiedzenia)
                    continue;

                Pracownik p = sw.Pracownik;
                if (p != null && !pracownicy.Contains(p))
                    pracownicy.Add(p);
            }
            return pracownicy;
        }

        // Lista pojedynczych zapomóg pracownika przyznanych w oknie [od, doDaty]
        // (wg SwiadczSocjalne.Data = data przyznania świadczenia), posortowana
        // rosnąco po dacie. Zapomoga = świadczenie socjalne, którego Definicja
        // (rodzaj świadczenia) ma w nazwie "zapomog(a)". Źródło:
        // pracownik.Swiadczenia (SubTable<SwiadczSocjalne>) - kolekcja
        // świadczeń TEGO pracownika, więc skan jest tani (nie iterujemy całej
        // firmy).
        static List<ZapomogaPozycja> ZapomogiWOknie(Pracownik pracownik, Date od, Date doDaty)
        {
            var lista = new List<ZapomogaPozycja>();
            if (doDaty < od)
                return lista;

            foreach (SwiadczSocjalne sw in pracownik.Swiadczenia)
            {
                if (!CzyZapomoga(sw))
                    continue;
                Date data = sw.Data;
                if (data < od || data > doDaty)
                    continue;

                ZapomogaPozycja poz = new ZapomogaPozycja();
                poz.Data = data;
                poz.Kwota = sw.Rozliczenie.Kwota.Value;
                lista.Add(poz);
            }

            lista.Sort((a, b) => a.Data > b.Data ? 1 : (a.Data < b.Data ? -1 : 0));
            return lista;
        }

        // Świadczenie socjalne jest "zapomogą", jeśli nazwa jego Definicji
        // (rodzaj świadczenia, słownik DefSwiadczSocjal) zawiera "zapomog"/
        // "zapomóg" - odróżnia zapomogi od innych rodzajów świadczeń socjalnych
        // (np. "Dopłata do wypoczynku", "Paczka"), które mimo bycia tym samym
        // obiektem SwiadczSocjalne nie powinny wchodzić do tego zestawienia.
        static bool CzyZapomoga(SwiadczSocjalne sw)
        {
            return sw.Definicja != null && NazwaZapomoga(sw.Definicja.Nazwa);
        }

        static bool NazwaZapomoga(string nazwa)
        {
            if (string.IsNullOrEmpty(nazwa))
                return false;
            string n = nazwa.ToLowerInvariant();
            return n.Contains("zapomog") || n.Contains("zapomóg");
        }

        static Wiersz NowyWiersz()
        {
            return new Wiersz {
                Lp = "",
                NrEwid = "",
                NazwiskoImie = "",
                DataUrodzenia = "",
                JednostkaObslugujaca = "",
                DochodNaCzlonkaRodziny = "",
                KwotaZapomogiZ2Lat = "",
                DataWyplaty = "",
                KwotaWyplaty = "",
                KwotaZapomogPoprzednich2Lat = "",
                DataWyplatyPoprzedniej = "",
                KwotaWyplatyPoprzedniej = ""
            };
        }

        class ZapomogaPozycja
        {
            public Date Data;
            public decimal Kwota;
        }

        public class Wiersz
        {
            public string Lp { get; set; }
            public string NrEwid { get; set; }
            public string NazwiskoImie { get; set; }
            public string DataUrodzenia { get; set; }
            public string JednostkaObslugujaca { get; set; }
            public string DochodNaCzlonkaRodziny { get; set; }
            public string KwotaZapomogiZ2Lat { get; set; }
            public string DataWyplaty { get; set; }
            public string KwotaWyplaty { get; set; }
            public string KwotaZapomogPoprzednich2Lat { get; set; }
