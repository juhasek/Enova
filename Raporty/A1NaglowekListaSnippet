using System.ComponentModel;
using DevExpress.XtraReports.UI;
using Soneta.Core;      // OddzialFirmy, IPieczątkaFirmy
using Soneta.Kadry;     // Pracownik, PracHistoria, Wydzial, Etat
using Soneta.Tools;     // TranslateFormat
using Soneta.Types;     // Date

namespace Soneta.Business.UI.DxReports {

    // Wzorzec użytkownika "nagłówek - lista" (A1NaglowekListaSnippet) — modyfikacja
    // standardowego Soneta.Business.UI.DxReports.NaglowekListaSnippet.
    //
    // CEL ZMIANY: na listach kadrowych pieczątka w nagłówku ma pochodzić z ODDZIAŁU
    // PRACOWNIKA z bieżącego wiersza wydruku (wg jego wydziału), a nie z Firmy głównej
    // ani z oddziału operatora. Standardowy ReportTools.GetHeaderData tego nie robi,
    // bo Pracownik/PracHistoria nie implementują IElementStrukturyFirmy/IOddzialProvider,
    // więc DxReportService.GetDepartmentFromDataContext zwraca dla nich null.
    //
    // JAK: w Report_DataSourceRowChanged bierzemy bieżący rekord (Report.DataAdapter),
    // z niego wydział (PracHistoria.Etat.Wydzial), z wydziału oddział
    // (Wydzial.WyliczOddzial() — idzie w górę drzewa wydziałów aż do przypiętego
    // oddziału), a z oddziału pieczątkę (OddzialFirmy.GetPieczątka(data) — sama wchodzi
    // po oddziale NADRZĘDNYM, gdy bieżący oddział nie ma własnego numeru licencji, więc
    // dostajemy pieczątkę z oddziału, który tę licencję nosi).
    //
    // Zmiana jest ADDYTYWNA: gdy rekordu nie da się zmapować na pracownika/wydział/oddział
    // (np. lista niekadrowa), nagłówek zostaje wypełniony standardowo z GetHeaderData.
    //
    // UWAGA (baza demo): na bazie z licencją demonstracyjną GetPieczątka zawsze zwraca
    // "* DEMO * <nazwa oddziału>" — to normalne, potwierdza tylko, który oddział został
    // wyliczony. Realny test wymaga bazy z licencją klienta.
    public class NaglowekListaSnippet : ReportSnippet {

        [DxBind]
        private readonly XRLabel label_CompanyName;
        [DxBind]
        private readonly XRLabel label_ShortCompanyName;
        [DxBind]
        private readonly XRLabel label_Adress;
        [DxBind]
        private readonly XRLabel label_tin;
        [DxBind]
        private readonly XRLabel label_AccountingOfficeHeader;
        [DxBind]
        private readonly XRLabel label_AccountingOfficeName;
        [DxBind]
        private readonly XRLabel label_AccountingOfficeTin;
        [DxBind]
        private readonly XRLabel label_ShortAccountingOfficeName;

        private HeaderData headerData;

        // Jednorazowy odczyt danych firmy + wypełnienie nagłówka wartościami
        // standardowymi (fallback dla wydruków, które nie iterują po wierszach
        // albo których wiersza nie da się zmapować na pracownika).
        [DxBind]
        private void Report_BeforePrint(object sender, CancelEventArgs e) {
            if (headerData != null)
                return;

            headerData = ReportTools.GetHeaderData(Context);
            WypelnijZHeaderData();
        }

        // Odpala się na każdą zmianę rekordu danych (raz na pracownika). Najpierw
        // wartości standardowe, potem próba nadpisania pieczątką oddziału pracownika.
        [DxBind]
        private void Report_DataSourceRowChanged(object sender, DataSourceRowEventArgs e) {
            if (headerData == null)
                headerData = ReportTools.GetHeaderData(Context);

            WypelnijZHeaderData();

            PracHistoria ph = PobierzHistorie(Report.DataAdapter ?? GetCurrentRow());
            if (ph == null || ph.Etat == null)
                return;

            Wydzial wydzial = ph.Etat.Wydzial;
            if (wydzial == null)
                return;

            // Oddział wyliczony z wydziału pracownika (w górę drzewa wydziałów).
            OddzialFirmy oddzial = wydzial.WyliczOddzial();
            if (oddzial == null)
                return;

            // GetPieczątka sam schodzi do oddziału nadrzędnego, który nosi licencję.
            IPieczątkaFirmy p;
            try {
                p = oddzial.GetPieczątka(Date.Today);   // dla wersji "na datę" można podać ph.Do
            } catch {
                return;   // np. licencja oddziału nadrzędnego niewczytana/niezgodna — zostaje pieczątka standardowa
            }
            if (p == null || string.IsNullOrEmpty(p.Nazwa))
                return;

            label_CompanyName.Text = p.NazwaFormatowana;
            label_ShortCompanyName.Text = p.NazwaSkrócona;
            label_Adress.Text = p.Adres.Linia1 + System.Environment.NewLine + p.Adres.Linia2;
            label_tin.Text = "NIP: {0}".TranslateFormat(p.NIP);
        }

        private void WypelnijZHeaderData() {
            if (headerData == null)
                return;

            label_CompanyName.Text = headerData.CompanyName;
            label_ShortCompanyName.Text = headerData.ShortCompanyName;
            label_Adress.Text = headerData.AddressLine1 + System.Environment.NewLine + headerData.AddressLine2;
            label_tin.Text = "NIP: {0}".TranslateFormat(headerData.CompanyTIN);

            if (!string.IsNullOrEmpty(headerData.AccountingOfficeName)) {
                label_AccountingOfficeHeader.Text = headerData.AccountingOfficeHeader;
                label_AccountingOfficeName.Text = headerData.AccountingOfficeName;
                label_AccountingOfficeTin.Text = "NIP: {0}".TranslateFormat(headerData.AccountingOfficeTIN);
                label_ShortAccountingOfficeName.Text = headerData.ShortAccountingOfficeName;
            }
        }

        private static PracHistoria PobierzHistorie(object row) {
            if (row is Pracownik prac)
                return prac.Last;                 // ostatni zapis historii zatrudnienia
            if (row is PracHistoria ph)
                return ph;
            return null;
        }

        [DxBind]
        private void subband_FirstPage_BeforePrint(object sender, CancelEventArgs e) => e.Cancel = !XtraReportHelper.IsFirstHeader(Report);

        [DxBind]
        private void subband_NextPage_BeforePrint(object sender, CancelEventArgs e) => e.Cancel = XtraReportHelper.IsFirstHeader(Report);
    }
}
