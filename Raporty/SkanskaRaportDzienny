        private bool ShouldIncludeWorker(Pracownik worker)
        {
            Periods okresyZatrudnienia = Periods.Empty;

            foreach (PracHistoria ph in worker.Historia.GetIntersectedRows(pars.Miesiąc.ToFromTo()))
            {
                if (ph.Etat.EfektywnyOkres != FromTo.Empty &&
                    ph.Etat.EfektywnyOkres.From != Date.Empty &&
                    ph.Etat.EfektywnyOkres.To != Date.Empty)
                {
                    okresyZatrudnienia += ph.Etat.EfektywnyOkres;
                }
            }

            okresyZatrudnienia *= pars.Miesiąc.ToFromTo();
            okresyZatrudnienia = okresyZatrudnienia.ToFlat();

            if (okresyZatrudnienia == Periods.Empty)
            {
                return false;
            }

            CzasDni cd = worker.Czasy.KalkPlanu.Norma(okresyZatrudnienia);
            if (cd.Dni == 0 && cd.Czas.TotalHours == 0)
            {
                return false;
            }

            return true;
        }

