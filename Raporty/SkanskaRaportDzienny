            string line1 = "Imię i nazwisko: ".Translate() + pracownik.ImięNazwisko + "\\b0, stanowisko pracy: ".Translate() +
                           GetStanowisko(historia);
            string line2 = "Normatywny czas pracy w dniach: ".Translate() + cd.Dni.ToString() + "\\b0, w godzinach: ".Translate() +
                           cd.Czas.ToString();
            SzablonNagłówkaStrony.FiltersDescription = new string[] { line1, line2 };
        }

