        [DxBind]
        private void Grid1ListaWiersz_BeforePrint(object sender, CancelEventArgs e)
        {
            Linia linia = (Linia)Grid1Lista.GetCurrentRow();

            if (linia == null) return;

            colNadlicz.Text = string.Empty;

            try
            {
                Log log = new Log("Linia Raport dzienny", true);
                Date data = linia.DzienM;
                colDM.Text = data.ToString();
                if (!okresy_zatrudnienia.Contains(data))
                {
                    // Komórki tabeli są tymi samymi obiektami UI używanymi dla
                    // wszystkich wierszy - bez jawnego wyczyszczenia dzień spoza
                    // okresu zatrudnienia (np. po zwolnieniu pracownika) pokazywał
                    // Harmonogram/Nieobecność itd. przepisane z ostatniego
                    // wydrukowanego dnia, w którym pracownik był jeszcze zatrudniony.
                    Harmonogram.Text = colOd.Text = colDo.Text = colNocne.Text = colNieob.Text =
                        pracazdalna.Text = DodatekBryg.Text = DaneProj.Text = DaneAC.Text = tableCellSC.Text = "";
                    return;
                }

                Dzien dzień = kalkulator[data];

                pracazdalna.Text = DodatekBryg.Text = tableCellSC.Text = DaneAC.Text = colNocne.Text = DaneProj.Text = colNieob.Text = "";

                if (dzień.Czas == Time.Zero && linia.Strefa == null)
                {
                    colOd.Text = colDo.Text = colNocne.Text = "";
                }
                else
                {
                    if (linia.Strefa == null)
                    {
                        log.WriteLine($"brak liniStrefy");
                        colOd.Text = dzień.OdGodziny == Time.Zero ? "" : dzień.OdGodziny.ToString("+", System.Globalization.CultureInfo.InvariantCulture);
                        var doGodziny = Dzien.DoGodziny(dzień);
                        colDo.Text = doGodziny == Time.Zero ? "" : Dzien.DoGodziny(dzień).ToString("+", System.Globalization.CultureInfo.InvariantCulture);
                        // Kolumna "Godziny nocne" wypełniana jest niżej z linia.NocWiersza.
                    }
                    else
                    {
                        // Kolumny "Godz. pracy od/do" mają pokazywać przedział konkretnej
                        // strefy tego wiersza, a nie zagregowany przedział całego dnia -
                        // inaczej każdy wiersz strefy tego samego dnia (np. praca w normie
                        // i nadgodziny) pokazywał identyczne "od-do" całego dnia.
                        colOd.Text = linia.Strefa.OdGodziny == Time.Zero ? "" : linia.Strefa.OdGodziny.ToString("+", System.Globalization.CultureInfo.InvariantCulture);
                        Time strefaDoGodziny = linia.DoGodzinyLaczna;

                        if (colOd.Text == "")
                            colDo.Text = "";
                        else
                            colDo.Text = strefaDoGodziny == Time.Zero ? "" : strefaDoGodziny.ToString("+", System.Globalization.CultureInfo.InvariantCulture);

                        // Kolumna "Godziny nocne" wypełniana jest niżej z linia.NocWiersza
                        // (część nocna przypadająca na ten wiersz).

                        DodatekBryg.Text = linia.Strefa.Features.GetBool("DodatekBryg") ? "TAK" : "";
                        ElemSlownika elProj = (ElemSlownika)linia.Strefa.Features["Projekt"];
                        if (elProj != null)
                        {
                            DaneProj.Text = elProj.Symbol;
                        }

                        ElemSlownika elAC = (ElemSlownika)linia.Strefa.Features["Task"];
                        if (elAC != null)
                        {
                            DaneAC.Text = elAC.Symbol;
                        }

                        ElemSlownika elEXP = (ElemSlownika)linia.Strefa.Features["Expenditure_organization"];
                        if (elEXP != null)
                        {
                            tableCellSC.Text = elEXP.Symbol;
                        }

                        if (JestStrefaZdalna(linia.Strefa.Definicja.Nazwa))
                            pracazdalna.Text = "TAK";
                    }
                }

                // Godziny nocne - część nocna przypadająca na TEN wiersz
                // (policzona w detailReportBand1_BeforePrint / NocWiersza).
                // Suma po wszystkich wierszach = podsumowanie RazemNoc.
                colNocne.Text = linia.NocWiersza == Time.Zero ? "" : linia.NocWiersza.ToString();

                if (kalkulator.Plan[data].Czas == Time.Zero)
                    Harmonogram.Text = "";
                else
                {
                    string HOd = kalkulatorPlanu[data].OdGodziny.ToString();
                    Time doGodz = (kalkulatorPlanu[data].OdGodziny + kalkulatorPlanu[data].Czas);
                    string HDo = doGodz.ToString();

                    if (doGodz >= new Time(24, 0))
                        HDo = "+" + (doGodz - new Time(24, 0)).ToString();

                    Harmonogram.Text = $"{HOd} - {HDo} ";
                }

                czas += dzień.Czas;

                BusinessDataSource dc = (BusinessDataSource)this.DataSource;
                var rozliczenieNadgodzinFirma = PracaWStrefie(dzień,
                    KalendModule.GetInstance(dc.Context.Session).DefinicjeStref
                        .WgNazwy["Rozliczenie nadgodzin (firma)".TranslateIgnore()], true);
                var rozliczenieNadgodzinPrac = PracaWStrefie(dzień,
                    KalendModule.GetInstance(dc.Context.Session).DefinicjeStref
                        .WgNazwy["Rozliczenie nadgodzin (prac)".TranslateIgnore()], true);
                Time przerwaK = PracaWStrefie(dzień,
                    KalendModule.GetInstance(dc.Context.Session).DefinicjeStref
                        .WgNazwy["Przerwa na karmienie".TranslateIgnore()], false);
                karmienie += przerwaK;

                FromTo okres = new FromTo(data, data);
                ZestawienieNadgodzin zn = nadgodziny.Nadgodziny(okres);

                if (linia.Strefa != null && strefynadgodzin.Contains(linia.Strefa.Definicja.Nazwa))
                {
                    if (pars.Miesiąc < new YearMonth(2026, 8))
                    {
                        colNadlicz.Text = (zn.N50 + zn.N100 + zn.NSW) == Time.Zero
                            ? ""
                            : (zn.N50 + zn.N100 + zn.NSW).ToString();
                        nadlicz += (zn.N50 + zn.N100 + zn.NSW);
                    }
                    else
                    {
                        // Nadgodziny tego wiersza liczymy z czasu WŁASNEGO wiersza
                        // (linia.CzasLaczny - suma Czas zapisów scalonych w ten wiersz,
                        // patrz detailReportBand1_BeforePrint), a nie z sumy strefy
                        // "Praca poza normą" dla CAŁEGO dnia (jak wcześniej przez
                        // PracaWStrefie(dzień, ...)). Użycie sumy dnia powodowało, że przy
                        // kilku odrębnych zapisach nadgodzin tego samego dnia (np. 1h i 2h)
                        // każdy wiersz pokazywał ten sam dzienny sumaryczny wynik (3h)
                        // zamiast własnej wartości, a nadlicz (i w efekcie RazemNad)
                        // sumowało dzienny wynik po razie na każdy taki wiersz.
                        colNadlicz.Text += linia.CzasLaczny.ToString();
                        nadlicz += linia.CzasLaczny;
                    }

                    RazemNad.Text = nadlicz.ToString();
                }

                switch (dzień.Definicja.Typ)
                {
                    case TypDnia.Świąteczny:
                        swieta += dzień.Czas;
                        break;
                    case TypDnia.Wolny:
                        wolne += dzień.Czas;
                        break;
                }

                Time colUwDoba = Time.Zero;
                Time colUwdDoba = Time.Zero;
                Time colUOpDoba = Time.Zero;

                Time czasNie = Time.Zero;
                if (kolumna != null) kolumna.Text = "";
                foreach (INieobecnosc nie in kalkulator.Nieobecnosci(FromTo.Day(data), true))
                {
                    Nieobecnosc nieobecność = (Nieobecnosc)((OkresNieobecności)nie);
                    if (nieobecność != null && nieobecność.Definicja.Typ != TypNieobecnosci.Storno)
                    {
                        colNieob.Text = nieobecność.Definicja.Nazwa;
                    }
                }

                // Odbiór nadgodzin (strefa "Rozliczenie nadgodzin (prac)"/"(firma)")
                // dopisujemy do kolumny Nieobecność razem z liczbą odebranych
                // nadgodzin - CzasRozliczanyLaczny to suma WŁASNA tego wiersza
                // (patrz detailReportBand1_BeforePrint), nie dzienna suma z
                // PracaWStrefie, żeby uniknąć powielania wartości między wierszami.
                if (linia.Strefa != null && JestStrefaOdbioruNadgodzin(linia.Strefa.Definicja.Nazwa))
                {
                    string wpisOdbioru = "Odbiór nadgodzin " + linia.CzasRozliczanyLaczny.ToString();
                    colNieob.Text = string.IsNullOrEmpty(colNieob.Text)
                        ? wpisOdbioru
                        : colNieob.Text + ", " + wpisOdbioru;
                }
            }
            catch (Soneta.Kalend.KalkulatorPracy.ZestPracyException ex)
            {
                throw new RowException(ex, kalkulator.Pracownik,
                    "Próba wykonania raportu dla pracownika rozliczanego wg zestawień czasu pracy.".Translate());
            }
        }

        static Time CzasPrzestoju(Dzien dzień)
        {
            bool any = false;
            Time result = Time.Zero;
            foreach (Dzien.Strefa s in dzień)
                if (s.Definicja.Przestój)
                {
                    result += s.Czas;
                    any = true;
                }

            return any ? result : Time.Empty;
        }

        [TranslateIgnore]
        Time PracaWStrefie(Dzien dzień, DefinicjaStrefy def, bool czasRozliczany)
        {
            if (def == null)
                return Time.Empty;

            bool any = false;
            Time result = Time.Zero;
            foreach (Dzien.Strefa s in dzień)
                if (s.Definicja == def)
                {
                    if (czasRozliczany)
                    {
                        var strefaPracy = s.Bazowa as StrefaPracy;
                        if (strefaPracy != null)
                        {
                            result += strefaPracy.CzasRozliczanyWyliczony;

                            if (s.Definicja.ToString() == "Rozliczenie nadgodzin (firma)" ||
                                s.Definicja.ToString() == "Rozliczenie nadgodzin (prac)")
                                nadZP += strefaPracy.CzasRozliczanyWyliczony;
                        }
                    }
                    else
                    {
                        if (s.Definicja.ToString() == "Nadgodziny do przeniesienia") nadDoP += s.Czas;
                        result += s.Czas;
                    }
                    any = true;
                }

            return any ? result : Time.Empty;
        }

        [DxBind]
        private void detailReportBand1_BeforePrint(object sender, CancelEventArgs e)
        {
            BusinessDataSource dc = (BusinessDataSource)this.DataSource;
            Log log = new Log("Raport dzienny", true);
            Pracownik pracownik = (Pracownik)this.GetCurrentRow();
            if (pracownik == null)
                return;

            // Reset akumulatorów czasu na potrzeby KAŻDEGO pracownika z osobna.
            // Pola te (czas, nocne, nadlicz, karmienie, nadZP, nadDoP, swieta, wolne, ...)
            // są polami instancji raportu, a raport jest jedną instancją dla wszystkich
            // wydrukowanych pracowników - bez resetu ich wartości sumowały się między
            // kolejnymi pracownikami (np. RazemNad pokazywał u drugiego pracownika sumę
            // jego nadgodzin i nadgodzin poprzedniego pracownika).
            czas = czasPrzestoju = swieta = wolne = nocne = nadlicz = uw = uwd = uok = uop =
                usz = ub = ch = op = wych = nu = nn = nad50 = nad100 = karmienie = dp = dd =
                pbez = nadZP = nadDoP = Time.Zero;

            // RazemNad.Text jest ustawiane dopiero w Grid1ListaWiersz_BeforePrint, i to tylko
            // gdy trafi się dzień ze strefą nadgodzin. Jeśli pracownik w danym miesiącu nie ma
            // ani jednej takiej strefy, to przypisanie nigdy się nie wykona i komórka zostaje
            // z tekstem wydrukowanym dla POPRZEDNIEGO pracownika. Dlatego jawnie zerujemy ją
            // tutaj, zanim zaczną się drukować wiersze dni bieżącego pracownika.
            RazemNad.Text = nadlicz.ToString();

            okresy_zatrudnienia = Periods.Empty;
            foreach (PracHistoria ph in pracownik.Historia.GetIntersectedRows(pars.Miesiąc.ToFromTo()))
                if (ph.Etat.EfektywnyOkres != FromTo.Empty)
                    okresy_zatrudnienia += ph.Etat.EfektywnyOkres;
            okresy_zatrudnienia *= pars.Miesiąc.ToFromTo();
            okresy_zatrudnienia = okresy_zatrudnienia.ToFlat();

            tableCell1.Text = $"{pracownik.Kod} {pracownik.ImięNazwisko}";

            PracHistoria historia =
                pracownik[okresy_zatrudnienia == Periods.Empty ? pars.Miesiąc.LastDay : okresy_zatrudnienia.To];
            CzasDni cd = pracownik.Czasy.KalkPlanu.Norma(okresy_zatrudnienia);
            RazemNom.Text = cd.Czas.ToString();
            CzasDni cdpracy = pracownik.Czasy.KalkPracy.Praca(okresy_zatrudnienia);
            RazemGod.Text = cdpracy.Czas.ToString();
            kalkulator = pracownik.Czasy.KalkPracy;
            nadgodziny = new KalkulatorNadgodzin(kalkulator);
            kalkulatorPlanu = pracownik.Czasy.KalkPlanu;

            kalkulator.LoadOkres(pars.Miesiąc.ToFromTo());

            Time n50 = Time.Zero;
            Time n100 = Time.Zero;

            foreach (FromTo oz in okresy_zatrudnienia)
            {
                ZestawienieNadgodzin zn = nadgodziny.Nadgodziny(oz);
                n50 += zn.N50;
                n100 += zn.N100 + zn.NSW;
            }

            nadgodziny.TrybRozliczania = KalkulatorNadgodzin.TrybRozliczaniaNadgodzin.TylkoDobowe;

            List<Linia> linie = new List<Linia>();
            linie.Clear();

            for (int i = 0; i < pars.Miesiąc.Days; i++)
            {
                Date dataSpr = pars.Miesiąc.FirstDay + i;

                // rezygnujemy z podzielnika odczytywanego z danych kadrowych - zakłądamy ze
                // raport będzie drukowany dla osób które podzielnik mają na strefach

                DzienPracy dzienPracy = pracownik.DniPracy[dataSpr];

                if (dzienPracy == null)
                {
                    linie.Add(new Linia(dataSpr, pracownik));
                }
                else
                {
                    if (!dzienPracy.Strefy.Any)
                    {
                        linie.Add(new Linia(dataSpr, pracownik));
                    }
                    else
                    {
                        // Kilka zapisów strefy tego samego typu, z tym samym Projektem i
                        // Taskiem (np. dwa zapisy "Praca poza normą" 15:00-16:00 i
                        // 16:00-18:00), traktujemy jako jeden ciągły wpis w karcie - inaczej
                        // ten sam dzień drukował kilka wierszy wyglądających na zdublowane.
                        // Scalamy jednak TYLKO gdy zapisy się stykają/nakładają - jeśli
                        // między nimi jest przerwa (np. "Praca poza normą" 15:00-17:00
                        // oraz 29:00-31:00, czyli 5:00-7:00 następnego dnia), zostają
                        // osobnymi wierszami, bo pracownik w przerwie nie pracował.
                        foreach (var strefa in dzienPracy.Strefy
                            .Where(s => strefyraportu.Contains(s.Definicja.Nazwa) || JestStrefaZdalna(s.Definicja.Nazwa) || JestStrefaOdbioruNadgodzin(s.Definicja.Nazwa))
                            .OrderBy(s => s.OdGodziny))
                        {
                            string projektSym = GetFeatureSymbol(strefa, "Projekt");
                            string taskSym = GetFeatureSymbol(strefa, "Task");

                            Linia poprzednia = linie.Count > 0 ? linie[linie.Count - 1] : null;
                            bool mozeScalic = poprzednia != null && poprzednia.DzienM == dataSpr &&
                                poprzednia.Strefa != null &&
                                poprzednia.Strefa.Definicja.Nazwa == strefa.Definicja.Nazwa &&
                                GetFeatureSymbol(poprzednia.Strefa, "Projekt") == projektSym &&
                                GetFeatureSymbol(poprzednia.Strefa, "Task") == taskSym &&
                                strefa.OdGodziny != Time.Empty &&
                                strefa.OdGodziny <= poprzednia.DoGodzinyLaczna;

                            if (mozeScalic)
                            {
                                poprzednia.DoGodzinyLaczna = Time.Max(poprzednia.DoGodzinyLaczna, strefa.OdGodziny + strefa.Czas);
                                poprzednia.CzasLaczny += strefa.Czas;
                                poprzednia.CzasRozliczanyLaczny += strefa.CzasRozliczanyWyliczony;
                            }
                            else
                            {
                                linie.Add(new Linia(dataSpr, strefa, pracownik));
                            }
                        }
                    }
                }
            }

            // Godziny nocne liczymy per wiersz (NocWiersza) - na obiekcie Linia,
            // po zbudowaniu i scaleniu wierszy, żeby wartość trafiła w ten wiersz,
            // którego dotyczy, i była odporna na ponowne drukowanie przy paginacji.
            // RazemNoc = suma tych wartości, więc kolumna zawsze zgadza się z
            // podsumowaniem.
            foreach (Linia l in linie)
            {
                if (!okresy_zatrudnienia.Contains(l.DzienM))
                    continue;
                l.NocWiersza = NocWiersza(pracownik, l);
                nocne += l.NocWiersza;
            }

            Grid1Lista.DataSource = linie;

            RazemNoc.Text = nocne.ToString();
        }

        public class Linia
        {
            public Linia(Date data, ElementPodzielnika elem, Pracownik prac)
            {
                this.DzienM = data;
                this.ElemPodz = elem;
                this.Prac = prac;
            }

            public Linia(Date data, Pracownik prac)
            {
                this.DzienM = data;
                this.Prac = prac;
            }

            public Linia(Date data, StrefaPracy strefa, Pracownik prac)
            {
                this.DzienM = data;
                this.Prac = prac;
                this.Strefa = strefa;
                this.DoGodzinyLaczna = strefa.OdGodziny + strefa.Czas;
                this.CzasLaczny = strefa.Czas;
                this.CzasRozliczanyLaczny = strefa.CzasRozliczanyWyliczony;
            }

            public StrefaPracy Strefa { get; set; }
            public Date DzienM { get; set; }
            public ElementPodzielnika ElemPodz { get; set; }
            public Pracownik Prac { get; set; }

            // Godziny nocne przypadające na TEN wiersz (wg NocWiersza): ze strefy
            // "Praca w godzinach nocnych" jeśli dzień ją ma, inaczej z godzin
            // tego wiersza przeciętych z porą nocną. Suma po wierszach = RazemNoc.
            public Time NocWiersza { get; set; }

            // Łączna godzina zakończenia po ewentualnym scaleniu kilku zapisów strefy
            // o tym samym typie/Projekcie/Tasku w jeden wiersz karty (patrz
            // detailReportBand1_BeforePrint). Dla niescalonego wiersza to po prostu
            // koniec pojedynczej strefy (OdGodziny + Czas).
            public Time DoGodzinyLaczna { get; set; }

            // Suma Czas wszystkich zapisów strefy scalonych w ten wiersz (dla
            // niescalonego wiersza - Czas pojedynczej strefy). Używana do wyliczenia
            // nadgodzin WŁASNYCH tego wiersza zamiast sumy dziennej z PracaWStrefie.
            public Time CzasLaczny { get; set; }

            // Suma StrefaPracy.CzasRozliczanyWyliczony zapisów scalonych w ten wiersz
            // (dla niescalonego wiersza - wartość pojedynczej strefy). Dla stref
            // "Rozliczenie nadgodzin (prac/firma)" to liczba odebranych nadgodzin,
            // wyświetlana w kolumnie Nieobecność.
            public Time CzasRozliczanyLaczny { get; set; }
        }

        [TranslateIgnore]
        static string GetFeatureSymbol(StrefaPracy strefa, string nazwaCechy)
        {
            ElemSlownika elem = strefa.Features[nazwaCechy] as ElemSlownika;
            return elem?.Symbol;
        }

