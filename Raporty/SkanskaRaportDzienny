        // Przecięcie przedziału pracy [pracaOd, pracaDo] z oknem pory nocnej z
        // kalendarza. Okno pory nocnej enova zapisuje z końcem "po północy"
        // (np. 21:00-07:00 => Od=21:00, Do=31:00), a strefa pracy na nockę kończy
        // się po 24:00 (OdGodziny + Czas). Poprzednia wersja liczyła zwykłe
        // Max/Min i przy oknie przechodzącym przez północ dawała błędne wyniki.
        // Tutaj przecinamy przedział pracy z oknem dwukrotnie: wprost oraz
        // przesunięty o dobę do przodu - dzięki temu poranny fragment pracy
        // (np. 6:00-7:00, należący do pory nocnej z poprzedniej doby) też trafia
        // w okno.
        static Time PrzeciecieZPoraNocna(Time pracaOd, Time pracaDo, Time nocOd, Time nocDo)
        {
            if (pracaDo <= pracaOd || nocDo <= nocOd)
                return Time.Zero;

            Time doba = new Time(24, 0);
            Time wynik = Time.Zero;

            Time s1 = Time.Max(pracaOd, nocOd);
            Time e1 = Time.Min(pracaDo, nocDo);
            if (e1 > s1)
                wynik += e1 - s1;

            Time s2 = Time.Max(pracaOd + doba, nocOd);
            Time e2 = Time.Min(pracaDo + doba, nocDo);
            if (e2 > s2)
                wynik += e2 - s2;

            return wynik;
        }

        // Sygnatura zachowana - metoda bywała wykorzystywana w wyrażeniach układu
        // raportu. Deleguje do poprawnego PrzeciecieZPoraNocna.
        public static Time PoliczPoreNocna(Pracownik pracownik, Date data, Time godzinaRozpoczecia, Time godzinaZakonczenia)
        {
            Time nocOd = pracownik[data].Etat.Kalendarz.Nocne.Od;
            Time nocDo = pracownik[data].Etat.Kalendarz.Nocne.Do;
            return PrzeciecieZPoraNocna(godzinaRozpoczecia, godzinaZakonczenia, nocOd, nocDo);
        }

        static bool JestStrefaNocna(string nazwaStrefy) =>
            nazwaStrefy == "Praca w godzinach nocnych";

        // Czy w dniu jest jawna strefa "Praca w godzinach nocnych" (tak wchodziły
        // dane z migracji). Jeśli tak - noc bierzemy wprost z tej strefy, a nie
        // z przecięcia godzin pracy z porą nocną.
        static bool DzienMaStrefeNocna(DzienPracy dzienPracy)
        {
            if (dzienPracy == null || !dzienPracy.Strefy.Any)
                return false;
            foreach (var s in dzienPracy.Strefy)
                if (s.Definicja != null && JestStrefaNocna(s.Definicja.Nazwa))
                    return true;
            return false;
        }

        // Godziny nocne przypadające na KONKRETNY wiersz karty (Linia) wg reguły
        // uzgodnionej z użytkownikiem:
        //  1. dzień ma jawną strefę "Praca w godzinach nocnych" -> noc pokazuje
        //     się tylko na wierszach tej strefy, wprost z jej godzin
        //     (linia.CzasLaczny); pozostałe wiersze dnia = 0 (bez podwójnego
        //     liczenia);
        //  2. brak jawnej strefy nocnej -> noc = godziny tego wiersza (strefy
        //     zwiększającej czas pracy) przecięte z oknem pory nocnej;
        //  3. wiersz bez strefy (dzień bez stref) -> wartość z kalkulator.Nocne.
        // Suma NocWiersza po wszystkich wierszach = podsumowanie RazemNoc, więc
        // kolumna i podsumowanie zawsze się zgadzają, a wartość trafia w ten
        // wiersz, którego dotyczy.
        Time NocWiersza(Pracownik pracownik, Linia linia)
        {
            Date data = linia.DzienM;
            DzienPracy dzienPracy = pracownik.DniPracy[data];
            bool maStrefeNocna = DzienMaStrefeNocna(dzienPracy);

            if (linia.Strefa == null)
            {
                if (maStrefeNocna)
                    return Time.Zero;
                Time n = kalkulator.Nocne(new FromTo(data, data));
                return n == Time.Empty ? Time.Zero : n;
            }

            if (maStrefeNocna)
            {
                return (linia.Strefa.Definicja != null && JestStrefaNocna(linia.Strefa.Definicja.Nazwa))
                    ? linia.CzasLaczny
                    : Time.Zero;
            }

            var def = linia.Strefa.Definicja;
            if (def == null || !def.Wchodzi || def.Typ != TypStrefy.Zwieksza)
                return Time.Zero;
            if (linia.Strefa.OdGodziny == Time.Empty || linia.DoGodzinyLaczna == Time.Empty)
                return Time.Zero;

            Time nocOd = pracownik[data].Etat.Kalendarz.Nocne.Od;
            Time nocDo = pracownik[data].Etat.Kalendarz.Nocne.Do;
            return PrzeciecieZPoraNocna(linia.Strefa.OdGodziny, linia.DoGodzinyLaczna, nocOd, nocDo);
        }

