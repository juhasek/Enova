        // te drugie daty
        public static Time PoliczPoreNocna(Pracownik pracownik, Date data, Time godzinaRozpoczecia, Time godzinaZakonczenia)
        {
            // przedział pobrany z kalendarza
            Time nocOd = pracownik[data].Etat.Kalendarz.Nocne.Od;
            Time nocDo = pracownik[data].Etat.Kalendarz.Nocne.Do;

            Time pracaOd = godzinaRozpoczecia;
            Time pracaDo = godzinaZakonczenia;

            Time start = Time.Max(nocOd, pracaOd);
            Time end = Time.Min(nocDo, pracaDo);

            if (end <= start)
                return Time.Zero;

            return end - start;
        }

