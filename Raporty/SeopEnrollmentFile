        public string AsOfDate { get; set; }
        public string InternalParticipantID { get; set; }
        public string ExternalParticipantID { get; set; }

        public string Gid { get; set; }
        public string PersonalIdentityCode { get; set; }
        public string FirstName { get; set; }
        public string MiddleName { get; set; }
        public string LastName { get; set; }

        public string AlternateName { get; set; }
        public string LanguagePreference { get; set; }
        public string StatementCurrencyPreference { get; set; }

        public string WorkEmail { get; set; }
        public string PreferredEmail { get; set; }

        public string RelationshipToCompany { get; set; }
        public string RelationshipToCompanyHireDate { get; set; }

        public string Division { get; set; }
        public string Subsidiary { get; set; }
        public string Company { get; set; }
        public string UsaPayrollCode { get; set; }

        public string SubsidiaryName { get; set; }
        public string SubsidiaryCode { get; set; }

        public string TaxState { get; set; }
        public string HostCountry { get; set; }

        public string ResidentAdress1 { get; set; }
        public string ResidentAdress2 { get; set; }
        public string ResidentAdress3 { get; set; }

        public string ResidentCity { get; set; }
        public string ResidentState { get; set; }

        public string ResidenPostalCode { get; set; }
        public string ResidentCountry { get; set; }

        public string DateOfBirth { get; set; }
    }
