namespace SeopEnrollmentFileSnippet {

    public class SeopEnrollmentFileSnippet : ReportSnippet {

        // =========================
        // PARAMETR RAPORTU
        // =========================

        public class Params : ContextBase {

            public Params(Context context) : base(context) {

                var aktualnaData = context.GetOrDefault<ActualDate>()?.Actual ?? Date.Today;

                okres = new FromTo(
                    aktualnaData.FirstDayMonth(),
                    aktualnaData.LastDayMonth()
                );
            }

            private FromTo okres;

            [Priority(1)]
            [Caption("Okres")]
            public FromTo Okres {
                get { return okres; }
                set {
                    okres = value;
                    OnChanged(EventArgs.Empty);
                }
            }
        }

        Params pars;

        [Context(Required = true)]
        public Params Parametry {
            set { pars = value; }
        }

        // =========================

        BusinessDataSource dc;
        Log log = new Log("SEOP", false);

        [DxBind]
        private readonly DevExpress.XtraReports.UI.DetailReportBand Lista;

        [DxBind(Name = "Report")]
        private void Report_BeforePrint(object sender, CancelEventArgs e) {

            log.WriteLine("=== START RAPORTU SEOP ===");

            if (this.DataSource == null || pars == null)
                return;

            if (pars.Okres.From == Date.Empty || pars.Okres.To == Date.Empty)
                return;

            log.WriteLine($"Okres raportu: {pars.Okres}");

            dc = (BusinessDataSource)this.DataSource;

            Date data = pars.Okres.From;

            var rows = dc.Context[typeof(Row[])] as Row[];
            if (rows == null)
                return;

            log.WriteLine($"Liczba pracowników w źródle: {rows.Length}");

            List<RaportAkcjeRow> wynik = new List<RaportAkcjeRow>();


            // ===============================
            // MODUŁ AKCJI PRACOWNICZYCH
            // ===============================

            var akcjeModule = AltOne.Skanska.AkcjePracownicze.AkcjePracA1Module.GetInstance(Context.Session);


            // ===============================
            // PĘTLA PRACOWNIKÓW
            // ===============================

            foreach (Pracownik p in rows) {

                log.WriteLine($"Pracownik: {p.Kod} {p.Nazwisko}");

                // problem kiedy pracownik zaczyna pracę w trakcie miesiąca - obsłużyc zmienną data

                var historia = p.Historia?[data];
                if (historia == null)
                    continue;

                var oddzial = historia.Etat?.Wydzial?.Oddzial;

                log.WriteLine($"Oddział: {oddzial}");

                if (oddzial == null)
                    continue;


                // ===============================
                // ZNAJDŹ EDYCJĘ DLA ODDZIAŁU
                // ===============================

                AltOne.Skanska.AkcjePracownicze.EdycjaAkcjiPracowniczej edycja = null;

                foreach (AltOne.Skanska.AkcjePracownicze.EdycjaAkcjiPracowniczej ed in akcjeModule.EdycjeAkcjiPrac)
                {
                    if (
                        ed.OkresOd <= pars.Okres.To &&
                        ed.OkresDo >= pars.Okres.From &&
                        ed.Oddzial == oddzial
                    )
                    {
                        edycja = ed;

                        log.WriteLine($"Znaleziono edycję: {ed.OkresOd} - {ed.OkresDo}");

                        break;
                    }
                }

                if (edycja == null)
                {
                    log.WriteLine("Brak edycji dla oddziału");
                    continue;
                }

                var uczestnictwo = edycja.Uczestnictwa
                    .FirstOrDefault(u => u.Pracownik == p);

                if (uczestnictwo == null)
                {
                    log.WriteLine("Pracownik nie jest uczestnikiem tej edycji");
                    continue;
                }

                // Enrollment file ma pokazywać WYŁĄCZNIE osoby, które w raportowanym okresie po raz
                // pierwszy przystąpiły do programu SEOP lub po raz pierwszy przystąpiły do nowej
                // edycji SEOP - nie wszystkich aktualnych uczestników edycji. Każde przystąpienie
                // (czy to pierwsze w ogóle, czy do kolejnej edycji) tworzy nowy wiersz
                // UczestnictwoWAkcji, którego OkresOd to data przystąpienia - filtrujemy więc po tym,
                // czy OkresOd mieści się w raportowanym okresie. Kontynuujący uczestnicy (OkresOd
                // sprzed raportowanego okresu) są pomijani.
                if (!pars.Okres.Contains(uczestnictwo.OkresOd))
                {
                    log.WriteLine($"Uczestnictwo pracownika rozpoczęło się poza raportowanym okresem (OkresOd={uczestnictwo.OkresOd}) - pomijam");
                    continue;
                }

                log.WriteLine($"Pracownik przystąpił do edycji w raportowanym okresie (OkresOd={uczestnictwo.OkresOd})");


                // Adres zamieszkania nie zawsze jest uzupełniony - gdy jest pusty (brak miejscowości),
                // do raportu bierzemy dane z adresu zameldowania zamiast zamieszkania.
                var adresZamieszkania = historia?.AdresZamieszkania;
                var adresDoRaportu = string.IsNullOrWhiteSpace(adresZamieszkania?.Miejscowosc)
                    ? historia?.AdresZameldowania
                    : adresZamieszkania;

                if (adresDoRaportu != adresZamieszkania)
                    log.WriteLine("Adres zamieszkania pusty - użyto adresu zameldowania");


                string division = string.Empty;
                string subsidiary = string.Empty;
                string companyCode = string.Empty;

                if (oddzial != null) {

                    division = oddzial.Nadrzedny?.Features?["SEOP_Division"]?.ToString()
                               ?? oddzial.Features?["SEOP_Division"]?.ToString();

                    subsidiary = oddzial.Nadrzedny?.Features?["SEOP_Subsidiary"]?.ToString()
                                 ?? oddzial.Features?["SEOP_Subsidiary"]?.ToString();

                    companyCode = oddzial.Nadrzedny?.Features?["SEOP_CompanyCode"]?.ToString()
                                  ?? oddzial.Features?["SEOP_CompanyCode"]?.ToString();
                }


                wynik.Add(new RaportAkcjeRow {

                    KontoAktywne = uczestnictwo?.AktualnoscOd != Date.Empty ? "Tak" : "",

                    AsOfDate = historia?.Etat?.OkresZatrudnienia.From
                        .ToString("dd-MMM-yyyy", CultureInfo.GetCultureInfo("en-US")),

                    InternalParticipantID = "",// uczestnictwo?.AktualnoscOd
                        //.ToString("dd-MMM-yyyy", CultureInfo.GetCultureInfo("en-US")),

                    RelationshipToCompanyHireDate = historia?.Etat?.OkresZatrudnienia.From
                        .ToString("dd-MMM-yyyy", CultureInfo.GetCultureInfo("en-US")),

                    Gid = p.Features["SEOP_GlobalId"]?.ToString(),

                    PersonalIdentityCode = historia?.PESEL,
                    FirstName = p.Imie,
                    MiddleName = historia?.ImieDrugie,
                    LastName = p.Nazwisko,

                    LanguagePreference = "PL",
                    StatementCurrencyPreference = "PLN",

                    WorkEmail = p.EMAIL,
                    PreferredEmail = "",

                    RelationshipToCompany = "Employee",

                    Division = division,
                    Subsidiary = subsidiary,
                    UsaPayrollCode = "",

                    Company = companyCode,

                    TaxState = "In Window",
                    HostCountry = "POL",

                    ResidentAdress1 = adresDoRaportu?.Linia1,
                    ResidentAdress2 = "",
                    ResidentAdress3 = "",

                    ResidentCity = adresDoRaportu?.Miejscowosc,
                    ResidentState = "",

                    ResidenPostalCode =
                        adresDoRaportu?.KodPocztowy == 0
                        ? ""
                        : adresDoRaportu?.KodPocztowy.ToString("00000"),

                    ResidentCountry = "POL",

                    DateOfBirth = historia?.Urodzony.Data
                        .ToString("dd-MMM-yyyy", CultureInfo.GetCultureInfo("en-US"))
                });

                log.WriteLine("Dodano pracownika do raportu");
            }

            log.WriteLine($"Liczba pracowników w raporcie: {wynik.Count}");

            Lista.DataSource = wynik;

            DopasujSzerokosciKolumn(wynik);
            UstawWysokoscWierszy();


            if (this.Report != null) {

                this.Report.ExportOptions.Xlsx.ExportMode =
                    XlsxExportMode.SingleFilePageByPage;

                this.Report.ExportOptions.Xlsx.RawDataMode = false;

                this.Report.ExportOptions.Xlsx.TextExportMode =
                    TextExportMode.Value;
            }

            log.WriteLine("=== KONIEC RAPORTU SEOP ===");
        }

        // =========================
        // FORMATOWANIE ARKUSZA (bez EPPlus - natywnie przez DevExpress)
        // =========================

        // Stała wysokość wszystkich wierszy tabeli (jednostki raportu - 1/100 cala, ~18 = ok. 0,25 cm).
        const float WysokoscWiersza = 18f;

        const float MinSzerokoscKolumny = 40f;
        const float MaxSzerokoscKolumny = 400f;
        const float SzerokoscNaZnak = 6.5f;  // przybliżona szerokość znaku dla domyślnej czcionki raportu
        const float MarginesKomorki = 10f;

        // Pseudo-autofit: DevExpress mapuje szerokości kolumn w wyeksportowanym Excelu wprost
        // z Weight komórek tabeli w layoucie raportu (nie ma odpowiednika EPPlus.AutoFitColumns).
        // Dopasowujemy więc Weight każdej kolumny do długości najdłuższej wartości w tej kolumnie
        // (dane z `wynik` dla komórek związanych bindowaniem [DataBindings["Text"]] + statyczny
        // tekst komórek nagłówkowych), synchronizując tę samą wartość we wszystkich XRTable
        // znalezionych w paśmie `Lista` (nagłówek i wiersz danych to zwykle osobne tabele -
        // muszą mieć zsynchronizowane Weight per kolumna, inaczej siatka w Excelu się rozjedzie).
        //
        // UWAGA: nie da się tego zweryfikować bez podglądu rzeczywistego pliku .repx - jeśli
        // layout raportu nie korzysta z XRTable (tylko z osobnych XRLabel na paśmie), metoda
        // nie znajdzie żadnych komórek i nic nie zmieni; wtedy trzeba dopasować ją do
        // rzeczywistej struktury kontrolek w projektancie wydruku.
        private void DopasujSzerokosciKolumn(List<RaportAkcjeRow> wynik) {

            if (wynik.Count == 0)
                return;

            var tabele = ZbierzKontrolki(Lista)
                .OfType<DevExpress.XtraReports.UI.XRTable>()
                .ToList();

            if (tabele.Count == 0) {
                log.WriteLine("DopasujSzerokosciKolumn: nie znaleziono XRTable w paśmie Lista - pomijam");
                return;
            }

            int liczbaKolumn = tabele
                .SelectMany(t => t.Rows.Cast<DevExpress.XtraReports.UI.XRTableRow>())
                .Max(r => r.Cells.Count);

            for (int indeksKolumny = 0; indeksKolumny < liczbaKolumn; indeksKolumny++) {

                int maxDlugoscTresci = 0;

                foreach (var tabela in tabele) {
                    foreach (DevExpress.XtraReports.UI.XRTableRow wiersz in tabela.Rows) {

                        if (indeksKolumny >= wiersz.Cells.Count)
                            continue;

                        var komorka = wiersz.Cells[indeksKolumny];
                        string pole = komorka.DataBindings["Text"]?.DataMember;

                        if (!string.IsNullOrEmpty(pole)) {

                            var wlasciwosc = typeof(RaportAkcjeRow).GetProperty(pole);
                            if (wlasciwosc != null) {
                                int dl = wynik
                                    .Select(w => (wlasciwosc.GetValue(w) as string)?.Length ?? 0)
                                    .DefaultIfEmpty(0)
                                    .Max();
                                maxDlugoscTresci = Math.Max(maxDlugoscTresci, dl);
                            }

                        } else if (!string.IsNullOrEmpty(komorka.Text)) {
                            maxDlugoscTresci = Math.Max(maxDlugoscTresci, komorka.Text.Length);
                        }
                    }
                }

                if (maxDlugoscTresci <= 0)
                    continue;

                float nowaSzerokosc = Math.Max(
                    MinSzerokoscKolumny,
                    Math.Min(MaxSzerokoscKolumny, maxDlugoscTresci * SzerokoscNaZnak + MarginesKomorki));

                foreach (var tabela in tabele) {
                    foreach (DevExpress.XtraReports.UI.XRTableRow wiersz in tabela.Rows) {
                        if (indeksKolumny < wiersz.Cells.Count) {
                            wiersz.Cells[indeksKolumny].Weight = nowaSzerokosc;
                            wiersz.Cells[indeksKolumny].WidthF = nowaSzerokosc;
                        }
                    }
                }

                log.WriteLine($"Kolumna {indeksKolumny}: szerokość={nowaSzerokosc} (najdłuższa treść={maxDlugoscTresci} znaków)");
            }
        }

        private void UstawWysokoscWierszy() {

            foreach (var tabela in ZbierzKontrolki(Lista).OfType<DevExpress.XtraReports.UI.XRTable>())
                foreach (DevExpress.XtraReports.UI.XRTableRow wiersz in tabela.Rows)
                    wiersz.HeightF = WysokoscWiersza;
        }

        // Rekurencyjne zebranie wszystkich kontrolek pasma `Lista` (włącznie z jego własnymi
        // podpasmami - nagłówek/detal - i zagnieżdżonymi kontenerami).
        private IEnumerable<DevExpress.XtraReports.UI.XRControl> ZbierzKontrolki(
            DevExpress.XtraReports.UI.DetailReportBand pasmoNadrzedne) {

            foreach (DevExpress.XtraReports.UI.Band pasmo in pasmoNadrzedne.Bands)
                foreach (DevExpress.XtraReports.UI.XRControl kontrolka in pasmo.Controls)
                    foreach (var zagniezdzona in ZbierzKontrolkiRekurencyjnie(kontrolka))
                        yield return zagniezdzona;
        }

        private IEnumerable<DevExpress.XtraReports.UI.XRControl> ZbierzKontrolkiRekurencyjnie(
            DevExpress.XtraReports.UI.XRControl kontrolka) {

            yield return kontrolka;

            foreach (DevExpress.XtraReports.UI.XRControl dziecko in kontrolka.Controls)
                foreach (var zagniezdzona in ZbierzKontrolkiRekurencyjnie(dziecko))
                    yield return zagniezdzona;
        }
    }


    public class RaportAkcjeRow {

