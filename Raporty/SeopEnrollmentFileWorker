using System;
using System.IO;
using System.Linq;
using Microsoft.Extensions.DependencyInjection;
using Soneta.Business;
using Soneta.Business.UI;
using Soneta.Kadry;
using Soneta.Types;
using OfficeOpenXml;

[assembly: Worker<SeopEnrollmentFileWorker, Pracownicy>]

namespace SeopEnrollmentFileSnippet {

    // Worker dokłada do listy Pracownicy pozycję w menu Czynności "Generuj plik SEOP (xlsx)".
    //
    // W odróżnieniu od zwykłego wydruku (Raporty/SeopEnrollmentFile, eksportowanego ręcznie
    // z podglądu wydruku Enova), ten worker generuje plik programowo przez IReportService -
    // dzięki temu ma dostęp do gotowych bajtów pliku i może je doformatować biblioteką EPPlus
    // (auto-dopasowanie szerokości kolumn do treści, stała wysokość wierszy). Przy eksporcie
    // z poziomu standardowego podglądu wydruku nie da się tego zrobić - DevExpress zapisuje plik
    // na dysk samodzielnie i nie udostępnia zdarzenia z gotowymi bajtami "po zapisie".
    //
    // UWAGA - do zweryfikowania w żywej aplikacji (nie da się tego sprawdzić bez dostępu do
    // konkretnej instalacji enova):
    // 1. TemplateFileName poniżej musi się zgadzać z rzeczywistą nazwą wzorca .repx
    //    zarejestrowaną dla tego wydruku w Enova (Konfiguracja > Wydruki).
    // 2. ReportResult.Rows zakłada, że silnik raportów sam zbuduje z tego kontekst
    //    Row[] odczytywany w Report_BeforePrint (dc.Context[typeof(Row[])]) - zgodnie
    //    z dokumentacją to udokumentowany mechanizm "wiersze źródłowe zamiast Context",
    //    ale warto to potwierdzić jednym wygenerowanym plikiem.
    public class SeopEnrollmentFileWorker {

        [Context]
        public Pracownicy Pracownicy { get; set; }

        [Action("Generuj plik SEOP (xlsx)")]
        public object GenerujPlikXlsx() {

            // Ten sam typ parametru (Okres) co przy zwykłym wydruku - Enova dopyta o niego
            // w oknie dialogowym, chyba że jest już w kontekście.
            return QueryContextInformation.Create<SeopEnrollmentFileSnippet.Params>(pars => {

                var session = Pracownicy.Session;
                var raporty = session.GetRequiredService<IReportService>();

                var context = Context.Empty.Clone(session);
                context.Set(pars);

                var rr = new ReportResult {
                    TemplateFileName = "SeopEnrollmentFile.repx",
                    DataType = typeof(Pracownik[]),
                    Rows = Pracownicy,
                    Context = context,
                    OutputFormat = ReportFormats.XLSX,
                    AskForParameters = false,
                };

                byte[] surowyXlsx;
                using (var strumien = raporty.GenerateReport(rr))
                using (var bufor = new MemoryStream()) {
                    strumien.CopyTo(bufor);
                    surowyXlsx = bufor.ToArray();
                }

                byte[] sformatowanyXlsx = SformatujExcel(surowyXlsx);

                string nazwaPliku = $"SEOP_Enrollment_File_{pars.Okres.From:yyyyMM}.xlsx";
                return new NamedStream(nazwaPliku, () => new MemoryStream(sformatowanyXlsx));
            });
        }

        // Doformatowanie gotowego pliku wygenerowanego przez DevExpress: auto-dopasowanie
        // szerokości kolumn do treści oraz stała wysokość wierszy.
        private static byte[] SformatujExcel(byte[] surowyXlsx) {

            using (var pakiet = new ExcelPackage(new MemoryStream(surowyXlsx))) {

                var arkusz = pakiet.Workbook.Worksheets[0];

                if (arkusz.Dimension != null) {

                    arkusz.Cells[arkusz.Dimension.Address].AutoFitColumns();

                    const double wysokoscWiersza = 18;
                    for (int wiersz = arkusz.Dimension.Start.Row; wiersz <= arkusz.Dimension.End.Row; wiersz++)
                        arkusz.Row(wiersz).Height = wysokoscWiersza;
                }

                return pakiet.GetAsByteArray();
            }
        }
    }
}
