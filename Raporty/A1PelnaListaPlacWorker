using System;
using System.IO;
using System.Linq;
using Microsoft.Extensions.DependencyInjection;
using Soneta.Business;
using Soneta.Business.UI;
using Soneta.Place;
using Soneta.Types;
using OfficeOpenXml;

[assembly: Worker<A1PelnaListaPlacWorker, ListaPlac>]

namespace x.x.Reports
{
    // Worker dokłada do listy "Płace -> Listy płac" pozycję w menu Czynności generującą
    // .xlsx PROGRAMOWO przez IReportService (ten sam wzorzec .repx +
    // A1PelnaListaPlacSnippet co zwykły wydruk), a następnie doformatowującą GOTOWE bajty
    // pliku biblioteką EPPlus - prawdziwy auto-fit szerokości kolumn
    // (AutoFitColumns() mierzy realnie renderowany tekst, nie przybliżeniem jak
    // pseudo-autofit w samym snippecie: DopasujSzerokosciKolumn/DopasujSzerokoscStrony)
    // oraz stała wysokość wierszy.
    //
    // Różnica względem zwykłego eksportu z podglądu wydruku: tam DevExpress sam zapisuje
    // plik na dysk i nie ma zdarzenia z dostępem do gotowych bajtów "po fakcie" (dlatego
    // EPPlus był wcześniej wycofany dla Raporty/SeopEnrollmentFile - zob. ten .md p.6).
    // TUTAJ generujemy plik przez IReportService.GenerateReport(...) WPROST, dostajemy
    // Stream z surowymi bajtami .xlsx i możemy je swobodnie post-processować przed
    // oddaniem operatorowi do pobrania - dokładnie wzorem (przywróconym tu z historii
    // commitów) `Raporty/SeopEnrollmentFileWorker` (dodany 05e0824, wycofany 5ac1a17 -
    // wycofany bez podanego technicznego powodu w commicie, nie dlatego że EPPlus tam
    // nie działał).
    //
    // TODO/UNVERIFIED - sprawdzić PRZED czymkolwiek innym, w tej kolejności:
    // 1. Czy biblioteka EPPlus (namespace OfficeOpenXml) jest w ogóle dostępna w tej
    //    instalacji enova - NIE znaleziono pliku EPPlus.dll/OfficeOpenXml.dll pod
    //    C:\enovaServer ani ~/Downloads (przeszukane z tego repo). Jeśli po wklejeniu tego
    //    pliku edytor rzuci błąd typu "nie znaleziono typu lub przestrzeni nazw
    //    OfficeOpenXml" / "Could not load file or assembly" - oznacza to, że ta biblioteka
    //    nie jest zarejestrowana w instalacji i całe to podejście jest niewykonalne bez
    //    dodania referencji (a snippety wklejane w edytorze skryptów NIE MOGĄ dodawać
    //    własnych referencji NuGet - zob. CLAUDE.md / pamięć project-srodowisko-lokalne).
    // 2. GDZIE w GUI enova wkleja się kod klasy Worker (z atrybutem [assembly: Worker<...>])
    //    - w odróżnieniu od kodu snippetu wydruku (wklejanego w "Kod źródłowy" KONKRETNEGO
    //    wzorca .repx), Worker to rozszerzenie GLOBALNE dodatku. W tym repo nie mamy
    //    jeszcze potwierdzonego przykładu takiej rejestracji przez GUI (brak wcześniejszego
    //    Workera w repo) - prawdopodobnie osobne miejsce typu "Kod źródłowy dodatku" /
    //    "Rozszerzenia" w Narzędzia -> Opcje, ale wymaga potwierdzenia w GUI.
    // 3. Czy `DataType = typeof(ListaPlac[])` + jawne `context.Set(zaznaczoneWiersze)`
    //    (Row[]) faktycznie trafia do `A1PelnaListaPlacSnippet.Report_BeforePrint` jako
    //    `Context[typeof(Row[])]` - w SEOP-owym pierwowzorze ten mechanizm (przez
    //    `ReportResult.Rows`) był oznaczony jako niepotwierdzony; tu dodatkowo
    //    strachujemy się jawnym `context.Set(...)`, ale i tak wymaga sprawdzenia jednym
    //    wygenerowanym plikiem.
    public class A1PelnaListaPlacWorker
    {
        [Context]
        public ListaPlac[] ZaznaczoneListyPlac { get; set; }

        public bool IsVisibleGenerujXlsx() => ZaznaczoneListyPlac?.Length > 0;
        public bool IsEnabledGenerujXlsx() => ZaznaczoneListyPlac?.Length > 0;

        [Action("Generuj pełną listę płac (xlsx, auto-fit EPPlus)")]
        public object GenerujXlsx()
        {
            var session = ZaznaczoneListyPlac[0].Session;
            var raporty = session.GetRequiredService<IReportService>();

            // Row[] jawnie w Context - to dokładnie to, czego oczekuje
            // A1PelnaListaPlacSnippet.Report_BeforePrint (dc?[typeof(Row[])] as Row[]).
            // Nie polegamy wyłącznie na (niepotwierdzonym) automatycznym wypełnianiu
            // Context z ReportResult.Rows.
            Row[] zaznaczoneWiersze = ZaznaczoneListyPlac.Cast<Row>().ToArray();

            var context = Context.Empty.Clone(session);
            context.Set(zaznaczoneWiersze);

            var rr = new ReportResult
            {
                TemplateFileName = "A1PelnaListaPlac.repx",
                DataType = typeof(ListaPlac[]),
                Rows = ZaznaczoneListyPlac,
                Context = context,
                OutputFormat = ReportFormats.XLSX,
                AskForParameters = false,
            };

            byte[] surowyXlsx;
            using (var strumien = raporty.GenerateReport(rr))
            using (var bufor = new MemoryStream())
            {
                strumien.CopyTo(bufor);
                surowyXlsx = bufor.ToArray();
            }

            byte[] sformatowanyXlsx = SformatujExcel(surowyXlsx);

            string nazwaPliku = $"A1_Pelna_Lista_Plac_{Date.Today:yyyyMMdd}.xlsx";
            return new NamedStream(nazwaPliku, () => new MemoryStream(sformatowanyXlsx));
        }

        // Doformatowanie gotowego pliku wygenerowanego przez DevExpress: prawdziwy
        // auto-fit szerokosci kolumn (EPPlus mierzy realnie renderowany tekst zamiast
        // przyblizenia "dlugosc znaku x stala" jak w pseudo-autofit snippetu) oraz stala
        // wysokosc wierszy.
        private static byte[] SformatujExcel(byte[] surowyXlsx)
        {
            using (var pakiet = new ExcelPackage(new MemoryStream(surowyXlsx)))
            {
                var arkusz = pakiet.Workbook.Worksheets[0];

                if (arkusz.Dimension != null)
                {
                    arkusz.Cells[arkusz.Dimension.Address].AutoFitColumns();

                    const double wysokoscWiersza = 18;
                    for (int wiersz = arkusz.Dimension.Start.Row; wiersz <= arkusz.Dimension.End.Row; wiersz++)
                        arkusz.Row(wiersz).Height = wysokoscWiersza;
                }

                return pakiet.GetAsByteArray();
            }
        }
    }
}
