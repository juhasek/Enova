using System;
using System.IO;
using System.Linq;
using Microsoft.Extensions.DependencyInjection;
using Soneta.Business;
using Soneta.Business.UI;
using Soneta.Place;
using Soneta.Types;
using DevExpress.Spreadsheet;

[assembly: Worker<A1PelnaListaPlacWorker, ListaPlac>]

namespace x.x.Reports
{
    // Czynnosc "Pelna lista plac -> XLSX (auto-fit)" na liscie Place -> Listy plac.
    // Dziala na ZAZNACZONYCH pozycjach listy plac. W odroznieniu od zwyklego wydruku
    // (A1PelnaListaPlacSnippet eksportowanego recznie z podgladu):
    //
    //   1. generuje plik .xlsx PROGRAMOWO przez IReportService.GenerateReport(...),
    //      uzywajac TEGO SAMEGO wzorca A1PelnaListaPlac.repx i tego samego snippetu
    //      (cala logika kolumn/wierszy - dynamiczne elementy + 17 kolumn ZUS/PPK/PIT -
    //      jest w 100% ponownie wykorzystana),
    //   2. otwiera surowe bajty .xlsx jako DevExpress.Spreadsheet.Workbook i robi
    //      PRAWDZIWY auto-fit (Columns.AutoFit / Rows.AutoFit - mierzy realnie
    //      renderowany tekst, nie przyblizeniem "dlugosc znaku x stala" jak
    //      pseudo-autofit w samym snippecie),
    //   3. zwraca gotowy plik jako NamedStream - operator dostaje go do pobrania.
    //
    // ---------------------------------------------------------------------------
    // ZWERYFIKOWANE NA DLL-ach serwera (C:\enovaServer\2512.5.6\...\, enova 2512.5.6),
    // dekompilacja ilspycmd - 2026-09-07:
    //
    //  - IReportService (Soneta.Business.UI): Stream GenerateReport(ReportResult),
    //    Type[] GetParameterTypes(string templateFileName, Context). Rejestrowany jako
    //    [Service(typeof(IReportService), typeof(ReportServiceImpl), ServiceScope.Session)]
    //    -> session.GetRequiredService<IReportService>() dziala.
    //  - ReportFormats (Soneta.Business.UI) MA wartosc XLSX (obok XLS/CSV/DOCX/PDF...).
    //    DxReportGenerator.BuildReport: ReportFormats.XLSX -> Report.ExportToXlsx(stream).
    //  - GetParameterTypes zwraca dokladnie typy property [Context(Required = true)]
    //    z klas ReportSnippet w tym .repx (DxQueryParameters.Analyse) - czyli
    //    { typeof(A1PelnaListaPlacSnippet.PrnParams) }. Bez wstawienia instancji tego
    //    typu do kontekstu ReportServiceImpl.Generate zwraca QueryContextInformation /
    //    GenerateReport rzuca "Problem z przygotowaniem raportu", a snippet i tak
    //    wszedlby w galaz "designer" (pars == null) i zwrocil pusta tabele.
    //    Dlatego ponizej: petla po GetParameterTypes -> Activator.CreateInstance(t, ctx).
    //  - ReportResult.CheckConsistency(reportService: true) RZUCA, gdy ustawiony jest
    //    OutputHandler -> przy wywolaniu przez IReportService NIE wolno go ustawiac;
    //    post-processing robimy po odebraniu strumienia.
    //  - DevExpress.Spreadsheet: klasa konkretna Workbook (public ctor, LoadDocument/
    //    SaveDocument(Stream, DocumentFormat)) jest w DevExpress.Docs.v24.1.dll;
    //    ColumnCollection.AutoFit(int first, int last) i RowCollection.AutoFit(int, int)
    //    oraz Worksheet.GetUsedRange() -> CellRange (LeftColumnIndex/RightColumnIndex/
    //    TopRowIndex/BottomRowIndex) sa w DevExpress.Spreadsheet.v24.1.Core.dll.
    //    Oba pliki leza w folderze serwera obok uzywanego DevExpress.XtraReports.
    //
    // DO POTWIERDZENIA NA ZYWEJ BAZIE (patrz A1PelnaListaPlacWorker.md, sekcja
    // "Do sprawdzenia w tej kolejnosci"):
    //  A. Czy kompilator "Projektow w bazie" (RuntimeProjects / CodeFiles) referencjonuje
    //     DevExpress.Spreadsheet + DevExpress.Docs (blad "nie znaleziono typu
    //     DevExpress.Spreadsheet" = nie referencjonuje -> patrz .md, wariant awaryjny).
    //  B. NazwaWzorca / TemplateFileSource - "A1PelnaListaPlac.repx" + AspxSource.Storage
    //     musi trafic we wzorzec zarejestrowany w Projektancie wydrukow. Jesli
    //     GenerateReport nie znajdzie wzorca - sprobowac samej nazwy bez ".repx",
    //     albo AspxSource.Local.
    //  C. Czy Context[typeof(Row[])] faktycznie dociera do snippetu (wynikowy .xlsx ma
    //     dane zaznaczonych list plac, nie pusta tabele).
    public class A1PelnaListaPlacWorker
    {
        [Context]
        public Context Context { get; set; }

        [Context]
        public ListaPlac[] ZaznaczoneListyPlac { get; set; }

        public bool IsVisibleGenerujXlsx() => ZaznaczoneListyPlac?.Length > 0;
        public bool IsEnabledGenerujXlsx() => ZaznaczoneListyPlac?.Length > 0;

        // Nazwa wzorca zarejestrowanego w Projektancie wydrukow (patrz punkt B wyzej).
        const string NazwaWzorca = "A1PelnaListaPlac.repx";

        [Action("Pełna lista płac → XLSX (auto-fit)")]
        public object GenerujXlsx()
        {
            var session = ZaznaczoneListyPlac[0].Session;
            var raporty = session.GetRequiredService<IReportService>();

            // Wlasny kontekst tego wywolania - nie zasmiecamy kontekstu UI.
            var ctx = (Context ?? Soneta.Business.Context.Empty).Clone(session);

            // Zaznaczenie jako Row[] - dokladnie to czyta A1PelnaListaPlacSnippet
            // (dc?[typeof(Row[])] as Row[]). Context.Set kluczuje po value.GetType(),
            // wiec tablica musi miec runtime-typ Row[] (stad Cast<Row>().ToArray()).
            Row[] zaznaczone = ZaznaczoneListyPlac.Cast<Row>().ToArray();
            ctx.Set(zaznaczone);

            // WYMAGANE parametry wydruku (snippet: [Context(Required = true)] PrnParams).
            // Bez tego generacja zwroci null / zazada parametrow (patrz komentarz u gory).
            foreach (Type t in raporty.GetParameterTypes(NazwaWzorca, ctx))
            {
                if (ctx[t, false] == null)
                    ctx.Set(Activator.CreateInstance(t, ctx));
            }

            var rr = new ReportResult
            {
                TemplateFileName = NazwaWzorca,
                TemplateFileSource = AspxSource.Storage,
                DataType = typeof(ListaPlac[]),
                Rows = ZaznaczoneListyPlac,
                Context = ctx,
                OutputFormat = ReportFormats.XLSX,
                AskForParameters = false,
            };

            byte[] surowyXlsx;
            using (Stream strumien = raporty.GenerateReport(rr))
            {
                if (strumien == null)
                    return "Nie udało się wygenerować wydruku XLSX (brak strumienia z IReportService).";
                using (var bufor = new MemoryStream())
                {
                    strumien.CopyTo(bufor);
                    surowyXlsx = bufor.ToArray();
                }
            }

            byte[] wynik = DopasujSzerokosci(surowyXlsx);

            string nazwaPliku = "A1_Pelna_Lista_Plac_" + Date.Today.ToString("yyyyMMdd") + ".xlsx";
            return new NamedStream(nazwaPliku, () => new MemoryStream(wynik));
        }

        // Prawdziwy auto-fit: otwiera gotowy .xlsx z XtraReports i mierzy realnie
        // renderowany tekst (DevExpress.Spreadsheet), zamiast przyblizenia w snippecie.
        static byte[] DopasujSzerokosci(byte[] surowyXlsx)
        {
            using (var workbook = new Workbook())
            {
                using (var wejscie = new MemoryStream(surowyXlsx))
                    workbook.LoadDocument(wejscie, DocumentFormat.Xlsx);

                foreach (Worksheet arkusz in workbook.Worksheets)
                {
                    CellRange uzyty = arkusz.GetUsedRange();
                    if (uzyty == null) continue;

                    arkusz.Columns.AutoFit(uzyty.LeftColumnIndex, uzyty.RightColumnIndex);
                    arkusz.Rows.AutoFit(uzyty.TopRowIndex, uzyty.BottomRowIndex);
                }

                using (var wyjscie = new MemoryStream())
                {
                    workbook.SaveDocument(wyjscie, DocumentFormat.Xlsx);
                    return wyjscie.ToArray();
                }
            }
        }
    }
}
