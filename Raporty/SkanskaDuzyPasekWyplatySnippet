        [DxBind(Name = "Report")]
        private void DuzyPasekWyplaty_BeforePrint(object sender, CancelEventArgs e)
        {
            Context context = DxReportHelpers.GetContext(this);

            // Lista bieżąca (CurrentList) raportu zależy od miejsca uruchomienia:
            //   Płace / Wypłaty            -> wiersze Wyplata (WyplataEtat)   [działa, zaznaczone]
            //   kartoteka -> zakł. Wypłaty -> CurrentList = rekord nadrzędny (PracHistoria),
            //                                 zaznaczenie wypłat siedzi w INavigatorContext
            //   lista Pracownicy           -> wiersze PracHistoria / Pracownik
            //   lista list płac            -> wiersze ListaPlac
            var wyplaty = new List<WyplataEtat>();
            var widziane = new HashSet<Guid>();

            foreach (object item in DxReportHelpers.GetDataSourceList<object>(this))
            {
                if (item is WyplataEtat we)
                {
                    // Druk z listy Wypłat — CurrentList to już zaznaczone zapisy.
                    if (widziane.Add(we.Guid))
                        wyplaty.Add(we);
                }
                else if (item is Wyplata)
                {
                    throw new Exception("Wydruk działa tylko dla wypłat etatowych.".Translate());
                }
                else if (item is ListaPlac lp)
                {
                    foreach (Wyplata w in lp.Wyplaty)
                        if (w is WyplataEtat we2 && widziane.Add(we2.Guid))
                            wyplaty.Add(we2);
                }
                else
                {
                    // Druk z kartoteki / listy Pracownicy — CurrentList to pracownik, nie wypłaty.
                    Pracownik prac = PracownikZWiersza(item);
                    if (prac == null)
                        continue;

                    // Najpierw zaznaczenie z nawigatora pod-listy Wypłaty na kartotece.
                    var zazn = ZaznaczoneWyplaty(context, prac);
                    if (zazn.Count > 0)
                    {
                        foreach (WyplataEtat wz in zazn)
                            if (widziane.Add(wz.Guid))
                                wyplaty.Add(wz);
                    }
                    else
                    {
                        // Fallback: brak zaznaczenia -> wszystkie wypłaty etatowe pracownika.
                        foreach (Wyplata w in PlaceModule.GetInstance(context).Wyplaty.WgPracownik[prac])
                            if (w is WyplataEtat we3 && widziane.Add(we3.Guid))
                                wyplaty.Add(we3);
                    }
                }
            }

            if (wyplaty.Count == 0)
                throw new Exception("Brak wypłat etatowych do wydruku.".Translate());

            // --- grupowanie po (Pracownik.Guid, ListaPlac.Okres, typ wypłaty) ---
            var grupy = new List<List<WyplataEtat>>();
            foreach (var w in wyplaty)
            {
                List<WyplataEtat> grupa = null;
                if (srpars != null && srpars.SumujWyplaty)
                {
                    foreach (var g in grupy)
                    {
                        var rep = g[0];
                        if (rep.Pracownik.Guid == w.Pracownik.Guid
                            && rep.ListaPlac.Okres == w.ListaPlac.Okres
                            && rep.GetType() == w.GetType())
                        {
                            grupa = g;
                            break;
                        }
                    }
                }
                if (grupa == null)
                {
                    grupa = new List<WyplataEtat>();
                    grupy.Add(grupa);
                }
                grupa.Add(w);
            }

            // --- budowa DTO per grupa ---
            var lista = new List<SkanskaPasekSource>();
            foreach (var grupa in grupy)
                lista.Add(BuildSource(grupa, context));

            DxReportHelpers.GetDataSourceEmpty(this).CustomDataSource = lista;
        }

        // ------------------------------------------------------------------------
        // Budowa jednego DTO (jedna grupa wypłat)
        // ------------------------------------------------------------------------
        private SkanskaPasekSource BuildSource(List<WyplataEtat> grupa, Context context)
        {
            var dto = new SkanskaPasekSource();
            WyplataEtat rep = grupa[0];
            PracHistoria ph = rep.PracHistoria;

            // --- nagłówek / dane stałe (reprezentant) ---
            dto.PracownikAdres = ph != null
                ? ph.Pracownik.ImięNazwisko + Environment.NewLine + ph.Adres.Linia1 + Environment.NewLine + ph.Adres.Linia2
                : "Brak danych".Translate();
            dto.Stawka = ph.Etat.Zaszeregowanie.Stawka.ToString();
            dto.LimitUrlopu = GetLimitUrlopu(ph, rep.Data);

            if (srpars != null && srpars.InfoNorma)
            {
                KalkulatorPracownika kalk = new KalkulatorPracownika(rep.Pracownik);
                CzasDni norma = kalk.Norma(rep.ListaPlac.Okres);
                dto.NormaText = norma.Czas + " / " + norma.Dni;
            }

            Wyplata.ZUSInfoWorker zus = new Wyplata.ZUSInfoWorker { Wypłata = rep };
            string nazwaNfz = (ph.OddzialNFZ != null && ph.OddzialNFZ.Oddział != null) ? ph.OddzialNFZ.Oddział.Nazwa : "";
            dto.Naglowek = new[]
            {
                "Wypłata za okres:  ".Translate() + rep.ListaPlac.Okres,
                "Data wypłaty:  ".Translate() + rep.Data,
                "Pracownik:  ".Translate() + rep.Pracownik,
                "Stanowisko: ".Translate() + GetStanowisko(ph),
                "PESEL:  ".Translate() + ph.PESEL,
                "Kod tytułu ubezpieczenia:  ".Translate() + zus.TytułUbezpieczenia,
                "Oddział NFZ:  ".Translate() + nazwaNfz
            };

            dto.JestPPK = JestPPK(rep, rep.ListaPlac.DataWyplaty);
            dto.PrzerwyHtml = BuildPrzerwy(rep, context, out bool przerwyVisible);
            dto.PrzerwyVisible = przerwyVisible;

            // --- agregacja wartości ze wszystkich wypłat grupy ---
            var gotowka = new Dictionary<string, decimal>();
            var inne = new Dictionary<string, decimal>();

            foreach (WyplataEtat w in grupa)
            {
                WyplataEtatWorker etat = new WyplataEtatWorker { Wypłata = w };
                Wyplata.CzasInfoWorker czas = new Wyplata.CzasInfoWorker { Wypłata = w };
                Wyplata.PITInfoWorker pit = new Wyplata.PITInfoWorker { Wypłata = w };
                WyplataSkładkiWorker skl = new WyplataSkładkiWorker { Wypłata = w };

                // WyplataEtat
                dto.Zasadnicze += etat.Zasadnicze;
                dto.Nadgodziny50 += etat.Nadgodziny50;
                dto.Nadgodziny100 += etat.Nadgodziny100;
                dto.Nocne += etat.Nocne;
                dto.RozlPit += etat.RozlPit;

                // CzasInfo
                dto.PracaDni += czas.PracaDni;
                dto.PracaCzas += czas.PracaCzas;
                dto.ChoroboweDni += czas.Chorobowe.Dni;
                dto.UrlopDni += czas.Urlop.Dni;
                dto.UrlopCzas += czas.Urlop.Czas;
                dto.PozostaleDni += czas.Pozostałe.Dni;
                dto.Odchylka += czas.Odchyłka;
                dto.NocneCzas += czas.Nocne;
                dto.Nadg50Czas += czas.Nadgodziny50;
                dto.Nadg100Czas += czas.Nadgodziny100;

                // PITInfo
                dto.Brutto += pit.Brutto;
                dto.Netto += pit.Netto;
                dto.Koszty += pit.Koszty;
                dto.Ulga += pit.Ulga;
                dto.ZalFISNieZas += pit.ZalFISNieZas;
                dto.ZalFISZas += pit.ZalFISZas;

                // Składki
                dto.EmPodstawa += skl.Razem.Emerytalna.Podstawa;
                dto.EmPrac += skl.Razem.Emerytalna.Prac;
                dto.EmFirma += skl.Razem.Emerytalna.Firma;
                dto.RnPrac += skl.Razem.Rentowa.Prac;
                dto.RnFirma += skl.Razem.Rentowa.Firma;
                dto.ChPodstawa += skl.Razem.Chorobowa.Podstawa;
                dto.ChPrac += skl.Razem.Chorobowa.Prac;
                dto.WpFirma += skl.Razem.Wypadkowa.Firma;
                dto.ZdPodstawa += skl.Razem.Zdrowotna.Podstawa;
                dto.ZdPrac += skl.Razem.Zdrowotna.Prac;
                dto.KosztyZUS += skl.Razem.KosztyZUS;
                dto.FirmaZUS += skl.Razem.FirmaZUS;

                // PPK
                dto.PPKPodstPracownika += skl.Razem.PPK.PodstPracownika;
                dto.PPKDodPracownika += skl.Razem.PPK.DodPracownika;
                dto.PPKPracownika += skl.Razem.PPK.Pracownika;
                dto.PPKPodstPracodawcy += skl.Razem.PPK.PodstPracodawcy;
                dto.PPKDodPracodawcy += skl.Razem.PPK.DodPracodawcy;
                dto.PPKPracodawcy += skl.Razem.PPK.Pracodawcy;

                // do wypłaty
                AddMoney(gotowka, w.Gotówka);
                AddMoney(inne, w.Inne);
            }

            dto.GotowkaTekst = MoneyText(gotowka);
            dto.InneTekst = MoneyText(inne);

            // --- elementy zagregowane po definicji ---
            dto.Elementy = AggregateElementy(grupa);

            return dto;
        }

        // ------------------------------------------------------------------------
        // Agregacja elementów wynagrodzenia po (Definicja, %, nazwa)
        // ------------------------------------------------------------------------
        private List<ElementInfo> AggregateElementy(List<WyplataEtat> grupa)
        {
            var map = new Dictionary<string, ElementAgg>();
            var order = new List<string>();

            foreach (WyplataEtat w in grupa)
            {
                foreach (WypElement el in w.ElementyWgKolejności.Cast<WypElement>().Where(WypElementVisible))
                {
                    WypSkladnikGłówny skg = el.SkładnikGłówny;
                    string procent = (skg == null || skg.Procent == Percent.Zero) ? string.Empty : skg.Procent.ToString();
                    string nazwa = Korygowany(el);
                    string key = el.Definicja.ID + "|" + procent + "|" + nazwa;

                    if (!map.TryGetValue(key, out ElementAgg agg))
                    {
                        agg = new ElementAgg { Nazwa = nazwa, Procent = procent };
                        map[key] = agg;
                        order.Add(key);
                    }
                    agg.Wartosc += el.Wartosc;
                    agg.Czas += el.Czas;
                    agg.Dni += el.Dni;
                }
            }

            var list = new List<ElementInfo>();
            int lp = 0;
            foreach (string key in order)
            {
                ElementAgg a = map[key];
                lp++;
                list.Add(new ElementInfo
                {
                    LP = lp.ToString(),
                    Nazwa = a.Nazwa,
                    Procent = a.Procent,
                    Czas = a.Czas == Time.Zero ? string.Empty : a.Czas.ToString(),
                    Dni = a.Dni == 0 ? string.Empty : a.Dni.ToString(),
                    Dodatek = a.Wartosc >= 0m ? a.Wartosc.ToString() : null,
                    Potracenie = a.Wartosc < 0m ? (-a.Wartosc).ToString() : null
                });
            }
            return list;
        }

        // ------------------------------------------------------------------------
        // RMUA / przerwy (absencje IIID z IMIR) — liczone raz na grupę (reprezentant)
        // ------------------------------------------------------------------------
        [TranslateIgnore]
        private string BuildPrzerwy(WyplataEtat wyp, Context context, out bool visible)
        {
            visible = false;
            Soneta.Deklaracje.ZUS.RMUA rmua = null;
            Date dataIMIR = wyp.DataZUS;
            Pracownik prac = wyp.Pracownik;

            foreach (Soneta.Deklaracje.ZUS.RMUA item in prac.DeklaracjePodmiotu.OfType<Soneta.Deklaracje.ZUS.RMUA>())
            {
                if (item.IsDeklaracjaMiesieczna && item.Okres.Contains(dataIMIR))
                    rmua = item;
            }
            if (rmua == null)
                return string.Empty;

            string nazwaImir = bloki1[dataIMIR.Month - 1];
            BlokDeklaracji blok = rmua.Bloki[nazwaImir];
            string tyub0 = prac[dataIMIR].Etat.Ubezpieczenia.Tyub.ToString();
            string tyub = GetTyub(tyub0);

            string prw = Przerwy(blok, tyub, context);
            if (prw == "#EMPTY#")
                return string.Empty;

            visible = true;
            return prw;
        }

        [TranslateIgnore]
        private string Przerwy(BlokDeklaracji blok, string tyub, Context context)
        {
            string sp = System.Globalization.CultureInfo.CurrentUICulture.NumberFormat.NumberDecimalSeparator;
            string row, rows = "";
            bool result = false;
            string przerwy = (string)blok["Przerwy"];
            string[] linie = przerwy.Split('#');
            foreach (string linia in linie)
            {
                string[] elementy = linia.Split('|');
                if (elementy.Length != 6)
                    continue;
                result = true;
                string t = elementy[0];
                if (tyub != t)
                    continue;
                row = tabrow;
                row = row.Replace("#1#", KodRSA(elementy[1], context));
                row = row.Replace("#2#", elementy[3].Replace("...", " - "));
                row = row.Replace("#4#", elementy[4]);
                string kw = "", str = elementy[5];
                for (int ii = 0; ii < str.Length; ii++)
                    if (str[ii] != 0xa0) kw += str[ii];
                decimal kwota = Convert.ToDecimal(kw.Replace(",", sp));
                row = row.Replace("#5#", string.Format("{0:n}", kwota));
                rows += row;
            }
            if (!result)
            {
                rows = "#EMPTY#";
            }
            return rows;
        }

        private string KodRSA(string element, Context context)
        {
            string opis = element;
            try
            {
                int kod = int.Parse(element);
                KodRSA rsa = PlaceModule.GetInstance(context).KodyRSA.WgKodu[kod];
                if (rsa != null)
                    opis = rsa.Opis;
            }
            catch { }
            return opis;
        }

        private string GetTyub(string t)
        {
            int ty = 0;
            try
            {
                t = new string(t.Where(char.IsDigit).ToArray());
                ty = int.Parse(t);
            }
            catch
            {
                return t;
            }
            return ty.ToString();
        }

