        private string Korygowany(WypElement element)
        {
            string korektaTxt = " (korekta)".Translate();
            string depozytTxt = " (depozyt)".Translate();
            string nazwa = element.TranslatedName();
            if (element.Definicja.Korygowany && nazwa.EndsWith(korektaTxt))
                nazwa = nazwa.Replace(korektaTxt, "");
            else if (element is WypElementZajęcieKomornicze && nazwa.EndsWith(depozytTxt))
                nazwa = nazwa.Replace(depozytTxt, "");
            return nazwa;
        }

        private string GetLimitUrlopu(PracHistoria ph, Date data)
        {
            DefinicjaLimitu def = KalendModule.GetInstance(ph.Pracownik).DefinicjeLimitow.UrlopWypoczynkowy;
            DefinicjaLimitu defDod = KalendModule.GetInstance(ph.Pracownik).DefinicjeLimitow.UrlopDodatkowy;
            var workerLimity = new Pracownik.LimityNieobecnosciWorker(def, data);
            var workerLimityDod = new Pracownik.LimityNieobecnosciWorker(defDod, data);
            workerLimity.Row = ph.Pracownik;
            workerLimityDod.Row = ph.Pracownik;

            return (workerLimity.PozostalyRazemD + workerLimityDod.PozostalyRazemD).ToString()
                + " dni = "
                + (workerLimity.PozostalyRazemG + workerLimityDod.PozostalyRazemG).ToString()
                + " godzin";
        }

        private bool WypElementVisible(WypElement element)
        {
            switch (element.RodzajZrodla)
            {
                case RodzajŹródłaWypłaty.NadgodzinyI:
                case RodzajŹródłaWypłaty.NadgodzinyII:
                case RodzajŹródłaWypłaty.NadgodzinyŚw:
