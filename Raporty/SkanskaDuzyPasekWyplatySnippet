        // Wiersz CurrentList -> Pracownik (dla uruchomienia z kartoteki pracownika).
        private Pracownik PracownikZWiersza(object row)
        {
            if (row is Pracownik p)
                return p;
            if (row is PracHistoria ph)
                return ph.Pracownik;
            if (row is Wyplata w)
                return w.Pracownik;
            return null;
        }

        // Zaznaczone wiersze pod-listy Wypłaty na kartotece pracownika.
        // Druk z kartoteki podaje w CurrentList rekord nadrzędny (PracHistoria),
        // ale zaznaczenie wypłat jest dostępne w INavigatorContext. Zwraca tylko
        // wypłaty etatowe wskazanego pracownika (odsiewa nawigatory innych list).
        private List<WyplataEtat> ZaznaczoneWyplaty(Context context, Pracownik prac)
        {
            var wynik = new List<WyplataEtat>();
            try
            {
                INavigatorContext nav;
                if (context.Get<INavigatorContext>(out nav) && nav != null && nav.SelectedRows != null)
                    foreach (object r in nav.SelectedRows)
                        if (r is WyplataEtat wz && wz.Pracownik != null
                            && wz.Pracownik.Guid == prac.Guid)
                            wynik.Add(wz);
            }
            catch
            {
                wynik.Clear();
            }
            return wynik;
        }

        private string GetStanowisko(PracHistoria ph)
        {
            string stanowiskoPelne = "";
            if (srpars != null && srpars.PelneStanowisko)
                stanowiskoPelne = ph.Etat.StanowiskoPełne;
            if (stanowiskoPelne.Length == 0)
                stanowiskoPelne = ph.Etat.Stanowisko;
            return stanowiskoPelne;
