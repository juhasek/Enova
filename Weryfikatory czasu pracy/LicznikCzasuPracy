		 public void DodajWejscieWyjscieAfterEdit(Pracownik pracownik, WejscieWyjscieI win, DateTime czasWejscia)
		{
			Session session = pracownik.Session;
		  bool wejscienormatywne = false;
			string cechastart = "LCzPStartNorma";
      string cechastartKalend = "LCzPStartNormaKalend";  //tylko dla kalendarzy podstawowego i równoważnego
      string cechastartTolerancja = "LCzPTolernacja";
      string cechaTolerancja = "TolerancjaSpoznienia";  //tyle minut się można spóżnić
      string cechastartPrzedzial = "LCzPStartPrzedzial";
      string cechastartPrzedzialPrzed = "LCzPStartPPrzed";
      string cechastartPrzedzialPo = "LCzPStartPPo";

			if(win.Typ == TypWejsciaWyjscia.Wejscie)
			{
			 if (session.Global.Features.Definitions.Contains(cechastartKalend) && session.Global.Features.GetBool(cechastartKalend))
        {
            bool kalendarzWlasciwy = (pracownik[czasWejscia.Date].Etat.Kalendarz.SystemCzasuPracy == Kalendarz.SystemyCzasuPracy.Standardowy) || (pracownik[czasWejscia.Date].Etat.Kalendarz.SystemCzasuPracy == Kalendarz.SystemyCzasuPracy.Równoważny);

            if (session.Global.Features.Definitions.Contains(cechastart) && session.Global.Features.GetBool(cechastart) && kalendarzWlasciwy)
            {
                Dzien dzienPlanu = pracownik.Czasy.KalkPlanu[czasWejscia.Date];
                Time odGodzinyNorma = dzienPlanu.OdGodziny;
                DateTime normatywneOd = new DateTime(czasWejscia.Year, czasWejscia.Month, czasWejscia.Day, odGodzinyNorma.Hours, odGodzinyNorma.Minutes, 0);
                if (win.Godzina < odGodzinyNorma)
                {
                    wejscienormatywne = true;
                }
            }

            if (session.Global.Features.Definitions.Contains(cechastartTolerancja) && session.Global.Features.GetBool(cechastartTolerancja) && session.Global.Features.Definitions.Contains(cechaTolerancja) && kalendarzWlasciwy)
            {
                int iloscMinutSpoznienia = session.Global.Features.GetInt(cechaTolerancja);

                Dzien dzienPlanu = pracownik.Czasy.KalkPlanu[czasWejscia.Date];
                Time odGodzinyNorma = dzienPlanu.OdGodziny;
                DateTime normatywneOd = new DateTime(czasWejscia.Year, czasWejscia.Month, czasWejscia.Day, odGodzinyNorma.Hours, odGodzinyNorma.Minutes, 0); // czasWejscia.Hour, czasWejscia.Minute, 0);
                DateTime normatywneDoTolerancja = normatywneOd.AddMinutes(iloscMinutSpoznienia);

                Time odGodzinyToleracnja = new Time(normatywneDoTolerancja.Hour, normatywneDoTolerancja.Minute);
                if ((odGodzinyNorma < win.Godzina) && (win.Godzina < odGodzinyToleracnja))
                {
                    win.Godzina = odGodzinyNorma;
                }
                else
                {
                    if (wejscienormatywne)
                    {
                        win.Godzina = odGodzinyNorma;
                    }
                }
            }
        }
        else
        {
            if (session.Global.Features.Definitions.Contains(cechastartPrzedzial) && session.Global.Features.GetBool(cechastartPrzedzial))
            {
                Time przedzPrzed = session.Global.Features.GetTime(cechastartPrzedzialPrzed);
                Time przedzPo = session.Global.Features.GetTime(cechastartPrzedzialPo);

                Dzien dzienPlanu = pracownik.Czasy.KalkPlanu[czasWejscia.Date];
                Time odGodzinyNorma = dzienPlanu.OdGodziny;

                Time normatywnePrzed = odGodzinyNorma - przedzPrzed;
                Time normatywnePo = odGodzinyNorma + przedzPo;

                if ((win.Godzina >= normatywnePrzed) && (win.Godzina <= normatywnePo))
                {

                }
                else
                {
                    win.Godzina = odGodzinyNorma;
                }
            }
        }
			}
		}

		 public bool IsFateureGlobalExistAndCheck(Session session, string cecha)
     {

         return (session.Global.Features.Definitions.Contains(cecha) && session.Global.Features.GetBool(cecha));
     }

		 public bool IsStandGroupCalend(Pracownik pracownik, Date data)
     {

         return ((pracownik[data].Etat.Kalendarz.SystemCzasuPracy == Kalendarz.SystemyCzasuPracy.Standardowy) || (pracownik[data].Etat.Kalendarz.SystemCzasuPracy == Kalendarz.SystemyCzasuPracy.Równoważny));

     }

     public bool IsFateureGlobalExistAndNOTCheck(Session session, string cecha)
     {

         return (session.Global.Features.Definitions.Contains(cecha) && !session.Global.Features.GetBool(cecha));
     }


     public bool IsFateureGlobalExist(Session session, string cecha)
     {

         return session.Global.Features.Definitions.Contains(cecha);
     }
