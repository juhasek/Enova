		//Metoda daje możliwość zwrócenia innej godziny rozpoczęcia niż aktualna
		public DateTime DomyslnaGodzinaRozpoczecia(Soneta.Kadry.Pracownik pracownik, DateTime time)
		{
         //modyfikuje jeśli przed 7 rozpoczał prace to ma być 7

         string godzStart = "LCZPStart7";
         string cechastartKalend = "LCzPStartNormaKalend";
         if (IsFateureGlobalExistAndCheck(pracownik.Session, cechastartKalend))
         {
             bool kalendarzWlasciwy = (pracownik[time.Date].Etat.Kalendarz.SystemCzasuPracy == Soneta.Kalend.Kalendarz.SystemyCzasuPracy.Standardowy) || (pracownik[time.Date].Etat.Kalendarz.SystemCzasuPracy == Soneta.Kalend.Kalendarz.SystemyCzasuPracy.Równoważny);
             if (!kalendarzWlasciwy)  //tylko dla innych niż równoważny i podstawowy
             {
                 if (IsFateureGlobalExistAndCheck(pracownik.Session, godzStart))
                 {
                     DateTime godzinastartudnia = new DateTime(time.Year, time.Month, time.Day, 7, 0, 0);
                     if (time < godzinastartudnia)
                     {
                         time = godzinastartudnia;
                     }
                 }
             }
             else
             {
                 //nic się nie dzieje, przechodzimy do normalnego algorytmu w LicznikCzasuPracyTool
             }
         }
         else
         {
             if (IsFateureGlobalExistAndCheck(pracownik.Session, godzStart))
             {
                 DateTime godzinastartudnia = new DateTime(time.Year, time.Month, time.Day, 7, 0, 0);
                 if (time < godzinastartudnia)
                 {
                     time = godzinastartudnia;
                 }
             }


         }
			return time;
		}

