using System;
using Soneta.Types;
using Soneta.Business;
using Soneta.Kadry;
using Soneta.Kalend;
using Soneta.Tools;

namespace A1.Runtime.KadryPlace.WeryfikatoryKalendarza.TblCodeFiles {
	public class A1WeryfikatoryKalendarza
	{
		// Nadwyżkę trzeba wpisać jako "Praca poza normą" i "Nadgodziny do przeniesienia".
		// Strefa rozpoznawana po stałym Guid definicji (DefinicjaStrefy.Pracy), plan z KalkulatorPlanu.
		public static string A1PracaWNormieWgPlanu(DzienPracy dzien)
		{
			Pracownik pracownik = dzien.Pracownik;
			if (pracownik == null)
			{
				return null;
			}
			Time wNormie = Time.Zero;
			foreach (StrefaPracy strefa in dzien.Strefy)
			{
				if (strefa.Definicja != null && strefa.Definicja.Guid == DefinicjaStrefy.Pracy && strefa.Czas != Time.Empty)
					wNormie += strefa.Czas;
			}
			if (wNormie == Time.Zero)
			{
				return null;
			}
			Time plan = new KalkulatorPlanu(pracownik)[dzien.Data].Czas;
			if (plan == Time.Empty)
				plan = Time.Zero;
			if (wNormie > plan)
			{
				return "Dla dnia ({0}) w strefie Praca w normie wpisano ({1}), a plan przewiduje ({2}). Nadwyżkę ({3}) wpisz jako Praca poza normą i Nadgodziny do przeniesienia - {4}".TranslateFormat(dzien.Data, wNormie, plan, wNormie - plan, pracownik);
			}
			return null;
		}
	}
}
