// Przy ręcznym uzupełnianiu czasu pracy strefa "Praca w normie" nie może mieć więcej
// godzin niż plan dnia. Wywoływany z definicji weryfikatora kalendarza
// "A1_Praca w normie nie ponad plan" (rodzaj Dzień pracy), podpiętej jako Błąd.
//
// Metoda należy do klasy A1WeryfikatoryKalendarza, wspólnej dla weryfikatorów kalendarza
// (są w niej też inne metody, np. A1OkresZatrudnienia, A1NormaDobowa).
// Ten plik zawiera tylko tę metodę - wkleić ją do istniejącej klasy.
//
// Kod definicji weryfikatora:
//
// public override string Weryfikuj(Soneta.Kalend.DzienPracy dzien, WeryfikujEventArgs args) {
//      return A1.Runtime.KadryPlace.WeryfikatoryKalendarza.TblCodeFiles.A1WeryfikatoryKalendarza.A1PracaWNormieWgPlanu(dzien);
// }
