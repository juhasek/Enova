public static string WeryfikujNormeWOkresieRozliczeniowym(KalkulatorPlanuBase kalkulator, Date data)
{
	if (!(kalkulator.ZrodloPlanu is Pracownik pracownik))
	{
		return null;
	}
	Periods periods = pracownik.WyliczOkresRoliczeniowyNadgodzin(data).ToPeriods();

	KalkulatorKodeksowyPracownika kalkulatorKodeksowyPracownika = new KalkulatorKodeksowyPracownika(pracownik);
	CzasDni normaKodeksowa = CzasDni.Empty;
	foreach (FromTo item in periods)
	{
		normaKodeksowa += kalkulatorKodeksowyPracownika.Norma(item);
	}

	// Dni z jawnym wpisem w planie traktujemy jako ostatecznie zdecydowane (ich godzin nie da się już cofnąć).
	// Dni bez jawnego wpisu są wciąż elastyczne - mogą przyjąć dowolną wartość od zera do dobowego
	// maksimum wynikającego z systemu czasu pracy, więc same w sobie nie mogą jeszcze przesądzać o błędzie.
	var dniZJawnymWpisem = new System.Collections.Generic.HashSet<Date>();
	CzasDni sztywne = CzasDni.Empty;
	foreach (FromTo item in periods)
	{
		foreach (DzienPlanu dzien in kalkulator.ZrodloPlanu.GetPlanDniPlanu(item))
		{
			dniZJawnymWpisem.Add(dzien.Data);
			sztywne += kalkulator.Norma(new FromTo(dzien.Data, dzien.Data).ToPeriods());
		}
	}

	Time maksimumElastycznych = new Time(0, 0);
	foreach (FromTo item in periods)
	{
		for (Date dt = item.From; dt <= item.To; dt++)
		{
			if (dniZJawnymWpisem.Contains(dt))
			{
				continue;
			}
			bool rownowaznyCzasPracyDt = pracownik.Historia[dt].Etat.Kalendarz.RownowaznyCzasPracy;
			Time maxDzienDt = rownowaznyCzasPracyDt
				? new Time(12, 0)
				: pracownik.Historia[dt].Etat.Kalendarz.Nadgodziny.WartoscDobowa;
			maksimumElastycznych += maxDzienDt;
		}
	}

	Time minimalnyMozliwy = sztywne.Czas;
	Time maksymalnyMozliwy = sztywne.Czas + maksimumElastycznych;

	if (minimalnyMozliwy > normaKodeksowa.Czas)
	{
		return "Przekroczono limit godzin ({0}) o ({2}) w okresie rozliczeniowym ({1}) - {3}".TranslateFormat(normaKodeksowa.Czas, periods, minimalnyMozliwy - normaKodeksowa.Czas, pracownik);
	}
	if (maksymalnyMozliwy < normaKodeksowa.Czas)
	{
		return "Nie da się już osiągnąć normy godzin ({0}) w okresie rozliczeniowym ({1}), brakuje ({2}) - {3}".TranslateFormat(normaKodeksowa.Czas, periods, normaKodeksowa.Czas - maksymalnyMozliwy, pracownik);
	}
	return null;
}
