public override string Weryfikuj(Soneta.Kalend.DzienPlanu dp, WeryfikujEventArgs args)
{
    // 11-godzinny odpoczynek dobowy liczony W RAMACH JEDNEJ DOBY PRACOWNICZEJ (sztywne 24 h),
    // a NIE względem realnego początku pracy w kolejnej dobie (jak standardowy weryfikator Sonety).
    //
    // Doba pracownicza: okno [poczatekDoby ; poczatekDoby + 24h].
    //  poczatekDoby = początek "pracy w normie" w danym dniu;
    //       gdy w dniu brak pracy w normie (święto / sobota / niedziela / wolny za święto -
    //       jedyną strefą bywa wtedy Dyżur domowy) - początek najwcześniejszej strefy aktywności;
    //       gdy i tego brak - OdGodziny dnia.
    //  Strefy aktywności = strefy wliczane do doby wg Sonety (Wchodzi && Typ == Zwiększa)
    //       oraz strefy oznaczone cechą "Weryfikator11h" (Dyżur domowy).
    //       Uwzględniane są też wczesnoranne strefy dnia NASTĘPNEGO, jeśli ich początek
    //       wpada jeszcze w okno doby bieżącej (przesunięte o +24h na wspólną oś czasu).
    //  Naruszenie: największa ciągła przerwa w oknie doby jest < 11 h.
    //
    // Sprawdzamy dobę rozpoczętą w dniu bieżącym ORAZ w dniu poprzednim - komunikat o dobie
    // np. soboty ma się pojawić także podczas wprowadzania zapisów na niedzielę.
    //
    // Poziom (Error / Warning) ustawiany jest na powiązaniu kalendarza z weryfikatorem
    // (WeryfikatorKalendarza.Typ), nie w tym kodzie. Wg ustaleń z klientem: Error (blokuje zapis).

    Pracownik pracownik = dp.Pracownik;
    if (pracownik == null)
        return null;

    KalkulatorPlanu kalkulatorPlanu = new KalkulatorPlanu(pracownik);
    Time wymaganyOdpoczynek = new Time(11, 0);
    Time dlugoscDoby = new Time(24, 0);
    string komunikat = null;

    // przesuniecieDni = 0 -> doba rozpoczeta dzisiaj; -1 -> doba rozpoczeta wczoraj
    for (int przesuniecieDni = 0; przesuniecieDni >= -1; przesuniecieDni--)
    {
        Date dataDoby = dp.Data + przesuniecieDni;

        Dzien dzien = kalkulatorPlanu[dataDoby];
        if (dzien == null)
            continue;

        // --- Kotwica doby oraz zebranie stref aktywności tego dnia ---
        Time poczatekPracyWNormie = Time.Empty;
        Time poczatekPierwszejAktywnosci = Time.Empty;
        FromTimes strefyAktywnosci = FromTimes.Empty;

        foreach (IStrefaExt strefa in (IEnumerable<IStrefaExt>)dzien)
        {
            if (strefa.Definicja == null)
                continue;
            if (strefa.OdGodziny == Time.Empty || strefa.Czas == Time.Zero)
                continue;

            bool pracaWliczanaDoDoby = strefa.Definicja.Wchodzi && strefa.Definicja.Typ == TypStrefy.Zwieksza;
            bool dyzur = strefa.Definicja.Features.GetBool("Weryfikator11h");
            if (!pracaWliczanaDoDoby && !dyzur)
                continue;

            if (pracaWliczanaDoDoby && (poczatekPracyWNormie == Time.Empty || strefa.OdGodziny < poczatekPracyWNormie))
                poczatekPracyWNormie = strefa.OdGodziny;
            if (poczatekPierwszejAktywnosci == Time.Empty || strefa.OdGodziny < poczatekPierwszejAktywnosci)
                poczatekPierwszejAktywnosci = strefa.OdGodziny;

            strefyAktywnosci = strefyAktywnosci.Add(new FromTime(strefa.OdGodziny, strefa.Czas));
        }

        Time poczatekDoby;
        if (poczatekPracyWNormie != Time.Empty)
            poczatekDoby = poczatekPracyWNormie;
        else if (poczatekPierwszejAktywnosci != Time.Empty)
            poczatekDoby = poczatekPierwszejAktywnosci;
        else if (dzien.OdGodziny != Time.Empty)
            poczatekDoby = dzien.OdGodziny;
        else
            continue; // brak jakiejkolwiek aktywności w tej dobie - nie ma czego sprawdzać

        Time koniecDoby = poczatekDoby + dlugoscDoby;

        // --- Wczesnoranne strefy dnia następnego, wpadające w okno doby bieżącej ---
        // (np. sobota 8:00-21:00, niedziela od 7:00 -> fragment niedzieli 7:00-8:00
        // mieści się jeszcze w oknie doby sobotniej [8:00 sob ; 8:00 niedz]).
        // Przesunięte o +24h na wspólną oś czasu doby; przycięcie do [poczatekDoby;koniecDoby]
        // robi już logika klipowania poniżej.
        Dzien dzienNastepny = kalkulatorPlanu[dataDoby + 1];
        if (dzienNastepny != null)
        {
            foreach (IStrefaExt strefa in (IEnumerable<IStrefaExt>)dzienNastepny)
            {
                if (strefa.Definicja == null)
                    continue;
                if (strefa.OdGodziny == Time.Empty || strefa.Czas == Time.Zero)
                    continue;

                bool pracaWliczanaDoDobyNast = strefa.Definicja.Wchodzi && strefa.Definicja.Typ == TypStrefy.Zwieksza;
                bool dyzurNast = strefa.Definicja.Features.GetBool("Weryfikator11h");
                if (!pracaWliczanaDoDobyNast && !dyzurNast)
                    continue;

                strefyAktywnosci = strefyAktywnosci.Add(new FromTime(strefa.OdGodziny + dlugoscDoby, strefa.Czas));
            }
        }

        strefyAktywnosci = strefyAktywnosci.ToFlat();

        // --- Największa ciągła przerwa w oknie [poczatekDoby ; koniecDoby] ---
        Time najwiekszaPrzerwa = dlugoscDoby;   // gdy w oknie brak aktywności = pełny odpoczynek
        Time koniecPoprzedniejStrefy = poczatekDoby;
        bool bylaAktywnoscWOknie = false;
        foreach (FromTime strefa in strefyAktywnosci)
        {
            Time strefaOd = strefa.From < poczatekDoby ? poczatekDoby : strefa.From;
            Time strefaDo = strefa.To > koniecDoby ? koniecDoby : strefa.To;
            if (strefaDo <= strefaOd)
                continue; // strefa poza oknem doby

            Time przerwa = strefaOd > koniecPoprzedniejStrefy ? strefaOd - koniecPoprzedniejStrefy : Time.Zero;
            if (!bylaAktywnoscWOknie)
            {
                najwiekszaPrzerwa = przerwa;   // przerwa wiodąca (od poczatekDoby do pierwszej strefy)
                bylaAktywnoscWOknie = true;
            }
            else if (przerwa > najwiekszaPrzerwa)
            {
                najwiekszaPrzerwa = przerwa;   // przerwa między strefami
            }
            koniecPoprzedniejStrefy = strefaDo;
        }
        if (bylaAktywnoscWOknie)
        {
            Time przerwaKoncowa = koniecDoby > koniecPoprzedniejStrefy ? koniecDoby - koniecPoprzedniejStrefy : Time.Zero;
            if (przerwaKoncowa > najwiekszaPrzerwa)
                najwiekszaPrzerwa = przerwaKoncowa;   // przerwa końcowa (od ostatniej strefy do poczatekDoby + 24h)
        }

        if (najwiekszaPrzerwa < wymaganyOdpoczynek)
        {
            string dataTekst = dataDoby.Day.ToString("00") + "." + dataDoby.Month.ToString("00") + "." + dataDoby.Year.ToString();
            string linia = "W dobie pracowniczej rozpoczętej {0} nie zachowano wymaganego przepisami prawa pracy 11-godzinnego odpoczynku dobowego (najdłuższa przerwa w dobie: {1}). {2}"
                .TranslateFormat(dataTekst, najwiekszaPrzerwa, pracownik);
            komunikat = komunikat == null ? linia : komunikat + System.Environment.NewLine + linia;
        }
    }

    return komunikat;
}
