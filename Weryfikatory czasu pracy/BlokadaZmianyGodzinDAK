//----------------------------------------------------------------------------------
// Dodatkowy kod do kompilacji (System -> Dodatkowy kod do kompilacji)
// Blokada zmiany godzin pracy przez pracownika na dokumencie aktualizacji kalendarza
// (wersjonowanie kalendarzy). Wywoływany z definicji weryfikatorów kalendarza:
//   - "Blokada zmiany godzin przez pracownika - plan"       (rodzaj DzienPlanuAktualizacja)
//   - "Blokada zmiany godzin przez pracownika - czas pracy" (rodzaj DzienPracyAktualizacja)
//
// Metoda A1BlokadaGodzin należy do klasy A1WeryfikatoryKalendarza, wspólnej dla
// weryfikatorów kalendarza (są w niej też inne metody, np. A1OkresZatrudnienia).
// Ten plik zawiera tylko metodę blokady godzin - wkleić ją do istniejącej klasy.
//----------------------------------------------------------------------------------

using System;
using Soneta.Types;
using Soneta.Business;
using Soneta.Kalend;
using Soneta.Kadry;

namespace A1.Runtime.KadryPlace.WeryfikatoryKalendarza.TblCodeFiles {
	public class A1WeryfikatoryKalendarza
	{
		public static string A1BlokadaGodzin(Session session, IZrodloPlanu zrodlo, Date data)
		{
			Pracownik pracownik = zrodlo as Pracownik;
			if (pracownik == null)
				return null;
			if (!pracownik.JestZatrudnionyNaEtat(FromTo.Day(data)))
				return null;

			IWebUser uzytkownikWeb = session.Login.WebUserOperatingInstance;
			if (uzytkownikWeb == null)
				return null;
			
			Pracownik zalogowany = uzytkownikWeb.Host as Pracownik;
			if (zalogowany == null)
				return null;

			if (pracownik.Guid != zalogowany.Guid)
				return null;

			return string.Format("Nie możesz zmieniać godzin pracy (dzień {0}). Przywróć godziny pierwotnie wpisane", data);
		}
	}
}
