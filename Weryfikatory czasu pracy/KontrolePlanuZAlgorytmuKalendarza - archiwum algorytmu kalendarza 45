 }

 string Result(params string[] pars)
 {
     string result = null;
     foreach (string s in pars)
         Append(ref result, s);
     return result;
 }

 string FormatError(Pracownik pracownik, object obj, string msg)
 {
     if (msg == null || msg == "")
         return msg;
     string result = "";
     foreach (string s in msg.Split('\n'))
         if (s != "")
             Append(ref result, string.Format("{0}, {1}, {2}", pracownik, obj, s));
     return result;
 }

 static bool error = true;
 static string Error(string msg)
 {
     if (!error || msg == null || msg == "")
         return msg;
     return "!" + msg;
 }
        
void Trace(object value)
{
    Log log = new Log("Weryfikacja kalendarza");
    log.WriteLine(value == null ? "(null)" : value.ToString());
}
void Append(ref string s, string msg)
{
    if (msg != null && msg != "")
        if (s == null || s == "")
            s = msg;
        else
            s += "\n" + msg;
}
