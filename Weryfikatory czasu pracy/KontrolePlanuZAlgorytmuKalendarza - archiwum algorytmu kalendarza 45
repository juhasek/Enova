string KontrolaDobaPracownicza(KalkulatorPlanu kp, Date d)
{
    string result = null;
    Dzien dzisiaj = kp[d];
    if (dzisiaj.OdGodziny == Time.Empty)
        return null;
    Dzien wczoraj = kp[d - 1];
    if (wczoraj.OdGodziny != Time.Empty)
        if (wczoraj.OdGodziny > dzisiaj.OdGodziny)  //Wszystko ok o ile nie zaczynamy pracy wcześniej niż poprzedniego dnia.
            Append(ref result, "Zaplanowano czas pracy należący do poprzedniej doby pracowniczej. Poprzednia doba kończy się o godzine " + wczoraj.OdGodziny + ".");
    Dzien jutro = kp[d + 1];
    if (jutro.OdGodziny != Time.Empty)
        if (dzisiaj.OdGodziny > jutro.OdGodziny)        //Wszystko ok o ile nie zaczynamy pracy później niż następnego dnia.
            Append(ref result, "Zaplanowano czas pracy należący do następnej doby pracowniczej. Następna doba zaczyna się o godzine " + jutro.OdGodziny + ".");
    return result;
}

string KontrolaPrzerwy11h(KalkulatorPlanu kp, Date d)
{
    Dzien dzn = kp[d];
    FromTimes ft = FromTimes.Empty;
    foreach (IStrefa strefa in dzn)
        if (strefa.Definicja == null)
            return null;
        else if (strefa.Definicja.Wchodzi && strefa.Definicja.Typ == TypStrefy.Zwieksza && strefa.Czas != Time.Zero && strefa.OdGodziny != Time.Empty)
            ft = ft.Add(new FromTime(strefa));
    ft = ft.ToFlat();
    Time end = Time.Empty;
    foreach (FromTime f in ft)
    {
        if (end != Time.Empty)
            if ((f.From - end) >= new Time(11, 0))
                return null;
        end = f.To;
    }
    if (end == Time.Empty || dzn.OdGodziny + Time.Midnight - end >= new Time(11, 0))
        return null;
    return "Nie wprowadzono wymaganej przepisami prawa jedenastogodzinnej przerwy.";
}

string ControlWorkHoursForDisabled(KalkulatorPlanu kp, Date date)
{
    Kalendarz calendar = kp.Pracownik[date].Etat.Kalendarz;
    if (calendar == null)
        return null;
    Time plane = kp[date].Czas;
    if (plane == Time.Zero)
        return null;
    var pracownik = kp.Pracownik;
    foreach (var hist in pracownik.Historia)
    {
        if (date >= hist.StopienNiepelnosp.Okres.From && date <= hist.StopienNiepelnosp.Okres.To)
        {
            if (hist.StopienNiepelnosp.Stopien.ToString() == "Umiarkowany" || hist.StopienNiepelnosp.Stopien.ToString() == "Znaczny")
            {
                if (hist.Etat.PracownikNiepelnosprawnyZgodaNaPrace8h)
                {
                    if (new Time(8, 0) < plane)
                    {
                        return "Dla pracownika niepełnosprawnego zaplanowano czas pracy przekaczający dopuszczalną normę (08:00)";
                    }
                }
                else
                {
                    if (new Time(7, 0) < plane)
                    {
                        return "Dla pracownika niepełnosprawnego zaplanowano czas pracy przekaczający dopuszczalną normę (07:00)";
                    }
                }
            }
            if (hist.StopienNiepelnosp.Stopien.ToString() == "Lekki")
            {
                if (new Time(8, 0) < plane)
                {
                    return "Dla pracownika niepełnosprawnego zaplanowano czas pracy przekaczający dopuszczalną normę (08:00)";
                }
            }
        }
    }
    return null;
}


