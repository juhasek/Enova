 string ControlRequiredCountOfFreeOrHolidayDays(YearMonth month, Pracownik employee)
 {
     string result = null;
     int freeOrHolidayDaysOfMonthCount = 0;
     int freeOrHolidayDaysOfEmployeeCount = 0;
     foreach (Date d in month.ToFromTo())
     {
         if (Date.FreeOrHoliday(d))
         {
             freeOrHolidayDaysOfMonthCount++;
         }
     }
     KalkulatorPlanu kp = new KalkulatorPlanu(employee);
     foreach (Date d in month.ToFromTo())
     {
         Dzien day = kp[d];
         if (day.Definicja.Typ.ToString() == "Świąteczny" || day.Definicja.Typ.ToString() == "Wolny")
         {
             freeOrHolidayDaysOfEmployeeCount++;
         }
     }
     if (freeOrHolidayDaysOfEmployeeCount < freeOrHolidayDaysOfMonthCount)
     {
         Append(ref result, string.Format("Nie zaplanowano wymaganej liczby dni wolnych i świąt dla pracownika. Wymagane: {0}, zaplanowano: {1}", freeOrHolidayDaysOfMonthCount, freeOrHolidayDaysOfEmployeeCount));
     }
     return result;
 }

 string KontrolaPrzerwa35h(KalkulatorPlanu kp, YearMonth miesiąc)
 {
     string result = null;
     foreach (FromTo okres in OkresRozliczeniowy(kp.Pracownik, miesiąc))
     {
         Kalendarz k = kp.Pracownik[Date.Min(okres.To, miesiąc.LastDay)].Etat.Kalendarz;
         int m = k.Nadgodziny.Okres;
         FromTo teoretyczny = TeoretycznyOkresRozliczeniowy(m, miesiąc);
         FromTo sprawdzany = okres * teoretyczny;
         Date d = sprawdzany.From;
         while (d <= sprawdzany.To)
         {
             FromTo tydzień = new FromTo(d, d + 6);
             if (tydzień.To <= okres.To)
             {   //Sprawdzamy tylko gdy cały tydzień mieści się w okresie zatrudnienia
                 int dni = kp.Norma(tydzień).Dni;
                 if (dni == 7)
                     Append(ref result, string.Format("W  tygodniu '{0}' nie zaplanowano 35 godzinnej przerwy", tydzień));
             }
             d += 7;
         }
     }
     return result;
 }

 string KontrolaNormy8h(KalkulatorPlanu kp, YearMonth miesiąc)
 {
     string result = null;
     foreach (FromTo okres in OkresRozliczeniowy(kp.Pracownik, miesiąc))
     {
         Kalendarz k = kp.Pracownik[Date.Min(okres.To, miesiąc.LastDay)].Etat.Kalendarz;
         int m = k.Nadgodziny.Okres;
         FromTo teoretyczny = TeoretycznyOkresRozliczeniowy(m, miesiąc);
         FromTo sprawdzany = okres * teoretyczny;
         CzasDni norma = kp.Norma(sprawdzany);
         Time limit = new Time(8 * norma.Dni, 0);
         if (norma.Czas > limit)
             Append(ref result, string.Format("Zaplanowany w okresie ({0}) czas pracy ({1}) przekracza dopuszczalny 8 godzinny czas pracy ({2})", sprawdzany, norma.Czas, limit));
     }
     return result;
 }
        
string KontrolaNormyŚredniotygodniowej(KalkulatorPlanu kp, YearMonth miesiąc)
{
    string result = null;
    Periods okresy = OkresRozliczeniowy(kp.Pracownik, miesiąc);
    foreach (FromTo okres in okresy)
    {
        Kalendarz k = kp.Pracownik[Date.Min(okres.To, miesiąc.LastDay)].Etat.Kalendarz;
        int m = k.Nadgodziny.Okres;
        FromTo okresRozliczeniowy = TeoretycznyOkresRozliczeniowy(m, miesiąc) * okres;
        Time norma = NormaŚredniotygodniowa48h(kp, okresRozliczeniowy, false);
        Time plan = kp.Norma(okresRozliczeniowy).Czas;
        if (norma < plan)
            Append(ref result, string.Format("Zaplanowany w okresie ({0}) czas pracy ({1}) przekracza dopuszczalny średniotygodniowy czas pracy ({2})", okresRozliczeniowy, plan, norma));
    }
    return result;
}


Time NormaŚredniotygodniowa48h(KalkulatorPlanu kp, FromTo okres, bool obniżona)
{
    int dni = okres.Days;
    int tygodniePełne = dni / 7;
    Date d = okres.From + tygodniePełne * 7;
    Time normaNiepełne = Time.Zero;
    while (d <= okres.To)
    {
        if (d.DayOfWeek != DayOfWeek.Sunday && !Date.IsHoliday(d))
            normaNiepełne += new Time(obniżona ? 8 : 12, 0);
        d++;
    }
    normaNiepełne = Time.Min(normaNiepełne, new Time(obniżona ? 40 : 48, 0));
    Time normaPełne = new Time(tygodniePełne * (obniżona ? 40 : 48), 0);
    return normaPełne + normaNiepełne;
}

Periods OkresRozliczeniowy(Pracownik p, YearMonth miesiąc)
{
    Periods z = Periods.Empty;
    foreach (PracHistoria ph in p.Historia)
        z += ph.Etat.EfektywnyOkres;
    z = z.ToFlat();
    FromTo m = miesiąc.ToFromTo();
    Periods result = Periods.Empty;
    foreach (FromTo o in z)
        if (o.IsIntersected(m))
            result += o;
    return result;
}

FromTo TeoretycznyOkresRozliczeniowy(int c, YearMonth miesiąc)
{
    int m = miesiąc.Month;
    int r = miesiąc.Year;
    int b = ((m - 1) / c) * c + 1;
    int e = b + c - 1;
    return new FromTo(new YearMonth(r, b).FirstDay, new YearMonth(r, e).LastDay);
}

