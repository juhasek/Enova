//----------------------------------------------------------------------------------
// Dodatkowy kod do kompilacji (System -> Dodatkowy kod do kompilacji)
// Kontrole planu pracy przeniesione z zakładki Algorytm definicji kalendarza
// (SprawdźDzieńPlanu / SprawdźPlan) do definicji weryfikatorów kalendarza.
// Każda kontrola to osobna metoda, żeby na każdym kalendarzu dało się podpiąć
// tylko potrzebne kontrole z wybranym poziomem (Ostrzeżenie / Błąd).
//
//   Dzień planu (rodzaj 30) - wywołanie przy zapisie jednego dnia planu:
//     A1Praca12h, A1NormaDobowaNiepelnosprawnych
//   Plan pracy (rodzaj 40) - wywołanie dla miesiąca edytowanego dnia:
//     A1Przerwa11hWMiesiacu, A1DobaPracowniczaWMiesiacu, A1Praca12hWMiesiacu,
//     A1NormaDobowaNiepelnosprawnychWMiesiacu, A1NormaSredniotygodniowa48h,
//     A1OdpoczynekTygodniowy35h, A1DniWolneIswietaWMiesiacu,
//     A1PlanPonadNormeOkresuRozliczeniowego
//
// Metody należą do klasy A1WeryfikatoryKalendarza, wspólnej dla weryfikatorów
// kalendarza (są w niej też inne metody, np. A1OkresZatrudnienia).
// Ten plik zawiera tylko nowe metody - wkleić je do istniejącej klasy.
//----------------------------------------------------------------------------------

using System;
using Soneta.Types;
using Soneta.Business;
using Soneta.KadryPlace;
using Soneta.Kadry;
using Soneta.Kalend;
using Soneta.Tools;

namespace A1.Runtime.KadryPlace.WeryfikatoryKalendarza.TblCodeFiles {
	public class A1WeryfikatoryKalendarza
	{
		// ---------- Kontrole jednego dnia planu ----------

		// Odpoczynek dobowy 11h liczony w obrębie jednego dnia: największa przerwa między strefami
		// pracy albo czas od końca pracy do godziny rozpoczęcia tego dnia w dobie następnej.
		public static string A1Przerwa11h(KalkulatorPlanu kp, Date d)
		{
			Dzien dzn = kp[d];
			FromTimes ft = FromTimes.Empty;
			foreach (IStrefa strefa in dzn)
				if (strefa.Definicja == null)
					return null;
				else if (strefa.Definicja.Wchodzi && strefa.Definicja.Typ == TypStrefy.Zwieksza && strefa.Czas != Time.Zero && strefa.OdGodziny != Time.Empty)
					ft = ft.Add(new FromTime(strefa));
			ft = ft.ToFlat();
			Time end = Time.Empty;
			foreach (FromTime f in ft)
			{
				if (end != Time.Empty)
					if ((f.From - end) >= new Time(11, 0))
						return null;
				end = f.To;
			}
			if (end == Time.Empty || dzn.OdGodziny + Time.Midnight - end >= new Time(11, 0))
				return null;
			return "Nie wprowadzono wymaganej przepisami prawa jedenastogodzinnej przerwy.";
		}

		// Doba pracownicza: praca nie może zaczynać się wcześniej niż dnia poprzedniego
		// ani później niż dnia następnego.
		public static string A1DobaPracownicza(KalkulatorPlanu kp, Date d)
		{
			string result = null;
			Dzien dzisiaj = kp[d];
			if (dzisiaj.OdGodziny == Time.Empty)
				return null;
			Dzien wczoraj = kp[d - 1];
			if (wczoraj.OdGodziny != Time.Empty)
				if (wczoraj.OdGodziny > dzisiaj.OdGodziny)
					A1Dopisz(ref result, "Zaplanowano czas pracy należący do poprzedniej doby pracowniczej. Poprzednia doba kończy się o godzinie " + wczoraj.OdGodziny + ".");
			Dzien jutro = kp[d + 1];
			if (jutro.OdGodziny != Time.Empty)
				if (dzisiaj.OdGodziny > jutro.OdGodziny)
					A1Dopisz(ref result, "Zaplanowano czas pracy należący do następnej doby pracowniczej. Następna doba zaczyna się o godzinie " + jutro.OdGodziny + ".");
			return result;
		}

		// Norma dobowa osoby z niepełnosprawnością: 7h (umiarkowany/znaczny bez zgody na 8h) albo 8h.
		public static string A1NormaDobowaNiepelnosprawnych(KalkulatorPlanu kp, Date date)
		{
			Kalendarz calendar = kp.Pracownik[date].Etat.Kalendarz;
			if (calendar == null)
				return null;
			Time plane = kp[date].Czas;
			if (plane == Time.Zero)
				return null;
			foreach (var hist in kp.Pracownik.Historia)
			{
				if (date >= hist.StopienNiepelnosp.Okres.From && date <= hist.StopienNiepelnosp.Okres.To)
				{
					if (hist.StopienNiepelnosp.Stopien.ToString() == "Umiarkowany" || hist.StopienNiepelnosp.Stopien.ToString() == "Znaczny")
					{
						if (hist.Etat.PracownikNiepelnosprawnyZgodaNaPrace8h)
						{
							if (new Time(8, 0) < plane)
								return "Dla pracownika niepełnosprawnego zaplanowano czas pracy przekraczający dopuszczalną normę (08:00)";
						}
						else
						{
							if (new Time(7, 0) < plane)
								return "Dla pracownika niepełnosprawnego zaplanowano czas pracy przekraczający dopuszczalną normę (07:00)";
						}
					}
					if (hist.StopienNiepelnosp.Stopien.ToString() == "Lekki")
					{
						if (new Time(8, 0) < plane)
							return "Dla pracownika niepełnosprawnego zaplanowano czas pracy przekraczający dopuszczalną normę (08:00)";
					}
				}
			}
			return null;
		}

		// Plan dnia nie może przekraczać 12 godzin.
		public static string A1Praca12h(KalkulatorPlanu kp, Date d)
		{
			Dzien dzisiaj = kp[d];
			if (dzisiaj.OdGodziny == Time.Empty)
				return null;
			if (dzisiaj.Czas > new Time(12, 0))
				return "Zaplanowano czas pracy (" + dzisiaj.Czas.ToString() + ") przekraczający dopuszczalną normę godzinową (12:00)";
			return null;
		}

		// ---------- Te same kontrole dla wszystkich dni miesiąca (rodzaj Plan pracy) ----------

		public static string A1Przerwa11hWMiesiacu(Pracownik pracownik, YearMonth miesiąc)
		{
			return A1KontrolaDniMiesiaca(pracownik, miesiąc, A1Przerwa11h);
		}

		public static string A1DobaPracowniczaWMiesiacu(Pracownik pracownik, YearMonth miesiąc)
		{
			return A1KontrolaDniMiesiaca(pracownik, miesiąc, A1DobaPracownicza);
		}

		public static string A1NormaDobowaNiepelnosprawnychWMiesiacu(Pracownik pracownik, YearMonth miesiąc)
		{
			return A1KontrolaDniMiesiaca(pracownik, miesiąc, A1NormaDobowaNiepelnosprawnych);
		}

		public static string A1Praca12hWMiesiacu(Pracownik pracownik, YearMonth miesiąc)
		{
			return A1KontrolaDniMiesiaca(pracownik, miesiąc, A1Praca12h);
		}

		// ---------- Kontrole miesiąca / okresu rozliczeniowego (rodzaj Plan pracy) ----------

		// Plan w okresie rozliczeniowym nie może przekroczyć przeciętnie 48h tygodniowo.
		public static string A1NormaSredniotygodniowa48h(Pracownik pracownik, YearMonth miesiąc)
		{
			KalkulatorPlanu kp = new KalkulatorPlanu(pracownik);
			kp.LoadOkres(miesiąc.ToFromTo());
			string result = null;
			foreach (FromTo okres in A1OkresyZatrudnieniaWMiesiacu(pracownik, miesiąc))
			{
				Kalendarz k = pracownik[Date.Min(okres.To, miesiąc.LastDay)].Etat.Kalendarz;
				int m = k.Nadgodziny.Okres;
				FromTo okresRozliczeniowy = A1TeoretycznyOkresRozliczeniowy(m, miesiąc) * okres;
				Time norma = A1NormaSredniotygodniowa(okresRozliczeniowy, false);
				Time plan = kp.Norma(okresRozliczeniowy).Czas;
				if (norma < plan)
					A1Dopisz(ref result, string.Format("Zaplanowany w okresie ({0}) czas pracy ({1}) przekracza dopuszczalny średniotygodniowy czas pracy ({2})", okresRozliczeniowy, plan, norma));
			}
			return A1ZPracownikiem(pracownik, miesiąc, result);
		}

		// Odpoczynek tygodniowy 35h - w praktyce: ostrzeżenie, gdy w kolejnych 7 dniach
		// (liczonych od początku okresu rozliczeniowego) zaplanowano 7 dni pracy.
		public static string A1OdpoczynekTygodniowy35h(Pracownik pracownik, YearMonth miesiąc)
		{
			KalkulatorPlanu kp = new KalkulatorPlanu(pracownik);
			kp.LoadOkres(miesiąc.ToFromTo());
			string result = null;
			foreach (FromTo okres in A1OkresyZatrudnieniaWMiesiacu(pracownik, miesiąc))
			{
				Kalendarz k = pracownik[Date.Min(okres.To, miesiąc.LastDay)].Etat.Kalendarz;
				int m = k.Nadgodziny.Okres;
				FromTo teoretyczny = A1TeoretycznyOkresRozliczeniowy(m, miesiąc);
				FromTo sprawdzany = okres * teoretyczny;
				Date d = sprawdzany.From;
				while (d <= sprawdzany.To)
				{
					FromTo tydzień = new FromTo(d, d + 6);
					if (tydzień.To <= okres.To)
					{   // Sprawdzamy tylko gdy cały tydzień mieści się w okresie zatrudnienia
						int dni = kp.Norma(tydzień).Dni;
						if (dni == 7)
							A1Dopisz(ref result, string.Format("W tygodniu '{0}' nie zaplanowano 35 godzinnej przerwy", tydzień));
					}
					d += 7;
				}
			}
			return A1ZPracownikiem(pracownik, miesiąc, result);
		}

		// Liczba dni wolnych i świąt w planie nie może być mniejsza niż w miesiącu kalendarzowym.
		public static string A1DniWolneIswietaWMiesiacu(Pracownik pracownik, YearMonth miesiąc)
		{
			int dniWolneMiesiaca = 0;
			int dniWolnePracownika = 0;
			foreach (Date d in miesiąc.ToFromTo())
				if (Date.FreeOrHoliday(d))
					dniWolneMiesiaca++;
			KalkulatorPlanu kp = new KalkulatorPlanu(pracownik);
			kp.LoadOkres(miesiąc.ToFromTo());
			foreach (Date d in miesiąc.ToFromTo())
			{
				Dzien day = kp[d];
				if (day.Definicja.Typ.ToString() == "Świąteczny" || day.Definicja.Typ.ToString() == "Wolny")
					dniWolnePracownika++;
			}
			if (dniWolnePracownika < dniWolneMiesiaca)
				return A1ZPracownikiem(pracownik, miesiąc, string.Format("Nie zaplanowano wymaganej liczby dni wolnych i świąt dla pracownika. Wymagane: {0}, zaplanowano: {1}", dniWolneMiesiaca, dniWolnePracownika));
			return null;
		}

		// Plan w okresie rozliczeniowym nadgodzin nie może przekroczyć normy czasu pracy etatu
		// (CzasPracyEtatWorker: Norma = zaplanowano, Normatywny = dozwolone).
		public static string A1PlanPonadNormeOkresuRozliczeniowego(Pracownik pracownik, YearMonth miesiąc)
		{
			FromTo okres = pracownik.WyliczOkresRoliczeniowyNadgodzin(miesiąc.FirstDay);
			Soneta.Kalend._Pracownik.CzasPracyEtatWorker worker = new Soneta.Kalend._Pracownik.CzasPracyEtatWorker();
			worker.Pracownik = pracownik;
			worker.Okres = okres;
			if (worker.Norma.Czas > worker.Normatywny.Czas)
				return A1ZPracownikiem(pracownik, okres, string.Format("Zaplanowano czas pracy przekraczający normę czasu pracy w okresie rozliczeniowym. Dozwolone: {0}, zaplanowano: {1}", worker.Normatywny.Czas, worker.Norma.Czas));
			return null;
		}

		// ---------- Pomocnicze ----------

		// Kontrola dnia dla każdego dnia miesiąca, w którym pracownik ma efektywny etat.
		static string A1KontrolaDniMiesiaca(Pracownik pracownik, YearMonth miesiąc, Func<KalkulatorPlanu, Date, string> kontrola)
		{
			string result = null;
			KalkulatorPlanu kp = new KalkulatorPlanu(pracownik);
			kp.LoadOkres(miesiąc.ToFromTo());
			foreach (Date d in miesiąc.ToFromTo())
				if (pracownik[d].Etat.EfektywnyOkres.Contains(d))
					A1Dopisz(ref result, A1ZPracownikiem(pracownik, d, kontrola(kp, d)));
			return result;
		}

		static Time A1NormaSredniotygodniowa(FromTo okres, bool obniżona)
		{
			int dni = okres.Days;
			int tygodniePełne = dni / 7;
			Date d = okres.From + tygodniePełne * 7;
			Time normaNiepełne = Time.Zero;
			while (d <= okres.To)
			{
				if (d.DayOfWeek != DayOfWeek.Sunday && !Date.IsHoliday(d))
					normaNiepełne += new Time(obniżona ? 8 : 12, 0);
				d++;
			}
			normaNiepełne = Time.Min(normaNiepełne, new Time(obniżona ? 40 : 48, 0));
			Time normaPełne = new Time(tygodniePełne * (obniżona ? 40 : 48), 0);
			return normaPełne + normaNiepełne;
		}

		// Okresy zatrudnienia (efektywne okresy etatu) nachodzące na miesiąc.
		static Periods A1OkresyZatrudnieniaWMiesiacu(Pracownik p, YearMonth miesiąc)
		{
			Periods z = Periods.Empty;
			foreach (PracHistoria ph in p.Historia)
				z += ph.Etat.EfektywnyOkres;
			z = z.ToFlat();
			FromTo m = miesiąc.ToFromTo();
			Periods result = Periods.Empty;
			foreach (FromTo o in z)
				if (o.IsIntersected(m))
					result += o;
			return result;
		}

		// Okres rozliczeniowy c-miesięczny liczony od stycznia, zawierający miesiąc.
		static FromTo A1TeoretycznyOkresRozliczeniowy(int c, YearMonth miesiąc)
		{
			int m = miesiąc.Month;
			int r = miesiąc.Year;
			int b = ((m - 1) / c) * c + 1;
			int e = b + c - 1;
			return new FromTo(new YearMonth(r, b).FirstDay, new YearMonth(r, e).LastDay);
		}

		// Każda linia komunikatu poprzedzona pracownikiem i okresem/dniem.
		static string A1ZPracownikiem(Pracownik pracownik, object obj, string msg)
		{
			if (msg == null || msg == "")
				return msg;
			string result = "";
			foreach (string s in msg.Split('\n'))
				if (s != "")
					A1Dopisz(ref result, string.Format("{0}, {1}, {2}", pracownik, obj, s));
			return result;
		}

		static void A1Dopisz(ref string s, string msg)
		{
			if (msg != null && msg != "")
				if (s == null || s == "")
					s = msg;
				else
					s += "\n" + msg;
		}
	}
