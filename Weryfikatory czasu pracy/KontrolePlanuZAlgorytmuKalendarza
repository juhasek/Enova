		// Norma dobowa: limit = norma dobowa z etatu (Etat.NormaDobowa - pole na etacie, a gdy puste,
		// Nadgodziny.WartoscDobowa z kalendarza etatu); w równoważnym systemie czasu pracy
		// (RownowaznyCzasPracy na kalendarzu etatu) limit = 12h.
		public static string A1NormaDobowa(KalkulatorPlanuBase kalkulator, Date data)
		{
			if (!(kalkulator.ZrodloPlanu is Pracownik pracownik))
			{
				return null;
			}
			PracHistoria historia = pracownik[data];
			if (historia == null || historia.Etat.Kalendarz == null)
			{
				return null;
			}
			Time plan = kalkulator[data].Czas;
			if (plan == Time.Zero)
			{
				return null;
			}

			Kalendarz kalendarz = historia.Etat.Kalendarz;
			Time norma = kalendarz.RownowaznyCzasPracy ? new Time(12, 0) : historia.Etat.NormaDobowa;
			if (norma == Time.Zero || norma == Time.Empty)
			{
				return null;
			}

			if (plan > norma)
			{
				if (kalendarz.RownowaznyCzasPracy)
					return "Dla dnia ({0}) zaplanowano czas ({1}) przekraczający dopuszczalną normę dobową w równoważnym systemie czasu pracy ({2}) - {3}".TranslateFormat(data, plan, norma, pracownik);
				return "Dla dnia ({0}) zaplanowano czas ({1}) przekraczający dopuszczalną normę dobową ({2}) - {3}".TranslateFormat(data, plan, norma, pracownik);
			}
			return null;
		}

		// Norma dobowa osoby z niepełnosprawnością: umiarkowany/znaczny - 7h (8h przy zgodzie na pracę 8h na etacie),
		// lekki - 8h. Zgoda z zapisu historii obowiązującego w dniu; stopień z orzeczeń PFRON/ZUS obowiązujących
		// w dniu (Pracownik.StopienNiepelnosprawnosciNaDzien - wyższy z nich, okres jak w enova).
		public static string A1NormaDobowaNiepelnosprawnych(KalkulatorPlanuBase kalkulator, Date data)
		{
			if (!(kalkulator.ZrodloPlanu is Pracownik pracownik))
			{
				return null;
			}
			Time plan = kalkulator[data].Czas;
			if (plan == Time.Zero)
			{
				return null;
			}
			PracHistoria historia = pracownik[data];
			if (historia == null)
			{
				return null;
			}

			StNiepełnosprawności stopien = pracownik.StopienNiepelnosprawnosciNaDzien(data).Stopien;
			if (stopien == StNiepełnosprawności.Brak)
			{
				return null;
			}

			Time norma = new Time(8, 0);
			if ((stopien == StNiepełnosprawności.Umiarkowany || stopien == StNiepełnosprawności.Znaczny)
				&& !historia.Etat.PracownikNiepelnosprawnyZgodaNaPrace8h)
				norma = new Time(7, 0);

			if (plan > norma)
			{
				return "Dla dnia ({0}) zaplanowano czas ({1}) przekraczający dopuszczalną normę ({2}) dla osoby z niepełnosprawnością w stopniu {3} - {4}".TranslateFormat(data, plan, norma, stopien, pracownik);
			}
			return null;
		}


		// Brak zgody na pracę 8h: osoba ze stopniem umiarkowanym/znacznym bez zaznaczonego na etacie pola
		// „Zgoda na pracę 8h” nie może mieć zaplanowanych więcej niż 7h dziennie. Stopień i zgoda z zapisu
		// historii obowiązującego w dniu; stopień z orzeczeń PFRON/ZUS obowiązujących w dniu (StopienNiepelnosprawnosciNaDzien).
		public static string A1BrakZgodyNaPrace8h(KalkulatorPlanuBase kalkulator, Date data)
		{
			if (!(kalkulator.ZrodloPlanu is Pracownik pracownik))
			{
				return null;
			}
			Time plan = kalkulator[data].Czas;
			if (plan <= new Time(7, 0))
			{
				return null;
			}
			PracHistoria historia = pracownik[data];
			if (historia == null || historia.Etat.PracownikNiepelnosprawnyZgodaNaPrace8h)
			{
				return null;
			}

			StNiepełnosprawności stopien = pracownik.StopienNiepelnosprawnosciNaDzien(data).Stopien;
			if (stopien != StNiepełnosprawności.Umiarkowany && stopien != StNiepełnosprawności.Znaczny)
			{
				return null;
			}

			return "Dla dnia ({0}) zaplanowano czas ({1}), a pracownik bez zgody na pracę 8h (stopień niepełnosprawności {2}) może pracować maksymalnie 7:00 - {3}".TranslateFormat(data, plan, stopien, pracownik);
		}

		// ---------- Kontrole miesiąca / okresu rozliczeniowego (rodzaj Plan pracy) ----------

		// Plan w okresie rozliczeniowym nie może przekroczyć przeciętnie 48h tygodniowo.
		// Okres rozliczeniowy wg kalendarza pracownika (WyliczOkresRoliczeniowyNadgodzin), przycięty do zatrudnienia.
		// Limit: 48h za każdy pełny tydzień + 12h za każdy dzień niepełnego tygodnia (bez niedziel i świąt), maks. 48h.
		public static string A1NormaSredniotygodniowa48h(KalkulatorPlanuBase kalkulator, Date data)
		{
			if (!(kalkulator.ZrodloPlanu is Pracownik pracownik))
			{
				return null;
			}
			Periods periods = pracownik.WyliczOkresRoliczeniowyNadgodzin(data).ToPeriods();
			Periods pozaZatrudnieniem = Periods.Empty;
			foreach (FromTo item in periods)
			{
				pozaZatrudnieniem += item.ToPeriods() - kalkulator.ZrodloPlanu.GetPlanOkresZatrudnienia(item);
			}
			periods -= pozaZatrudnieniem;

			Time limit = Time.Zero;
			foreach (FromTo item in periods)
			{
				int tygodniePelne = item.Days / 7;
				Time limitNiepelnegoTygodnia = Time.Zero;
				for (Date dt = item.From + tygodniePelne * 7; dt <= item.To; dt++)
				{
					if (dt.DayOfWeek != DayOfWeek.Sunday && !Date.IsHoliday(dt))
						limitNiepelnegoTygodnia += new Time(12, 0);
				}
				limit += new Time(tygodniePelne * 48, 0) + Time.Min(limitNiepelnegoTygodnia, new Time(48, 0));
			}

			Time plan = kalkulator.Norma(periods).Czas;
			if (plan > limit)
			{
				return "Zaplanowany czas pracy ({0}) przekracza przeciętnie 48h tygodniowo ({1}) o ({2}) w okresie rozliczeniowym ({3}) - {4}".TranslateFormat(plan, limit, plan - limit, periods, pracownik);
			}
			return null;
		}

		// ---------- Zgody osoby z niepełnosprawnością: nadgodziny i pora nocna ----------
		// Dotyczy każdego stopnia niepełnosprawności (orzeczenie PFRON/ZUS obowiązujące w dniu,
		// Pracownik.StopienNiepelnosprawnosciNaDzien) - pola zgód na etacie enova udostępnia przy każdym stopniu.

		// Plan pracy w porze nocnej bez zgody na pracę w porze nocnej (Dzień planu, Błąd).
		// Pora nocna z kalendarza etatu (KalkulatorPracyBase.NocOkres), czas pracy = strefy wliczane do czasu pracy.
		public static string A1BrakZgodyNaPraceWNocyPlan(KalkulatorPlanuBase kalkulator, Date data)
		{
			if (!(kalkulator.ZrodloPlanu is Pracownik pracownik))
			{
				return null;
			}
			PracHistoria historia = pracownik[data];
			if (historia == null || historia.Etat.PracownikNiepelnosprawnyZgodaNaPraceWPorzeNocnej)
			{
				return null;
			}
			StNiepełnosprawności stopien = pracownik.StopienNiepelnosprawnosciNaDzien(data).Stopien;
			if (stopien == StNiepełnosprawności.Brak)
			{
				return null;
			}

			FromTimes praca = FromTimes.Empty;
			Time jawnieNocne = Time.Zero;
			foreach (Dzien.Strefa strefa in (System.Collections.Generic.IEnumerable<IStrefaExt>)kalkulator[data])
			{
				if (strefa.Definicja == null || strefa.Czas == Time.Empty || strefa.Czas == Time.Zero)
					continue;
				if (strefa.Definicja.Guid == DefinicjaStrefy.Nocne)
					jawnieNocne += strefa.Czas;
				else if (strefa.Definicja.Wchodzi && strefa.Definicja.Typ == TypStrefy.Zwieksza)
					praca = praca.Add((FromTime)strefa);
			}
			Time wNocy = A1CzasWPorzeNocnej(pracownik, historia, praca, jawnieNocne);
			if (wNocy > Time.Zero)
			{
				return "Dla dnia ({0}) zaplanowano pracę w porze nocnej ({1}), a pracownik z niepełnosprawnością (stopień {2}) nie ma na etacie zgody na pracę w porze nocnej - {3}".TranslateFormat(data, wNocy, stopien, pracownik);
			}
			return null;
		}

		// Czas pracy w porze nocnej bez zgody na pracę w porze nocnej (Dzień pracy, Ostrzeżenie).
		public static string A1BrakZgodyNaPraceWNocyCzasPracy(DzienPracy dzien)
		{
			Pracownik pracownik = dzien.Pracownik;
			if (pracownik == null)
			{
				return null;
			}
			PracHistoria historia = pracownik[dzien.Data];
			if (historia == null || historia.Etat.PracownikNiepelnosprawnyZgodaNaPraceWPorzeNocnej)
			{
				return null;
			}
			StNiepełnosprawności stopien = pracownik.StopienNiepelnosprawnosciNaDzien(dzien.Data).Stopien;
			if (stopien == StNiepełnosprawności.Brak)
			{
				return null;
			}

			FromTimes praca = FromTimes.Empty;
			Time jawnieNocne = Time.Zero;
			foreach (StrefaPracy strefa in dzien.Strefy)
			{
				if (strefa.Definicja == null || strefa.Czas == Time.Empty || strefa.Czas == Time.Zero)
					continue;
				if (strefa.Definicja.Guid == DefinicjaStrefy.Nocne)
					jawnieNocne += strefa.Czas;
				else if (strefa.Definicja.Wchodzi && strefa.Definicja.Typ == TypStrefy.Zwieksza)
					praca = praca.Add(new FromTime(strefa.OdGodziny, strefa.Czas));
			}
			Time wNocy = A1CzasWPorzeNocnej(pracownik, historia, praca, jawnieNocne);
			if (wNocy > Time.Zero)
			{
				return "Dla dnia ({0}) wpisano pracę w porze nocnej ({1}), a pracownik z niepełnosprawnością (stopień {2}) nie ma na etacie zgody na pracę w porze nocnej - {3}".TranslateFormat(dzien.Data, wNocy, stopien, pracownik);
			}
			return null;
		}

		// Praca w nadgodzinach bez zgody na pracę w godzinach nadliczbowych (Dzień pracy, Ostrzeżenie).
		// Nadgodziny = czas pracy dnia (strefy wliczane do czasu pracy) ponad większą z wartości: plan dnia,
		// norma dobowa z etatu (Etat.NormaDobowa); w dniu wolnym wg planu - każda praca.
		public static string A1BrakZgodyNaNadgodziny(DzienPracy dzien)
		{
			Pracownik pracownik = dzien.Pracownik;
			if (pracownik == null)
			{
				return null;
			}
			PracHistoria historia = pracownik[dzien.Data];
			if (historia == null || historia.Etat.PracownikNiepelnosprawnyZgodaNaPraceNadgodziny)
			{
				return null;
			}
			StNiepełnosprawności stopien = pracownik.StopienNiepelnosprawnosciNaDzien(dzien.Data).Stopien;
			if (stopien == StNiepełnosprawności.Brak)
			{
				return null;
			}

			Time praca = Time.Zero;
			foreach (StrefaPracy strefa in dzien.Strefy)
			{
				if (strefa.Definicja != null && strefa.Definicja.Wchodzi && strefa.Definicja.Typ == TypStrefy.Zwieksza
					&& strefa.Czas != Time.Empty)
					praca += strefa.Czas;
			}
			if (praca <= Time.Zero)
			{
				return null;
			}

			Time plan = new KalkulatorPlanu(pracownik)[dzien.Data].Czas;
			if (plan == Time.Empty)
				plan = Time.Zero;
			Time limit = Time.Zero;
			if (plan > Time.Zero)
			{
				limit = historia.Etat.NormaDobowa;
				if (limit == Time.Empty || plan > limit)
					limit = plan;
			}
			if (praca > limit)
			{
				return "Dla dnia ({0}) wpisano pracę w godzinach nadliczbowych ({1}; czas pracy {2}, limit dnia {3}), a pracownik z niepełnosprawnością (stopień {4}) nie ma na etacie zgody na pracę w nadgodzinach - {5}".TranslateFormat(dzien.Data, praca - limit, praca, limit, stopien, pracownik);
			}
			return null;
		}

		// Czas w porze nocnej: przecięcie stref pracy z porą nocną kalendarza etatu + jawna strefa "Praca w godzinach nocnych".
		private static Time A1CzasWPorzeNocnej(Pracownik pracownik, PracHistoria historia, FromTimes praca, Time jawnieNocne)
		{
			FromTimes noc = new KalkulatorPracownika(pracownik).KalkPracy.NocOkres(historia);
			if (noc == FromTimes.Empty || praca == FromTimes.Empty)
			{
				return jawnieNocne;
			}
			return praca.Intersection(noc).Time + jawnieNocne;
		}
	}	
}


