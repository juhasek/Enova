private FromTo GetOkresRozliczeniowy()
{
	Soneta.Web.Business.Workers.PracownikWebUserInfoWorker webInfo = new Soneta.Web.Business.Workers.PracownikWebUserInfoWorker();
	webInfo.Pracownik = Pracownik;
	
	var kalendarz = PobierzKalendarzPracownika();

	// Kontrola na null musi wyprzedzać użycie - inaczej leci NullReferenceException
	// zamiast czytelnego komunikatu. PL jest wersją domyślną, żeby przy innej kulturze UI
	// walidacja nie została po cichu pominięta.
	if (kalendarz == null)
	{
		if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
			throw new Exception("It is not possible to establish the employee's calendar.");

		throw new Exception("Nie można ustalić kalendarza pracownika.");
	}

	var okres = kalendarz.WyliczOkresRoliczeniowyNadgodzin(WniosekDzienOdbierany);

	if (okres == FromTo.Empty)
	{
		if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
			throw new Exception("Error in calculating the settlement period.");

		throw new Exception("Błąd wyliczania okresu rozliczeniowego.");
	}

	return okres;
}

private void SprawdzOkresRozliczeniowy()
{
	Soneta.Web.Business.Workers.PracownikWebUserInfoWorker webInfo = new Soneta.Web.Business.Workers.PracownikWebUserInfoWorker();
	webInfo.Pracownik = Pracownik;
	
	var okres = GetOkresRozliczeniowy();

	if (okres.Contains(WniosekDataOdbioru))
		return;
	 
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CulturePL)
		throw new Exception(
			$"Nie można wskazać dnia odbioru {WniosekDataOdbioru}, ponieważ dzień odbioru musi znajdować się w okresie rozliczeniowym, " +
			$"w którym wypada święto, tj. od {okres.From} do {okres.To}.");
			 
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
		throw new Exception(
			$"The collection date {WniosekDataOdbioru} cannot be selected, " + 
			$"as the collection date must fall within the settlement period that includes the holiday, i.e., from {okres.From} to {okres.To}.");
}

private void SprawdzDataZatrudnienia()
{
	var dataZatrudnienia = Pracownik.Last.Etat?.Okres.From;
	var dataZwolnienia = Pracownik.Last.Etat?.Okres.To;
	Soneta.Web.Business.Workers.PracownikWebUserInfoWorker webInfo = new Soneta.Web.Business.Workers.PracownikWebUserInfoWorker();
	webInfo.Pracownik = Pracownik;

	if (dataZatrudnienia == null)
	{
		if(webInfo.UICulture == Soneta.Tools.CoreTools.CulturePL)
			throw new Exception("Nie można ustalić daty zatrudnienia pracownika.");
	
		if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
			throw new Exception("It is not possible to determine the employee's employment date.");
	}


	if (dataZatrudnienia > WniosekDzienOdbierany)
	{
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CulturePL)
		throw new Exception(
			"Pracownik nie jest uprawniony do odbioru dnia wolnego, ponieważ został zatrudniony po święcie przypadającym w sobotę.");
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
		throw new Exception(
			"The employee is not entitled to take a day off because they were hired after the holiday falling on a Saturday.");
	}
	
	if (dataZwolnienia < WniosekDzienOdbierany)
	{
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CulturePL)
		throw new Exception(
			"Brak uprawnień do złożenia wniosku o odbiór dnia wolnego. Święto wypadające w sobotę jest poza okresem zatrudnienia.");
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
		throw new Exception(
			"No permission to submit a request for a day off. The holiday falling on a Saturday is outside the employment period.");
	}
	
	if (dataZwolnienia != Date.MaxValue && dataZwolnienia > WniosekDzienOdbierany)
	{
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CulturePL)
		throw new Exception(
			"Brak uprawnień do złożenia wniosku o odbiór dnia wolnego. Dzień odbioru dnia wolnego jest poza okresem zatrudnienia.");
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
		throw new Exception(
		$"No permission to submit a request for a day off. The date of the compensatory day off falls outside the period of employment.");
	}
	
}

