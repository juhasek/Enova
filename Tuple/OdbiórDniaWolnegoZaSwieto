			$"W wybranym dniu odbioru ({data}) zarejestrowano nieobecność. Konieczność przeprocesowania wniosku indywidualnym zgłoszeniem.");
	
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
		throw new Exception(
			$"It is not possible to change the collection day for the holiday because there is an absence on the current collection day ({data}). " +
			"The change must be processed through a separate request.");
}

//private void SprawdzNiedozwoloneStrefyNaStarymDniu(DzienKalendarzaBase dzien, Date data)
private void SprawdzNiedozwoloneStrefyNaStarymDniu(DzienPracy dzien, Date data)
{
	Soneta.Web.Business.Workers.PracownikWebUserInfoWorker webInfo = new Soneta.Web.Business.Workers.PracownikWebUserInfoWorker();
	webInfo.Pracownik = Pracownik;
		
	if (dzien == null)
		return;

	var strefa = dzien.Strefy
		.FirstOrDefault(x => StrefyNiedozwoloneNaStarym.Contains(x.Definicja.Nazwa));

	if (strefa == null)
		return;
	
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CulturePL)
		throw new Exception(
			$"Nie można zmienić dnia odbioru za święto, ponieważ na dotychczasowym dniu odbioru ({data}) występuje strefa '{strefa.Definicja.Nazwa}'. " +
			"Zmianę należy przeprocesować osobnym zgłoszeniem.");
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
		throw new Exception(
			$"It is not possible to change the collection day for the holiday because the current collection day ({data}) falls within the '{strefa.Definicja.Nazwa}' zone. " +
			"The change must be processed through a separate request.");
}

