            private void FormatMsg(TaskMessageEventArgs args, Pracownik pp,  Pracownik kk, bool email, string stan = "") {
            System.Globalization.CultureInfo ci = Soneta.Web.Business.Kadry.Tools.GetCultureInfo(pp ?? args.Task.TaskUser);
            string subject = string.Format(ci, "{0} {1} - {2}: {3}", string.IsNullOrEmpty(stan) ? CaptionAttribute.EnumToString(Stan, ci) : stan.Translate(null, ci), Definicja.GetLocalizedNazwa(ci).ToLower(ci), Pracownik, WniosekDataOdbioru);
            string powodOdrzucenia = string.IsNullOrEmpty(PowodOdrzucenia) ? string.Empty : "\nPowód odrzucenia: " + PowodOdrzucenia + "\n";
            string body = string.Format(ci, "{0} {1} - {2}: {3}\n{4}{5}", string.IsNullOrEmpty(stan) ? CaptionAttribute.EnumToString(Stan, ci) : stan.Translate(null, ci), Definicja.GetLocalizedNazwa(ci).ToLower(ci), Pracownik, WniosekDataOdbioru, WniosekOpis, powodOdrzucenia);
            args["@subject"] = subject;
            args["@body"] = body;
            args["@to"] = "";
            if (!email) return;
            string emailTo =  "";
            if (pp.Last != null && pp.Last.Kontakt != null && !string.IsNullOrEmpty(pp.Last.Kontakt.EMAIL.Trim()))
            emailTo = pp.Last.Kontakt.EMAIL.Trim();

            if (kk?.Last != null && kk.Last.Kontakt != null && !string.IsNullOrEmpty(kk.Last.Kontakt.EMAIL.Trim()))
            emailTo += (string.IsNullOrEmpty(emailTo) ? "" : ";" )+  kk.Last.Kontakt.EMAIL.Trim();

            if(!string.IsNullOrEmpty(emailTo))
            args["@to"] = emailTo;
            else
            args.Cancel = true;
            }

