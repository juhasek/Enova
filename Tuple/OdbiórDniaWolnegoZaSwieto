private bool CzyDzienWolnyZaSwieto(string nazwa)
{
	return nazwa == "Wolny za święto z dyżurem" || nazwa == "Wolny za święto" || nazwa == "Dzień wolny za święto";
}

private Date ZnajdzDzienOdbieranyWNormie()
{
	if (PobierzKalendarzPracownika() == null)
		return Date.Empty;

	var okres = GetOkresRozliczeniowy();

	if (okres == FromTo.Empty)
		return Date.Empty;

	// 1. Kalendarz pracownika - obejmuje dzień wprowadzony ręcznie na Normie czasu pracy.
	var data = ZnajdzDzienWKalendarzuPracownika(okres);

	if (data != Date.Empty)
		return data;

	// 2. Definicja kalendarza - wzorzec, na którym opierało się wyszukiwanie przed poprawką.
	return ZnajdzDzienWDefinicjiKalendarza(okres);
}

// KalkulatorPlanu zwraca dzień efektywny dla pracownika, więc widzi również dzień
// wprowadzony indywidualnie, którego nie ma w dniach wzorca kalendarza.
private Date ZnajdzDzienWKalendarzuPracownika(FromTo okres)
{
	var kalkPlanu = new KalkulatorPlanu(Pracownik);

	for (Date data = okres.From; data <= okres.To; data = data.AddDays(1))
	{
		if (data == WniosekDzienOdbierany)
			continue;

		var dzien = kalkPlanu[data];

		if (dzien == null || dzien.Definicja == null)
			continue;

		if (CzyDzienWolnyZaSwieto(dzien.Definicja.Nazwa))
			return data;
	}

	return Date.Empty;
}

private Date ZnajdzDzienWDefinicjiKalendarza(FromTo okres)
{
	var kalendarz = PobierzKalendarzPracownika();

	if (kalendarz == null)
		return Date.Empty;

	var dzien = Session.GetKalend()
		.DniKalendarza
		.WgKalendarz[kalendarz]
		.FirstOrDefault(x =>
			okres.Contains(x.Data) &&
			x.Data != WniosekDzienOdbierany &&
			x.Definicja != null &&
			CzyDzienWolnyZaSwieto(x.Definicja.Nazwa));

	return dzien?.Data ?? Date.Empty;
}

