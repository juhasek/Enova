					"Zmianę należy przeprocesować osobnym zgłoszeniem.");
			if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
					throw new Exception(
					$"It is not possible to indicate the day {data} as the new collection day for the holiday because the day falls zone '{strefa.Definicja.Nazwa}'. " +
					"The change must be processed through a separate request.");
		}
	}


}

