{
	Date dataNowa = WniosekDataOdbioru;
	Date dataStara = GetPoprzedniaDataOdbioru();

	if (dataStara == Date.Empty)
		return;

	var kalendarz = PobierzKalendarzPracownika();
	if (kalendarz == null)
		return;

	var dniKalendarza = Session.GetKalend().DniKalendarza.WgKalendarz[kalendarz];

	//var dzienStary = this.Pracownik.DniPlanu[dataStara] as DzienPlanu ;// dniKalendarza.FirstOrDefault(x => x.Data == dataStara);
	//var dzienNowy = this.Pracownik.DniPlanu[dataNowa] as DzienPlanu;//dniKalendarza.FirstOrDefault(x => x.Data == dataNowa);
	
	//zmiana 25.06 TK - należy sprawdzać Czas pracy a nie plan pracy
	var dzienStary = this.Pracownik.DniPracy[dataStara] as DzienPracy;
	var dzienNowy = this.Pracownik.DniPracy[dataNowa] as DzienPracy;

	SprawdzNieobecnoscNaStarymDniu(dataStara);
	SprawdzNiedozwoloneStrefyNaStarymDniu(dzienStary, dataStara);

	SprawdzNieobecnoscNaNowymDniu(dataNowa);
	SprawdzNiedozwoloneStrefyNaNowymDniu(dzienNowy, dataNowa);
}

private void SprawdzNieobecnoscNaStarymDniu(Date data)
{
	Soneta.Web.Business.Workers.PracownikWebUserInfoWorker webInfo = new Soneta.Web.Business.Workers.PracownikWebUserInfoWorker();
	webInfo.Pracownik = Pracownik;
	
	if (!CzyJestNieobecnosc(Pracownik, data))
		return;
	
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CulturePL)
		throw new Exception(
			$"Nie można zmienić dnia odbioru za święto, ponieważ na dotychczasowym dniu odbioru ({data}) występuje nieobecność. " +
			"Zmianę należy przeprocesować osobnym zgłoszeniem.");
	
	if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
		throw new Exception(
			$"It is not possible to change the collection day for the holiday because there is an absence on the current collection day ({data}). " +
			"The change must be processed through a separate request.");	
}

private void SprawdzNieobecnoscNaNowymDniu(Date data)
{
	Soneta.Web.Business.Workers.PracownikWebUserInfoWorker webInfo = new Soneta.Web.Business.Workers.PracownikWebUserInfoWorker();
	webInfo.Pracownik = Pracownik;
	
	if (!CzyJestNieobecnosc(Pracownik, data))
