private void SprawdzCzyDataNieJestWsteczna()
{
	Soneta.Web.Business.Workers.PracownikWebUserInfoWorker webInfo = new Soneta.Web.Business.Workers.PracownikWebUserInfoWorker();
	webInfo.Pracownik = Pracownik;
	var okres = GetOkresRozliczeniowy();
	
	if (!okres.Contains(this.WniosekDataOdbioru))
	{
		if(webInfo.UICulture == Soneta.Tools.CoreTools.CulturePL)
			throw new Exception(
				$"Nie można wskazać dnia odbioru {WniosekDataOdbioru}, " + 
				$"ponieważ dzień odbioru musi znajdować się w okresie rozliczeniowym, w którym wypada święto tj. od {okres.From} do {okres.To}.");
		if(webInfo.UICulture == Soneta.Tools.CoreTools.CultureEN)
			throw new Exception(
				$"The collection date {WniosekDataOdbioru} cannot be selected, " +
				$"as the collection date must fall within the settlement period that includes the holiday, i.e., from {okres.From} to {okres.To}.");
	}
}

