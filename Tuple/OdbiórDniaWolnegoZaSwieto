private void SprawdzNiedozwoloneStrefyNaNowymDniu(DzienPracy dzien, Date data)
{
	Soneta.Web.Business.Workers.PracownikWebUserInfoWorker webInfo = new Soneta.Web.Business.Workers.PracownikWebUserInfoWorker();
	webInfo.Pracownik = Pracownik;
	
	if (dzien == null)
		return;

	//var strefa = dzien.Strefy
	//	.FirstOrDefault(x => !StrefyDozwoloneNaNowym.Contains(x.Definicja.Nazwa));
	
	foreach(StrefaPracy strefa in dzien.Strefy)
	{
		if (strefa == null)
