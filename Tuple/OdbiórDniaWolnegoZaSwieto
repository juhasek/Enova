// Przywraca poprzedni dzień odbioru jako dzień pracy i usuwa jego Czas pracy.
// Modyfikacja idzie w sesji BIEŻĄCEJ, w transakcji obiegu - osobna sesja zapisywała te same
// rekordy, które sesja główna trzymała i zaraz potem zapisywała, co kończyło się komunikatem
// o równoczesnej zmianie danych. Zapis wykonuje sesja główna, bez własnego Save().
private void OznaczPoprzedniDzienPlanu()
{
	if (PoprzedniWyznaczonyDzien == Date.Empty)
		return;

	Date data = this.PoprzedniWyznaczonyDzien;

	using (var t = Session.Logout(true))
	{
		DzienPlanu dzienPlanu = this.Pracownik.DniPlanu[data] as DzienPlanu;

		if (dzienPlanu == null)
		{
			dzienPlanu = new DzienPlanu(this.Pracownik, data);
			KalendModule.GetInstance(Session).DniKalendarza.AddRow(dzienPlanu);
		}

		dzienPlanu.Definicja = Session.GetKalend().DefinicjeDni[DefinicjaDnia.Pracy];

		t.Commit();
	}

	// Norma jest już ustawiona, więc dopiero teraz Czas pracy da się zainicjować zgodnie z nią.
	InicjujCzasPracyZNormy(data);
}

// Oba dni zmieniane przez wniosek mają pozostać zainicjowane w Kalendarz/Czas pracy
// (żółty DzienPracy), tak jak reszta miesiąca z Karty czasu pracy. Rekord DzienPracy jest
// zakładany, jeśli go nie ma, a jego strefy odtwarzane z aktualnej Normy:
//  - nowy dzień odbioru: Norma nie ma stref, więc dzień zostaje zainicjowany na 0:00,
//  - poprzedni dzień odbioru: wraca strefa pracy zgodna z Normą.
// DzienPracy nie ma własnej definicji dnia - typ dnia bierze się z Normy.
private void InicjujCzasPracyZNormy(Date data)
{
	if (data == Date.Empty)
		return;

	// Norma dnia. Czytamy z rootu DzienPlanu (OdGodziny/Czas są tam kalkulowane i uwzględniają
	// definicję dnia); subrow Praca rekordu Normy bywa pusty, bo godziny wynikają z definicji.
	DzienPlanu dzienNormy = this.Pracownik.DniPlanu[data] as DzienPlanu;
	Time czasNormy = dzienNormy == null ? Time.Zero : dzienNormy.Czas;

	using (var t = Session.Logout(true))
	{
		DzienPracy dzienPracy = this.Pracownik.DniPracy[data] as DzienPracy;

		if (czasNormy == Time.Zero)
		{
			// Dzień wolny wg Normy. Ewidencja wymaga godzin pracy (Praca.OdGodziny jest polem
			// wymaganym), więc DzienPracy nie może dla takiego dnia istnieć - kasujemy go.
			if (dzienPracy != null)
				dzienPracy.Delete();

			t.Commit();
			return;
		}

		if (dzienPracy == null)
		{
			dzienPracy = Session.AddRow(new DzienPracy(this.Pracownik, data));
		}
		else
		{
			UsunStrefyDniaPracy(dzienPracy);
		}

		// Godziny ustawia się na subrowie Praca - OdGodziny/Czas na samym dniu są kalkulowane.
		dzienPracy.Praca.OdGodziny = dzienNormy.OdGodziny;
		dzienPracy.Praca.Czas = czasNormy;

		t.Commit();
	}
}

private void UsunStrefyDniaPracy(DzienPracy dzienPracy)
{
	// Kolekcję trzeba przepisać przed kasowaniem - nie modyfikujemy jej w trakcie iteracji.
	var strefy = new List<StrefaPracy>();

	foreach (StrefaPracy strefa in dzienPracy.Strefy)
		strefy.Add(strefa);

	foreach (StrefaPracy strefa in strefy)
		strefa.Delete();
}


public string A1GetDzienPracyInfo(Pracownik pracownik, Date data)
{
	if (pracownik == null || data.IsNull)
	{
		return string.Empty;
	}
	
	var dzienPracy = this.Pracownik.DniPracy[data] as DzienPracy;
	Dzien dzien = new KalkulatorPracownika(pracownik).KalkPracy[data];
	string text = string.Empty;
	
		//if (dzien == null || (dzien.Czas == Time.Zero && dzien.Nieobecności == null))
		if (dzien == null && dzien.Nieobecności == null)
		{
				dzien = new KalkulatorPlanu(pracownik)[data];
		}
		if (dzien.Definicja.Typ != TypDnia.Pracy)
		{
			text += "Dzień wolny lub świąteczny".Translate();
		}
		else if (dzien.Czas == null)
		{
			if (dzien.Nieobecności != null)
			{
				Nieobecnosc[] nieobecności = dzien.Nieobecności;
				foreach (Nieobecnosc nieobecnosc in nieobecności)
				{
					text += string.Format("N: {0}", ((nieobecnosc.Definicja != null) ? nieobecnosc.Definicja.GetLocalizedNazwa() : "?") + Environment.NewLine);
				}
			}
		}
		else
		{
			foreach (IStrefaExt item in (IEnumerable<IStrefaExt>)dzien)
			{
				text += string.Format("{0} {1} {2}".TranslateIgnore(), item.Definicja.GetLocalizedNazwa(), item.OdGodziny.IsNull ? $"({item.Czas.ToString()})" : string.Format("({0} .. {1})", item.OdGodziny.ToString(), (item.OdGodziny + item.Czas).ToString("+", System.Globalization.CultureInfo.InvariantCulture)), Environment.NewLine);
			}
			if (dzien.Nieobecności != null)
			{
				Nieobecnosc[] nieobecności = dzien.Nieobecności;
				foreach (Nieobecnosc nieobecnosc2 in nieobecności)
				{
					text += string.Format("N: {0} {1} {2}", (nieobecnosc2.Definicja != null) ? nieobecnosc2.Definicja.GetLocalizedNazwa() : "?", $"({nieobecnosc2.OdGodziny.ToString()} .. {nieobecnosc2.DoGodziny})", Environment.NewLine);
				}
			}
		}
	
	return text.TrimEnd(Environment.NewLine.ToCharArray());
}
