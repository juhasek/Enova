public static void AktualizujOkresDoUczestnictwaWAkcji(Session session)
{
	var uczestnictwa = AkcjePracA1Module.GetInstance(session).UczestnictwoWAkcji;

	foreach (UczestnictwoWAkcji uczestnictwo in uczestnictwa)
	{
		// Pracownik może mieć kilka wierszy UczestnictwoWAkcji (różne edycje akcji w historii) -
		// zmieniamy tylko aktualną edycję, czyli wiersz, którego Okres obejmuje dzisiejszą datę.
		if (!uczestnictwo.Okres.Contains(Date.Today))
			continue;

		Pracownik pracownik = uczestnictwo.Pracownik;
		if (pracownik == null)
			continue;

		// pracownik.Last zwraca ostatni wg Lp Etat, niekoniecznie ten obowiązujący dziś (np. po zmianie
		// stanowiska w trakcie zatrudnienia) - bierzemy Etat aktualny "na dziś" z historii.
		var dataZakonczeniaUmowy = pracownik.Historia[Date.Today].Etat.OkresZatrudnienia.To;

		// Brak Etatu albo umowa bezterminowa (Okres.To == Date.MaxValue) - OkresTo zostaje bez zmian.
		if (dataZakonczeniaUmowy == null || dataZakonczeniaUmowy == Date.MaxValue)
			continue;

		// Data końca umowy sprzed początku bieżącej edycji akcji (AktualnoscFrom) dałaby framework'owi
		// nieprawidłowy zakres dat przy zapisie (OkresDo przelicza też AktualnoscDo) - pomijamy taki wiersz.
		if (dataZakonczeniaUmowy < uczestnictwo.AktualnoscFrom)
			continue;

		if (uczestnictwo.OkresTo == dataZakonczeniaUmowy)
			continue;

		try
		{
			uczestnictwo.OkresTo = (Date)dataZakonczeniaUmowy;
		}
		catch (Exception ex)
		{
			// Diagnostyka do wyjaśnienia "Błędny zakres dat" - pokazuje w raporcie błędu Enova,
			// który dokładnie pracownik/wiersz/edycja i jakie daty brały udział w próbie zapisu.
			throw new Exception(
				$"Błąd przy ustawianiu OkresTo dla UczestnictwoWAkcji Guid={uczestnictwo.Guid}, " +
				$"Pracownik={pracownik} (Guid={pracownik.Guid}), EdycjaAkcji={uczestnictwo.EdycjaAkcji}, " +
				$"OkresFrom={uczestnictwo.OkresFrom}, OkresTo(przed)={uczestnictwo.OkresTo}, " +
				$"AktualnoscFrom={uczestnictwo.AktualnoscFrom}, AktualnoscTo(przed)={uczestnictwo.AktualnoscTo}, " +
				$"nowa data (koniec umowy)={dataZakonczeniaUmowy}, " +
				$"EtatOkresZatrudnienia={pracownik.Historia[Date.Today].Etat.OkresZatrudnienia}: {ex.Message}",
				ex);
		}
	}

	session.Save();
}
