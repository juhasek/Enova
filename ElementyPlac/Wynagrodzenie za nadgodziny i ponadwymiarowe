// Wynagrodzenie (100%) za całą pracę ponad plan pracownika - jeden element zamiast dwóch:
//  - nadgodziny wg silnika enova (NadgodzinyDobaOkres.Razem) - jak w poprzedniej wersji,
//  - NIEPEŁNY ETAT ze stawką MIESIĘCZNĄ: dodatkowo godziny ponadwymiarowe, czyli praca ponad plan,
//    ale jeszcze w normie pełnego etatu (np. 1/2 etatu, plan 4h, praca 12h: 4h ponadwymiarowe + 4h nadgodzin).
//    Silnik nie liczy ich jako nadgodzin, więc po zmianie z 04.09 (Czas = zestNad.Razem) nie były płacone.
//  - stawka GODZINOWA: tylko nadgodziny, bo godziny ponadwymiarowe płaci już wynagrodzenie zasadnicze
//    za przepracowany czas (do potwierdzenia na pracowniku testowym - patrz opis .md).
// Dodatki 50%/100% za nadgodziny liczą osobne elementy - ten element ich nie zmienia.
// Zabezpieczenie przed podwójną wypłatą (problem z 04.09: ten sam okres na dwóch listach):
// od czasu odejmowane są godziny wypłacone już tym samym elementem za ten okres na innych wypłatach.

public void Wynagrodzenie_Za_Nadgodziny_Param(Soneta.Place.WypElementDodatekAutomatyczny Element, WypSkladnik Składnik) {
    Składnik.Podstawa1 = StawkaZaszeregowaniaNorm1h(Element.Okres.To);

    Time normaDobowa = Element.PracHistoria.Etat.Kalendarz.Nadgodziny.WartoscDobowa;
    Fraction wymiar = Element.Pracownik.Historia[Element.OkresListy.To].Etat.Wymiar;
    Time norma = KalkulatorKodeksowy.NormaWym(wymiar, normaDobowa, Element.Okres).Czas;

    decimal suma = 0;
    foreach (WypElement e in Element.Elementy[Element.Okres]) {
        if (e.Definicja.Features.GetBool("WliczajDoNadgodzin") == true) {
            if (e.Definicja.Nazwa == "Dodatek funkcyjny") {
                suma += e.WartośćNominalna;
                Element.ZapisObliczen.Add($"Nazwa elementu {e.Nazwa} kwota {e.WartośćNominalna}");
            }
            else {
                suma += e.Wartosc;
                Element.ZapisObliczen.Add($"Nazwa elementu {e.Nazwa} kwota {e.Wartosc}");
            }
        }
    }

    Składnik.Podstawa2 = suma;
    if (norma != Time.Zero)
        Składnik.Podstawa2 /= norma;

    DoubleCy a = NajniższeWynagrodzenieNorm1h(Element.Okres.To);
    DoubleCy b = Składnik.Podstawa1;
    DoubleCy c = Składnik.Podstawa2;
    DoubleCy podstawa1 = DoubleCy.Max(a, b + c);
    Składnik.Podstawa3 = podstawa1;

    // --- Czas do zapłaty ---
    ZestawienieNadgodzin zestNad = NadgodzinyDobaOkres(Element, Składnik);
    Time nadgodziny = zestNad.Razem;
    Time ponadwymiarowe = Time.Zero;

    Fraction wymiarEtatuOkresu = Element.PracHistoria.Etat.Wymiar;
    bool niepelnyEtat = wymiarEtatuOkresu < Fraction.One;
    bool stawkaMiesieczna = Element.PracHistoria.Etat.Zaszeregowanie.RodzajStawki == RodzajStawkiZaszeregowania.Miesieczna;

    Odchylka odchylka = Element.Pracownik.Czasy.KalkPracy.Odchylki(Składnik.Okres);
    Time pracaPonadPlan = Time.Max(odchylka.Plus - odchylka.Minus, Time.Zero);

    if (niepelnyEtat && stawkaMiesieczna)
        ponadwymiarowe = Time.Max(pracaPonadPlan - nadgodziny, Time.Zero);

    Time czasDoZaplaty = nadgodziny + ponadwymiarowe;

    // godziny już wypłacone tym elementem za ten sam okres na innych wypłatach (bez storn i wystornowanych)
    Time juzWyplacone = Time.Zero;
    foreach (WypElement wczesniejszy in Element.Pracownik.Elementy[Składnik.Okres]) {
        if (wczesniejszy == Element)
            continue;
        if (wczesniejszy.Definicja != Element.Definicja)
            continue;
        if (wczesniejszy.Wyplata == Element.Wyplata)
            continue;
        foreach (WypSkladnik skladnikWczesniejszy in wczesniejszy.Skladniki) {
            if (skladnikWczesniejszy.Okres.IsIntersected(Składnik.Okres)) {
                juzWyplacone += skladnikWczesniejszy.Czas;
                Element.ZapisObliczen.Add($"Już wypłacone na wypłacie {wczesniejszy.Wyplata}: {skladnikWczesniejszy.Czas}");
            }
        }
    }

    Składnik.Czas = Time.Max(czasDoZaplaty - juzWyplacone, Time.Zero);

    Element.ZapisObliczen.Add("########################");
    Element.ZapisObliczen.Add($"Norma {norma}");
    Element.ZapisObliczen.Add($"Stawka 1h z minimalnego {a}");
    Element.ZapisObliczen.Add($"Stawka 1h ze stawki zaszeregowania {b}");
    Element.ZapisObliczen.Add($"Stawka 1h z dodatków {c}");
    Element.ZapisObliczen.Add($"Stawka 1h do nadgodzin {podstawa1}");
    Element.ZapisObliczen.Add($"Wymiar etatu {wymiarEtatuOkresu}, stawka miesięczna: {stawkaMiesieczna}");
    Element.ZapisObliczen.Add($"Praca ponad plan (odchyłki plus - minus) {pracaPonadPlan}");
    Element.ZapisObliczen.Add($"Nadgodziny wg silnika {nadgodziny}");
    Element.ZapisObliczen.Add($"Godziny ponadwymiarowe {ponadwymiarowe}");
    Element.ZapisObliczen.Add($"Już wypłacone za ten okres {juzWyplacone}");
    Element.ZapisObliczen.Add($"Czas do zapłaty {Składnik.Czas}");
}

public Currency Wynagrodzenie_Za_Nadgodziny_Wylicz(Soneta.Place.WypElementDodatekAutomatyczny Element, WypSkladnik Składnik) {
    return (Składnik.Podstawa3 * Składnik.Czas);
}
