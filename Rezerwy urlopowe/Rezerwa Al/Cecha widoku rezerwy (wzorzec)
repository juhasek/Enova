public __TYP__ Get___METODA__(Context cx) {
	// Kolumna widoku rezerwy urlopowej na liście Pracownicy.
	// Miesiąc rezerwy = miesiąc daty aktualności listy.
	Date data = ActualDate.Today(cx);

	// Ostatnio naliczona pozycja elementu "__ELEMENT__" pracownika na planowanej liście płac za ten miesiąc
	PlaceModule place = PlaceModule.GetInstance(Session);
	PlanowanyElementWypłaty e = null;
	foreach (PlanowanyElementWypłaty p in place.PlanElementyWyp.WgPracownik[(Pracownik)Row]) {
		if (p.Definicja == null || p.Definicja.Nazwa != "__ELEMENT__")
			continue;
		if (p.Okres.To.Year != data.Year || p.Okres.To.Month != data.Month)
			continue;
		if (e == null || p.ID > e.ID)
			e = p;
	}
	if (e == null)
		return 0m;
	return System.Math.Round(__WYRAZENIE__, 2);
}
