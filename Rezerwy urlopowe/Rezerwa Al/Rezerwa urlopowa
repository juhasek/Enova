public void %NAZWA%_Param(Soneta.Place.WypElementDodatekAutomatyczny Element, WypSkladnik Składnik) {
    // ---------------------------------------------------------------------------------
    // REZERWA URLOPOWA / BUDŻET REZERWY URLOPOWEJ
    // Ten sam kod w dwóch definicjach elementu:
    //   "Rezerwa urlopowa"          - stan na koniec miesiąca planu
    //   "Budżet rezerwy urlopowej"  - stan urlopu na 01.01 roku następnego (symulacja limitu)
    // Tryb rozpoznawany po nazwie definicji (nazwa zaczynająca się od "Budżet").
    //
    // Wynik zapisywany w składniku (kopiowany na planowaną listę płac):
    //   Podstawa1 = podstawa 1 - średnia miesięczna z 3 miesięcy (zasadnicze + zmienne do ekwiwalentu)
    //   Podstawa2 = podstawa 2 - podstawa miesięczna wg standardu enova (ekwiwalent za urlop)
    //   Podstawa3 = urlop zaległy (dni)
    //   Podstawa4 = urlop bieżący proporcjonalny (dni)  / budżet: limit należny na rok następny
    //   Podstawa5 = urlop wykorzystany do końca miesiąca (dni) / budżet: 0
    //   Czas      = godziny rezerwy (zaległy + bieżący - wykorzystany)
    //   Ilosc     = stawka za 1 godzinę urlopu przyjęta do kwoty (pomocniczo dla _Wylicz)
    // Narzuty pracodawcy liczy silnik płacowy (deklaracje ZUS jak dla ekwiwalentu).
    //
    // ZAPIS OBLICZEŃ: log pisany klasą Log z kategorią "Rezerwa urlopowa". Silnik zbiera go sam,
    // jeśli w definicji elementu (Algorytm → Zapis obliczeń) wpisana jest ta kategoria.
    //   "Rezerwa urlopowa"        - tylko log rezerwy
    //   "Rezerwa urlopowa,Urlop"  - dodatkowo pełny log standardowego ekwiwalentu (podstawa 2)
    // ---------------------------------------------------------------------------------

    // Która podstawa decyduje o kwocie rezerwy:
    //   1 = podstawa 1 (średnia z 3 miesięcy), 2 = podstawa 2 (standard enova), 3 = wyższa z obu
    int WARIANT_PODSTAWY = 1;
    // true  = wynagrodzenie zasadnicze nominalne z kartoteki (stawka zaszeregowania) za każdy z 3 miesięcy,
    // false = zasadnicze faktycznie naliczone na listach płac (pomniejszone o nieobecności)
    bool ZASADNICZE_NOMINALNE = true;

    Składnik.Podstawa1 = DoubleCy.Zero;
    Składnik.Podstawa2 = DoubleCy.Zero;
    Składnik.Podstawa3 = DoubleCy.Zero;
    Składnik.Podstawa4 = DoubleCy.Zero;
    Składnik.Podstawa5 = DoubleCy.Zero;
    Składnik.Czas = Time.Zero;
    Składnik.Ilosc = 0;

    // Rezerwa powstaje WYŁĄCZNIE na planowanej liście płac (moduł rezerw).
    // Na zwykłej liście płac element daje 0 i nie jest generowany (Generuj zerowy = Nie).
    if (!PlanowaneWynagrodzenie)
        return;

    Log log = new Log("Rezerwa urlopowa");
    bool trybBudzetu = Element.Definicja.Nazwa.StartsWith("Budżet");

    FromTo miesiacRezerwy = new YearMonth(Element.Okres.To);
    Date koniecMiesiacaRezerwy = miesiacRezerwy.To;
    int rokRezerwy = koniecMiesiacaRezerwy.Year;
    Pracownik pracownik = Element.Pracownik;
    PracHistoria historiaPracownika = pracownik[koniecMiesiacaRezerwy];

    log.WriteLine($"=== {Element.Definicja.Nazwa.ToUpper()} {rokRezerwy}/{koniecMiesiacaRezerwy.Month:00} - {pracownik} ===");

    // Rezerwa tylko dla pracowników zatrudnionych na ostatni dzień miesiąca
    // (zwolnionym urlop rozlicza się ekwiwalentem na liście głównej).
    if (historiaPracownika == null || !historiaPracownika.Etat.OkresZatrudnienia.Contains(koniecMiesiacaRezerwy)) {
        log.WriteLine($"Pracownik niezatrudniony na {koniecMiesiacaRezerwy} - pominięty.");
        return;
    }

    PlaceModule place = PlaceModule.GetInstance(Element.Session);

    double wymiarEtatu = (double)historiaPracownika.Etat.Wymiar;
    if (wymiarEtatu <= 0)
        wymiarEtatu = 1;

    // Godzin w dniu urlopu - tak samo jak w standardowym ekwiwalencie enova (8 h albo norma dobowa kalendarza)
    double normaDobowaGodzin = 8.0;
    if (place.Config.Nieobecności.EkwiwalentZaUrlop.PrzliczenieDniNaGodzWgKalendarza && historiaPracownika.Etat.Kalendarz != null)
        normaDobowaGodzin = historiaPracownika.Etat.Kalendarz.NormaDobowa.TotalHours;
    if (normaDobowaGodzin <= 0)
        normaDobowaGodzin = 8.0;
    // godzin urlopu na jeden dzień urlopu tego pracownika (z wymiarem etatu) - do przeliczania godzin na dni
    double godzinNaDzienUrlopu = normaDobowaGodzin * wymiarEtatu;

    // ---------------- ELEMENTY WYPŁAT Z 3 MIESIĘCY PODSTAWY (jeden przebieg) ----------------
    // indeks 0 = miesiąc rezerwy (M), 1 = M-1, 2 = M-2
    Date[] poczatekMiesiaca = new Date[3];
    Date[] koniecMiesiaca = new Date[3];
    for (int numerMiesiaca = 0; numerMiesiaca < 3; numerMiesiaca++) {
        int miesiacLiczony = rokRezerwy * 12 + (koniecMiesiacaRezerwy.Month - 1) - numerMiesiaca;
        poczatekMiesiaca[numerMiesiaca] = new Date(miesiacLiczony / 12, miesiacLiczony % 12 + 1, 1);
        FromTo okresMiesiaca = new YearMonth(poczatekMiesiaca[numerMiesiaca]);
        koniecMiesiaca[numerMiesiaca] = okresMiesiaca.To;
    }
    bool[] jestWyplataWMiesiacu = new bool[3];
    double[] zasadniczeNaliczoneWMiesiacu = new double[3];
    List<WypElement>[] skladnikiZmienneWMiesiacu = new List<WypElement>[] { new List<WypElement>(), new List<WypElement>(), new List<WypElement>() };
    foreach (WypElement elementWyplaty in place.WypElementy.WgPracownik[pracownik]) {
        if (elementWyplaty.Definicja == null || elementWyplaty.Definicja == Element.Definicja)
            continue;
        Date koniecOkresuElementu = elementWyplaty.Okres.To;
        if (koniecOkresuElementu < poczatekMiesiaca[2] || koniecOkresuElementu > koniecMiesiaca[0])
            continue;
        int numerMiesiaca = koniecOkresuElementu >= poczatekMiesiaca[0] ? 0 : (koniecOkresuElementu >= poczatekMiesiaca[1] ? 1 : 2);
        if (elementWyplaty.RodzajZrodla == RodzajŹródłaWypłaty.Etat) {
            jestWyplataWMiesiacu[numerMiesiaca] = true;
            zasadniczeNaliczoneWMiesiacu[numerMiesiaca] += (double)elementWyplaty.Wartosc;
        }
        else if (elementWyplaty.Definicja.Nieobecnosci.Ekwiwalent.Typ != TypPodstawyUrlopu.NieWliczać)
            skladnikiZmienneWMiesiacu[numerMiesiaca].Add(elementWyplaty);
    }

    // Silnik planu usuwa niezatwierdzone wypłaty przed naliczeniem, chyba że zaznaczono
    // "Uwzględniaj niezatwierdzone listy płac" - wtedy za miesiąc rezerwy nie ma wypłaty.
    if (!jestWyplataWMiesiacu[0])
        log.WriteLine($"UWAGA: brak wypłaty za {rokRezerwy}/{koniecMiesiacaRezerwy.Month:00} (lista niezatwierdzona lub nienaliczona) - podstawa 1 pominie ten miesiąc, standard (podstawa 2) naliczy go na nowo.");

    // ---------------- 1. STAN URLOPU (godziny) ----------------
    double zaleglyGodzin = 0, biezacyGodzin = 0, wykorzystanyGodzin = 0;
    Guid[] definicjeLimitowUrlopu = new Guid[] { Soneta.Kalend.DefinicjaLimitu.UrlopWypoczynkowy, Soneta.Kalend.DefinicjaLimitu.UrlopDodatkowy };
    log.WriteLine("[1] STAN URLOPU");
    using (log.IncrementIndent()) {
        if (!trybBudzetu) {
            KalendModule kalend = KalendModule.GetInstance(Element.Session);
            Date poczatekRoku = new Date(rokRezerwy, 1, 1);
            Date koniecRoku = new Date(rokRezerwy, 12, 31);
            foreach (Guid guidDefinicji in definicjeLimitowUrlopu) {
                Soneta.Kalend.DefinicjaLimitu definicjaLimitu = kalend.DefinicjeLimitow[guidDefinicji];
                if (definicjaLimitu == null)
                    continue;
                Soneta.Kalend.LimitNieobecnosci pierwszyLimitRoku = null;
                double biezacyKolejnyUrlopGodzin = 0, biezacyPierwszyUrlopGodzin = 0;
                foreach (Soneta.Kalend.LimitNieobecnosci limit in kalend.LimNieobecnosci.WgPracownik[pracownik, definicjaLimitu]) {
                    if (limit.Okres.To < poczatekRoku || limit.Okres.From > koniecRoku)
                        continue;
                    if (pierwszyLimitRoku == null || limit.Okres.From < pierwszyLimitRoku.Okres.From)
                        pierwszyLimitRoku = limit;
                    // należny proporcjonalnie: miesiące okresu limitu do końca miesiąca rezerwy / miesiące okresu limitu
                    Date poczatekLimitu = limit.Okres.From < poczatekRoku ? poczatekRoku : limit.Okres.From;
                    Date koniecLimitu = limit.Okres.To > koniecRoku ? koniecRoku : limit.Okres.To;
                    Date koniecLimituDoRezerwy = koniecLimitu > koniecMiesiacaRezerwy ? koniecMiesiacaRezerwy : koniecLimitu;
                    int miesiecyLimitu = (koniecLimitu.Year * 12 + koniecLimitu.Month) - (poczatekLimitu.Year * 12 + poczatekLimitu.Month) + 1;
                    int miesiecyDoRezerwy = (koniecLimituDoRezerwy.Year * 12 + koniecLimituDoRezerwy.Month) - (poczatekLimitu.Year * 12 + poczatekLimitu.Month) + 1;
                    if (miesiecyLimitu <= 0 || miesiecyDoRezerwy <= 0)
                        continue;
                    double naleznyGodzin = (limit.LimitGodz + limit.ZmianaGodz - limit.WykorzystanyPoprzGodz).TotalHours;
                    if (limit.PierwszyUrlop)
                        biezacyPierwszyUrlopGodzin += naleznyGodzin * miesiecyDoRezerwy / miesiecyLimitu;
                    else
                        biezacyKolejnyUrlopGodzin += naleznyGodzin * miesiecyDoRezerwy / miesiecyLimitu;
                    string rodzajUrlopu = limit.PierwszyUrlop ? "pierwszy urlop" : "kolejny urlop";
                    log.WriteLine($"Limit {definicjaLimitu.Nazwa} {limit.Okres} ({rodzajUrlopu}): należny {naleznyGodzin:0.00} h x {miesiecyDoRezerwy}/{miesiecyLimitu} mies.");
                }
                // kolejny urlop: część proporcjonalną zaokrąglamy w górę do pełnego dnia; pierwszy urlop - bez zaokrąglenia
                if (biezacyKolejnyUrlopGodzin > 0) {
                    double dniPoZaokragleniu = System.Math.Ceiling(System.Math.Round(biezacyKolejnyUrlopGodzin / godzinNaDzienUrlopu, 6));
                    log.WriteLine($"Kolejny urlop: {biezacyKolejnyUrlopGodzin / godzinNaDzienUrlopu:0.00} dni -> zaokrąglone w górę {dniPoZaokragleniu:0} dni = {dniPoZaokragleniu * godzinNaDzienUrlopu:0.00} h");
                    biezacyKolejnyUrlopGodzin = dniPoZaokragleniu * godzinNaDzienUrlopu;
                }
                biezacyGodzin += biezacyKolejnyUrlopGodzin + biezacyPierwszyUrlopGodzin;
                if (pierwszyLimitRoku != null)
                    zaleglyGodzin += pierwszyLimitRoku.PrzeniesienieGodz.TotalHours;
                // wykorzystany od 01.01 do końca miesiąca rezerwy (nieobecności pomniejszające ten limit)
                foreach (OkresNieobecności nieobecnosc in pracownik.Czasy.Nieobecnosci(new FromTo(poczatekRoku, koniecMiesiacaRezerwy), true)) {
                    if (nieobecnosc.Definicja != null && nieobecnosc.Definicja.Limit == definicjaLimitu)
                        wykorzystanyGodzin += nieobecnosc.Norma().Czas.TotalHours;
                }
            }
        }
        else {
            // BUDŻET: symulacja limitu na 01.01 roku następnego w osobnej, NIEZAPISYWANEJ sesji
            // (te same procedury co "Limity nieobecności / Nalicz"; po zamknięciu sesji nic nie trafia do bazy).
            int rokBudzetu = rokRezerwy + 1;
            Date poczatekRokuBudzetu = new Date(rokBudzetu, 1, 1);
            Date koniecRokuBudzetu = new Date(rokBudzetu, 12, 31);
            using (Session sesjaSymulacji = Element.Session.Login.CreateSession(false, false)) {
                Pracownik pracownikWSymulacji = sesjaSymulacji.Get(pracownik);
                KalendModule kalendSymulacji = KalendModule.GetInstance(sesjaSymulacji);
                foreach (Guid guidDefinicji in definicjeLimitowUrlopu) {
                    Soneta.Kalend.DefinicjaLimitu definicjaLimitu = kalendSymulacji.DefinicjeLimitow[guidDefinicji];
                    if (definicjaLimitu == null)
                        continue;
                    try {
                        Soneta.Kalend.NaliczanieLimitow.Params parametryNaliczania = new Soneta.Kalend.NaliczanieLimitow.Params(Context.Empty.Clone(sesjaSymulacji));
                        parametryNaliczania.Definicja = definicjaLimitu;
                        parametryNaliczania.Okres = FromTo.Year(rokBudzetu);
                        new Soneta.Kalend.NaliczanieLimitowUrlopowych().DodajLimit(parametryNaliczania, pracownikWSymulacji, new Log("Symulacja limitu", false));
                    }
                    catch (Exception blad) {
                        log.WriteLine($"Symulacja limitu {definicjaLimitu.Nazwa} - błąd: {blad.Message}");
                    }
                    Soneta.Kalend.LimitNieobecnosci pierwszyLimitRoku = null;
                    foreach (Soneta.Kalend.LimitNieobecnosci limit in kalendSymulacji.LimNieobecnosci.WgPracownik[pracownikWSymulacji, definicjaLimitu]) {
                        if (limit.Okres.To < poczatekRokuBudzetu || limit.Okres.From > koniecRokuBudzetu)
                            continue;
                        if (pierwszyLimitRoku == null || limit.Okres.From < pierwszyLimitRoku.Okres.From)
                            pierwszyLimitRoku = limit;
                        double naleznyGodzin = (limit.LimitGodz + limit.ZmianaGodz - limit.WykorzystanyPoprzGodz).TotalHours;
                        biezacyGodzin += naleznyGodzin;
                        log.WriteLine($"Symulacja {definicjaLimitu.Nazwa} {limit.Okres}: należny {naleznyGodzin:0.00} h");
                    }
                    if (pierwszyLimitRoku != null)
                        zaleglyGodzin += pierwszyLimitRoku.PrzeniesienieGodz.TotalHours;
                }
                // sesja NIE jest zapisywana (brak sesjaSymulacji.Save())
            }
        }

        double stanUrlopuGodzin = zaleglyGodzin + biezacyGodzin - wykorzystanyGodzin;
        string opisZaleglego = trybBudzetu ? $"Zaległy na 01.01.{rokRezerwy + 1}" : "Zaległy";
        string opisBiezacego = trybBudzetu ? $"Limit na rok {rokRezerwy + 1}" : "Bieżący proporcjonalny";
        string opisWykorzystanego = trybBudzetu ? "Wykorzystany" : $"Wykorzystany do {koniecMiesiacaRezerwy}";
        log.WriteLine($"{"",-32}{"godz.",10}{"dni",10}");
        log.WriteLine($"{opisZaleglego,-32}{zaleglyGodzin,10:0.00}{zaleglyGodzin / godzinNaDzienUrlopu,10:0.00}");
        log.WriteLine($"{opisBiezacego,-32}{biezacyGodzin,10:0.00}{biezacyGodzin / godzinNaDzienUrlopu,10:0.00}");
        log.WriteLine($"{opisWykorzystanego,-32}{wykorzystanyGodzin,10:0.00}{wykorzystanyGodzin / godzinNaDzienUrlopu,10:0.00}");
        log.WriteLine($"{"Do rezerwy",-32}{stanUrlopuGodzin,10:0.00}{stanUrlopuGodzin / godzinNaDzienUrlopu,10:0.00}");
        if (stanUrlopuGodzin < 0)
            log.WriteLine("Ujemny stan urlopu - rezerwa = 0.");
    }
    double godzinRezerwy = System.Math.Max(0, zaleglyGodzin + biezacyGodzin - wykorzystanyGodzin);

    // ---------------- 2. WSPÓŁCZYNNIK DO EKWIWALENTU ----------------
    // Zawsze z konfiguracji (Płace → Nieobecności → Średnia norma miesięczna na koniec miesiąca rezerwy).
    // Brak współczynnika (0) = rezerwa 0 - element nie powstaje.
    double wspolczynnikEkwiwalentu = (double)place.Config.Nieobecności.ŚredniaNormaMiesięczna[koniecMiesiacaRezerwy];
    double wspolczynnikWgWymiaru = wspolczynnikEkwiwalentu * wymiarEtatu;
    log.WriteLine($"[2] WSPÓŁCZYNNIK: {wspolczynnikEkwiwalentu:0.00} x wymiar {historiaPracownika.Etat.Wymiar} = {wspolczynnikWgWymiaru:0.00}; {normaDobowaGodzin:0.00} h w dniu urlopu");
    if (wspolczynnikEkwiwalentu <= 0) {
        log.WriteLine($"UWAGA: brak współczynnika do ekwiwalentu w konfiguracji na {koniecMiesiacaRezerwy} - rezerwa = 0.");
        return;
    }

    // ---------------- 3. PODSTAWA 1 - średnia z 3 miesięcy (M, M-1, M-2) z naliczoną wypłatą ----------------
    log.WriteLine("[3] PODSTAWA 1 (średnia z miesięcy z wypłatą)");
    double sumaPodstawy1 = 0;
    int miesiecyPodstawy1 = 0;
    double podstawa1, podstawa1ZaGodzine;
    using (log.IncrementIndent()) {
        for (int numerMiesiaca = 0; numerMiesiaca < 3; numerMiesiaca++) {
            string opisMiesiaca = $"{poczatekMiesiaca[numerMiesiaca].Year}/{poczatekMiesiaca[numerMiesiaca].Month:00}";
            FromTo okresMiesiaca = new FromTo(poczatekMiesiaca[numerMiesiaca], koniecMiesiaca[numerMiesiaca]);
            PracHistoria historiaWMiesiacu = pracownik[koniecMiesiaca[numerMiesiaca]];
            if (historiaWMiesiacu == null || !historiaWMiesiacu.Etat.OkresZatrudnienia.Contains(koniecMiesiaca[numerMiesiaca])) {
                log.WriteLine($"{opisMiesiaca}   brak zatrudnienia - pominięty");
                continue;
            }
            // tak jak w podstawie 2: do średniej wchodzą tylko miesiące z naliczoną wypłatą (zasadnicze za ten miesiąc)
            if (!jestWyplataWMiesiacu[numerMiesiaca]) {
                log.WriteLine($"{opisMiesiaca}   brak wypłaty - pominięty");
                continue;
            }
            // miesiąc niepełnego zatrudnienia: zasadnicze i zmienne w wartości nominalnej (za pełny miesiąc)
            FromTo zatrudnienieWMiesiacu = historiaWMiesiacu.Etat.OkresZatrudnienia * okresMiesiaca;
            bool niepelnyMiesiac = zatrudnienieWMiesiacu != okresMiesiaca;
            double przelicznikNormy = 1;
            if (niepelnyMiesiac) {
                double normaMiesiaca = pracownik.Czasy.Norma(okresMiesiaca).Czas.TotalHours;
                double normaWOkresieZatrudnienia = pracownik.Czasy.Norma(zatrudnienieWMiesiacu).Czas.TotalHours;
                if (normaWOkresieZatrudnienia > 0)
                    przelicznikNormy = normaMiesiaca / normaWOkresieZatrudnienia;
            }
            double zasadnicze = ZASADNICZE_NOMINALNE
                ? ZasadniczeNominalne(koniecMiesiaca[numerMiesiaca]).Value
                : zasadniczeNaliczoneWMiesiacu[numerMiesiaca] * przelicznikNormy;
            double zmienne = 0;
            foreach (WypElement skladnikZmienny in skladnikiZmienneWMiesiacu[numerMiesiaca]) {
                double wartoscSkladnika = (double)skladnikZmienny.Wartosc;
                if (niepelnyMiesiac) {
                    // dodatek z kwotą w kartotece - kwota nominalna; pozostałe - przeliczenie do pełnego miesiąca wg normy
                    WypElementDodatek elementDodatku = skladnikZmienny as WypElementDodatek;
                    if (elementDodatku != null && elementDodatku.DodHistoria != null && elementDodatku.DodHistoria.Podstawa.Value != 0)
                        wartoscSkladnika = (double)elementDodatku.DodHistoria.Podstawa.Value;
                    else
                        wartoscSkladnika = wartoscSkladnika * przelicznikNormy;
                }
                zmienne += wartoscSkladnika;
            }
            miesiecyPodstawy1++;
            sumaPodstawy1 += zasadnicze + zmienne;
            string uwagaNiepelnyMiesiac = niepelnyMiesiac ? $"   (niepełne zatrudnienie {zatrudnienieWMiesiacu}, wartości nominalne, przelicznik normy {przelicznikNormy:0.0000})" : "";
            log.WriteLine($"{opisMiesiaca}   zasadnicze {zasadnicze,10:0.00}   zmienne {zmienne,10:0.00}   razem {zasadnicze + zmienne,10:0.00}{uwagaNiepelnyMiesiac}");
        }
        // średnia z miesięcy z wypłatą (1-3), z dokładnością do grosza
        if (miesiecyPodstawy1 > 0)
            podstawa1 = System.Math.Round(sumaPodstawy1 / miesiecyPodstawy1, 2);
        else {
            // brak wypłat w 3 miesiącach (np. przed pierwszą listą płac) - zasadnicze nominalne z miesiąca rezerwy
            podstawa1 = System.Math.Round(ZasadniczeNominalne(koniecMiesiacaRezerwy).Value, 2);
            log.WriteLine("Brak wypłat w 3 miesiącach - przyjęto zasadnicze nominalne z miesiąca rezerwy.");
        }
        podstawa1ZaGodzine = podstawa1 / wspolczynnikWgWymiaru / normaDobowaGodzin;
        log.WriteLine($"Średnia z {miesiecyPodstawy1} mies.: {podstawa1:0.00} -> za dzień {podstawa1 / wspolczynnikWgWymiaru:0.00} -> za godz. {podstawa1ZaGodzine:0.0000}");
    }

    // ---------------- 4. PODSTAWA 2 - standard enova (ekwiwalent za urlop) ----------------
    // Pełny log standardu trafia do Zapisu obliczeń tylko po dopisaniu kategorii "Urlop" w definicji elementu.
    log.WriteLine("[4] PODSTAWA 2 (standard enova - ekwiwalent za urlop)");
    double podstawa2ZaDzien = 0, podstawa2ZaGodzine = 0;
    using (log.IncrementIndent()) {
        try {
            using (Element.Session.Logout(true)) {
                new NaliczanieEkwiwalent(Element, Składnik).NaliczPodstawy();
                // odczyt WEWNĄTRZ bloku Logout - po jego zamknięciu zmiany składnika są cofane
                podstawa2ZaDzien = Składnik.Podstawa1.Value;    // NaliczanieEkwiwalent: Podstawa1 = za 1 dzień
                podstawa2ZaGodzine = Składnik.Podstawa2.Value;  //                       Podstawa2 = za 1 godzinę
            }
        }
        catch (Exception blad) {
            log.WriteLine($"Błąd naliczania wg standardu: {blad.Message}");
        }
        if (!jestWyplataWMiesiacu[0])
            log.WriteLine($"Brak wypłaty za {rokRezerwy}/{koniecMiesiacaRezerwy.Month:00} - standard naliczył elementy miesiąca na nowo.");
    }
    double podstawa2 = System.Math.Round(podstawa2ZaDzien * wspolczynnikWgWymiaru, 2);
    using (log.IncrementIndent())
        log.WriteLine($"Podstawa {podstawa2:0.00} -> za dzień {podstawa2ZaDzien:0.00} -> za godz. {podstawa2ZaGodzine:0.0000}");

    // ---------------- 5. WYNIK ----------------
    double stawkaZaGodzine = podstawa1ZaGodzine;
    string opisWariantu = "podstawa 1";
    if (WARIANT_PODSTAWY == 2) {
        stawkaZaGodzine = podstawa2ZaGodzine;
        opisWariantu = "podstawa 2";
    }
    else if (WARIANT_PODSTAWY == 3) {
        stawkaZaGodzine = System.Math.Max(podstawa1ZaGodzine, podstawa2ZaGodzine);
        opisWariantu = "wyższa z podstaw";
    }

    int minutRezerwy = (int)System.Math.Round(godzinRezerwy * 60);
    Składnik.Podstawa1 = new DoubleCy(podstawa1);
    Składnik.Podstawa2 = new DoubleCy(podstawa2);
    Składnik.Podstawa3 = new DoubleCy(System.Math.Round(zaleglyGodzin / godzinNaDzienUrlopu, 2));
    Składnik.Podstawa4 = new DoubleCy(System.Math.Round(biezacyGodzin / godzinNaDzienUrlopu, 2));
    Składnik.Podstawa5 = new DoubleCy(System.Math.Round(wykorzystanyGodzin / godzinNaDzienUrlopu, 2));
    Składnik.Czas = new Time(minutRezerwy / 60, minutRezerwy % 60);
    Składnik.Ilosc = stawkaZaGodzine;

    log.WriteLine($"[5] WYNIK: wariant {WARIANT_PODSTAWY} ({opisWariantu}) -> {godzinRezerwy:0.00} h x {stawkaZaGodzine:0.0000} = {System.Math.Round(godzinRezerwy * stawkaZaGodzine, 2):0.00} zł");
}

public Currency %NAZWA%_Wylicz(Soneta.Place.WypElementDodatekAutomatyczny Element, WypSkladnik Składnik) {
    if (!PlanowaneWynagrodzenie)
        return Currency.Zero;
    // kwota = godziny rezerwy x stawka za 1 godzinę (wyliczona w _Param)
    return new Currency((decimal)System.Math.Round(Składnik.Czas.TotalHours * Składnik.Ilosc, 2));
}
