<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Generator schematu definicji elementu wynagrodzenia.
    Czyta biblioteki serwera enova365 (refleksja + zasoby *.pageform.xml) i scala wynik
    z ręcznie utrzymywanymi opisami (schema/opisy.json). Nie referuje bibliotek Soneta
    w czasie kompilacji; ładuje je w runtime z katalogu podanego parametrem server, dzięki czemu
    ten sam generator działa dla każdej wersji enova (wymaga runtime .NET zgodnego z serwerem).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GeneratorSchematu</AssemblyName>
    <RootNamespace>ImportDefinicjiElementow.Generator</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
