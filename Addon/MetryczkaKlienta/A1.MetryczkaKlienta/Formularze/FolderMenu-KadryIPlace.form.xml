<?xml version="1.0" encoding="utf-8"?>
<!-- Ekran modułu Kadry i płace (web). FolderMenuWindow ładuje najpierw "FolderMenu-<NormalizedPath>.form.xml",
     a dopiero gdy go nie ma - standardowy FolderMenu.form.xml (Soneta.Net.Business). Ten sam mechanizm ma
     standardowy FolderMenu-Ustawienia.form.xml. Poniżej kopia standardowego układu + sekcja aktualności nad
     sekcjami generowanymi z szablonów (klony szablonów wstawiane są w miejscu szablonu, czyli pod sekcją).
     Pierwszy element to Row z grupą MainGroup jak w standardzie - klient web (isFirstChildHasMainGroup)
     tylko wtedy rysuje sekcje modułu na pełną szerokość; elementy MainGroup są kafelkami. -->
<DataForm xmlns="http://www.enova.pl/schema/form.xsd"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xsd="http://www.w3.org/2001/XMLSchema"
          Mode="Folder" ViewType="Folder">

  <Stack Name="FolderMenuList" Class="MainPage">

    <Row>
      <Group Name="MetryczkaAktualnosci" Class="MainGroup" CaptionHtml="Aktualności"
             DataContext="{new MetryczkaAktualnosciExtender}">
        <Command Name="MetryczkaPokazUkryj" Class="MainCommand" CaptionHtml="{TekstPrzycisku}"
                 DescriptionHtml="Zwija lub rozwija aktualności nad sekcją Kadry" MethodName="PrzelaczWidocznosc" />
        <Command Name="MetryczkaOtworz" Class="MainCommand" CaptionHtml="Metryczka klienta"
                 DescriptionHtml="{Podsumowanie}" MethodName="OtworzMetryczke" />
      </Group>
    </Row>

    <!-- Aktualności metryczki jako kafelki: standardowy widget (Dashboard.Aktualnosci.form.xml) na ekranie modułu
         rysuje same filtry bez listy. Liczba kafelków stała = liczba kategorii metryczki (8); puste sloty ukryte. -->
    <Row DataContext="{new MetryczkaAktualnosciExtender}" Visibility="{Widoczna}">
      <Group Name="MetryczkaAktualnosciKafelki" Class="MainGroup" CaptionHtml="Metryczka klienta">
        <Command Name="MetryczkaKafelek0" Class="MainCommand" DataContext="{Kafelek0}" Visibility="{Jest}" CaptionHtml="{Tytul}" DescriptionHtml="{Opis}" MethodName="Otworz" />
        <Command Name="MetryczkaKafelek1" Class="MainCommand" DataContext="{Kafelek1}" Visibility="{Jest}" CaptionHtml="{Tytul}" DescriptionHtml="{Opis}" MethodName="Otworz" />
        <Command Name="MetryczkaKafelek2" Class="MainCommand" DataContext="{Kafelek2}" Visibility="{Jest}" CaptionHtml="{Tytul}" DescriptionHtml="{Opis}" MethodName="Otworz" />
        <Command Name="MetryczkaKafelek3" Class="MainCommand" DataContext="{Kafelek3}" Visibility="{Jest}" CaptionHtml="{Tytul}" DescriptionHtml="{Opis}" MethodName="Otworz" />
        <Command Name="MetryczkaKafelek4" Class="MainCommand" DataContext="{Kafelek4}" Visibility="{Jest}" CaptionHtml="{Tytul}" DescriptionHtml="{Opis}" MethodName="Otworz" />
        <Command Name="MetryczkaKafelek5" Class="MainCommand" DataContext="{Kafelek5}" Visibility="{Jest}" CaptionHtml="{Tytul}" DescriptionHtml="{Opis}" MethodName="Otworz" />
        <Command Name="MetryczkaKafelek6" Class="MainCommand" DataContext="{Kafelek6}" Visibility="{Jest}" CaptionHtml="{Tytul}" DescriptionHtml="{Opis}" MethodName="Otworz" />
        <Command Name="MetryczkaKafelek7" Class="MainCommand" DataContext="{Kafelek7}" Visibility="{Jest}" CaptionHtml="{Tytul}" DescriptionHtml="{Opis}" MethodName="Otworz" />
      </Group>
    </Row>

    <Template Name="ItemTemplate">
      <Command Name="MenuItem" Class="MainCommand"/>
    </Template>

    <Template Name="GroupTemplate">
      <Group Name="MenuGroup" Class="MainGroup" />
    </Template>

    <Template Name="RowTemplate">
      <Row />
    </Template>

  </Stack>

</DataForm>
