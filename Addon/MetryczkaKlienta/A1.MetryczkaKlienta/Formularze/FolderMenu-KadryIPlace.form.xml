             DataContext="{new MetryczkaAktualnosciExtender}">
        <Command Name="MetryczkaPokazUkryj" Class="MainCommand" CaptionHtml="{TekstPrzycisku}"
                 DescriptionHtml="Zwija lub rozwija aktualności nad sekcją Kadry" MethodName="PrzelaczWidocznosc" />
        <Command Name="MetryczkaOtworz" Class="MainCommand" CaptionHtml="Metryczka klienta"
                 DescriptionHtml="{Podsumowanie}" MethodName="OtworzMetryczke" />
      </Group>
    </Row>

    <!-- Aktualności metryczki: sekcja na kategorię, kafelek na każdą informację (tytuł = Dane, opis = Zakres danych).
         Opis kafelka zlewa nowe linie i ucina się do 2 linii, więc jedna informacja = jeden kafelek.
         Standardowy widget aktualności (Dashboard.Aktualnosci.form.xml) na ekranie modułu rysuje same filtry bez listy.
         Stałe sloty: 8 sekcji x 8 kafelków (MetryczkaAktualnosciExtender.LiczbaSekcji/LiczbaPozycji); puste ukryte. -->
