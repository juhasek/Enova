<?xml version="1.0" encoding="utf-8"?>
<DataForm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xsd="http://www.w3.org/2001/XMLSchema"
          xmlns="http://www.enova.pl/schema/form.xsd"
          xsi:schemaLocation="http://www.enova.pl/schema/ https://www.enova.pl/schema/form.xsd"
          Priority="10">
  <!-- Stałe wysokości list: dwie listy Height="*" na jednej stronie klient web rysuje tylko jako ostatnią.
       "Nieaktywne" zwijane własnym przyciskiem - Class="Collapsable" na tej stronie nie zwijał grupy domyślnie. -->
  <Page CaptionHtml="Metryczka klienta" DataContext="{DataSource}">
    <Label CaptionHtml="{Podsumowanie}" Width="*" />
    <Group Name="Aktywne" CaptionHtml="Cechy uzupełnione">
      <Grid Name="CechyAktywne" Width="*" Height="15" EditValue="{Aktywne}" OrderBy="Kategoria"
            NewButton="None" EditButton="None" RemoveButton="None">
        <Appearance Condition="{?Aktywna}" FontBold="true" />
        <Field CaptionHtml="Cecha" Width="30" EditValue="{Nazwa}" />
        <Field CaptionHtml="Wartość" Width="40" EditValue="{Wartosc}" />
        <Field CaptionHtml="Opis" Width="60" EditValue="{Opis}" />
        <GroupBy EditValue="{Kategoria}" IsDescending="false" />
      </Grid>
    </Group>
    <Row>
      <Command Name="PokazNieaktywne" CaptionHtml="{TekstNieaktywnych}" MethodName="PrzelaczNieaktywne" />
    </Row>
    <Group Name="Nieaktywne" CaptionHtml="Nieaktywne" Visibility="{NieaktywneWidoczne}">
      <Grid Name="CechyNieaktywne" Width="*" Height="15" EditValue="{Nieaktywne}" OrderBy="Kategoria"
            NewButton="None" EditButton="None" RemoveButton="None">
        <Field CaptionHtml="Cecha" Width="30" EditValue="{Nazwa}" />
        <Field CaptionHtml="Wartość" Width="40" EditValue="{Wartosc}" />
        <Field CaptionHtml="Opis" Width="60" EditValue="{Opis}" />
        <GroupBy EditValue="{Kategoria}" IsDescending="false" />
      </Grid>
    </Group>
  </Page>
</DataForm>
