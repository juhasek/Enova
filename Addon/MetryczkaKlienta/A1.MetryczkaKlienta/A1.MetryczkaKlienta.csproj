<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dodatek enova365 "Metryczka klienta": cechy globalne TST_ z metryczki (Excel) + sekcja w module Kadry i płace.
       Referencje wprost do DLL-i serwera 2610 (SonetaDir), jak w Addon/KalkulatorPodstawyZasilku:
       paczki Soneta.Sdk 2610 z nuget.org (~1 GB z zależnościami) nie mieszczą się na dysku tej maszyny.
       Private=false - nic z enova nie jest kopiowane do bin. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>A1.Metryczka</RootNamespace>
    <AssemblyName>A1.MetryczkaKlienta</AssemblyName>
    <SonetaDir Condition="'$(SonetaDir)' == ''">C:\enovaServer\2610\Soneta.Products.Server.Standard</SonetaDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(SonetaDir)\Soneta.*.dll" Exclude="$(SonetaDir)\Soneta.*.UI*.dll;$(SonetaDir)\Soneta.*Reports*.dll;$(SonetaDir)\Soneta.*Printer*.dll;$(SonetaDir)\Soneta.Net.*.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(SonetaDir)\Microsoft.Extensions.DependencyInjection.Abstractions.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Enova bierze 3 ostatnie człony nazwy zasobu: <NazwaKlasy>.<NazwaStrony>.pageform. -->
    <!-- FolderMenu-KadryIPlace.form.xml: układ ekranu modułu Kadry i płace (szukany po nazwie pliku). -->
    <EmbeddedResource Include="Formularze\*.xml">
      <LogicalName>A1.Metryczka.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
