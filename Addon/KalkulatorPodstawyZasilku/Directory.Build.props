<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Wersja bibliotek = wersja serwera enova (2610: Soneta.KadryPlace.dll ProductVersion
       2610.0.0-beta.241094, serwer na .NET 10 - server.runtimeconfig.json "tfm": "net10.0"). -->
  <PropertyGroup>
    <SonetaPackageVersion>2610.0.0-beta.241094</SonetaPackageVersion>
    <SonetaTargetFramework>net10.0</SonetaTargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <PropertyGroup>
    <Version>2610.0.0.1</Version>
  </PropertyGroup>
</Project>
